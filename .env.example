# Loopino local development example.
# Copy to .env for local experiments only. Never commit .env.

LOOPINO_ENV=development
LOOPINO_HOST=127.0.0.1
LOOPINO_PORT=8000

# Local-only bootstrap credentials and secret refs.
# Use generated values for any systemd/public install; the installer writes
# .env.loopino with restricted permissions by default.
LOOPINO_ADMIN_USERNAME=admin
LOOPINO_ADMIN_PASSWORD=replace-with-local-development-password
LOOPINO_SECRET_KEY_FILE=data/bootstrap-secrets/secret-store.key
LOOPINO_BOOTSTRAP_SECRET_STORE_ROOT=data/bootstrap-secrets
LOOPINO_RUNTIME_API_SECRET_REF=platform:secret-alias/runtime-api-secret
LOOPINO_WIDGET_CONTEXT_SECRET_REF=platform:secret-alias/widget-context-secret

# Control-plane persistence.
# json is the default and stores platform records outside .loopino.
LOOPINO_CONTROL_STORE=json
LOOPINO_JSON_CONTROL_STORE_ROOT=data/control-plane/json

# Optional MongoDB adapter.
# LOOPINO_CONTROL_STORE=mongo
# LOOPINO_MONGODB_URI=mongodb://127.0.0.1:27017/loopino
# LOOPINO_MONGODB_DATABASE=loopino
# LOOPINO_MONGODB_USERNAME=loopino
# LOOPINO_MONGODB_PASSWORD_REF=platform:secret-alias/mongodb-password

# Optional provider command for runtime sessions.
LOOPINO_CODEX_COMMAND=codex

# Optional override for the official public app catalog.
LOOPINO_APP_STORE_URL=https://loopino.giuntitrail.com/catalog
