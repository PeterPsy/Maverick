# Maverick v3 local development example.
# Copy to .env for local experiments only. Never commit .env.

MAVERICK_ENV=development
MAVERICK_HOST=127.0.0.1
MAVERICK_PORT=8000

# Local-only bootstrap credentials and signing secrets.
# Use generated values for any systemd/public install; the installer writes
# .maverick/install/maverick3.env with restricted permissions.
MAVERICK3_ADMIN_USERNAME=admin
MAVERICK3_ADMIN_PASSWORD=replace-with-local-development-password
MAVERICK3_RUNTIME_API_SECRET=replace-with-local-runtime-token-secret
MAVERICK3_WIDGET_CONTEXT_SECRET=replace-with-local-widget-context-secret

# Optional hosted persistence.
MAVERICK_MONGODB_URI=mongodb://127.0.0.1:27017/maverick_v3

# Optional provider command for runtime sessions.
MAVERICK3_CODEX_COMMAND=codex

# Optional override for the official public app catalog.
MAVERICK_APP_STORE_URL=https://maverick-app-store.versy.ai
