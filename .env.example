# Maverick v3 local development example.
# Copy to .env for local experiments only. Never commit .env.

MAVERICK_ENV=development
MAVERICK_HOST=127.0.0.1
MAVERICK_PORT=8000

# Use fake or local-only credentials until production secret storage is implemented.
MAVERICK_SECRET_KEY=replace-with-local-development-secret

# Optional hosted persistence.
MAVERICK_MONGODB_URI=mongodb://127.0.0.1:27017/maverick_v3

# Optional provider command for runtime sessions.
MAVERICK_CODEX_COMMAND=codex
