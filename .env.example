# Maverick local development example.
# Copy to .env for local experiments only. Never commit .env.

MAVERICK_ENV=development
MAVERICK_HOST=127.0.0.1
MAVERICK_PORT=8000

# Local-only bootstrap credentials and secret refs.
# Use generated values for any systemd/public install; the installer writes
# .env.maverick with restricted permissions by default.
MAVERICK_ADMIN_USERNAME=admin
MAVERICK_ADMIN_PASSWORD=replace-with-local-development-password
MAVERICK_SECRET_KEY_FILE=data/bootstrap-secrets/secret-store.key
MAVERICK_BOOTSTRAP_SECRET_STORE_ROOT=data/bootstrap-secrets
MAVERICK_RUNTIME_API_SECRET_REF=platform:secret-alias/runtime-api-secret
MAVERICK_WIDGET_CONTEXT_SECRET_REF=platform:secret-alias/widget-context-secret

# Control-plane persistence.
# json is the default and stores platform records outside .maverick.
MAVERICK_CONTROL_STORE=json
MAVERICK_JSON_CONTROL_STORE_ROOT=data/control-plane/json

# Optional MongoDB adapter.
# MAVERICK_CONTROL_STORE=mongo
# MAVERICK_MONGODB_URI=mongodb://127.0.0.1:27017/maverick
# MAVERICK_MONGODB_DATABASE=maverick
# MAVERICK_MONGODB_USERNAME=maverick
# MAVERICK_MONGODB_PASSWORD_REF=platform:secret-alias/mongodb-password

# Optional provider command for runtime sessions.
MAVERICK_CODEX_COMMAND=codex

# Optional override for the official public app catalog.
MAVERICK_APP_STORE_URL=https://maverick-app-store.versy.ai
