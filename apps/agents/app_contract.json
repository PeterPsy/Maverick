{
  "app_id": "agents",
  "contract_version": "1.0",
  "name": "Agents",
  "version": "0.1.0",
  "description": "Workspace app for managing agent roles, prompt composition, and agent type definitions.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "agent.catalog",
      "version": "1",
      "description": "Agent type and role prompt catalog.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    },
    {
      "interface": "agent.prompt-materializer",
      "version": "1",
      "description": "Agent prompt and skill metadata materialization.",
      "surfaces": [
        "backend",
        "cli",
        "mcp"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "maverick_agents_app",
      "agents_view_filter",
      "agents_set_view_filter",
      "agents_set_custom_view",
      "agents_clear_custom_view",
      "agents_reference_manifest",
      "agents_reference_search",
      "agents_reference_resolve",
      "agents_reference_summarize"
    ],
    "cli_commands": [
      "agents"
    ],
    "skills": [
      "agents-ops"
    ],
    "views": [
      "agents"
    ],
    "data_events": [
      {
        "resource": "configuration",
        "description": "Emitted when agent roles, agent types, or the common prompt change through official Agents app surfaces."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Agents catalog view filters or custom selections change through official Agents app surfaces."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "agents",
        "display_name": "Agents",
        "entity_types": [
          "agent_type",
          "role_prompt"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Agents catalog view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set the current Agents query and entity filter."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of agent and role references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Agents to normal catalog browsing mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "agent_type",
        "display_name": "Agent Type",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "role_prompt",
        "display_name": "Role Prompt",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "agents-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/agents-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "agents-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/agents-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/agents/common_prompt.md",
      "data/agents/roles",
      "data/agents/agent_types.json",
      "data/agents/view_state.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
