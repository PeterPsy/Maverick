{
  "commands": {
    "agents": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "operations.manifest": "read",
          "catalog.compact": "read",
          "catalog": "read",
          "get_agent_definition": "read",
          "view_filter": "read",
          "references.manifest": "read",
          "references.search": "read",
          "references.resolve": "read",
          "references.summarize": "read",
          "health.check": "read",
          "upsert_agent_definition": "mutating",
          "set_view_filter": "mutating",
          "set_custom_view": "mutating",
          "clear_custom_view": "mutating",
          "delete_agent_definition": "destructive"
        }
      },
      "description": "Manage self-contained workspace agent definitions.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "default": "operations.manifest",
            "enum": [
              "operations.manifest",
              "catalog.compact",
              "catalog",
              "get_agent_definition",
              "view_filter",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "health.check",
              "upsert_agent_definition",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "delete_agent_definition"
            ]
          },
          "id": {
            "type": "string"
          },
          "agent_type_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "agent_type"
            ]
          },
          "query": {
            "type": "string"
          },
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "refs": {
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "preserve_custom": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
