{
  "tools": {
    "maverick_agents_app": {
      "effect_class": "destructive",
      "description": "Generic Agents operation dispatcher.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "default": "operations.manifest",
            "enum": [
              "operations.manifest",
              "catalog.compact",
              "catalog",
              "get_agent_definition",
              "view_filter",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "health.check",
              "upsert_agent_definition",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "delete_agent_definition"
            ]
          },
          "id": {
            "type": "string"
          },
          "agent_type_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "agent_type"
            ]
          },
          "query": {
            "type": "string"
          },
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "refs": {
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "preserve_custom": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "operations.manifest": "read",
          "catalog.compact": "read",
          "catalog": "read",
          "get_agent_definition": "read",
          "upsert_agent_definition": "mutating",
          "delete_agent_definition": "destructive",
          "view_filter": "read",
          "set_view_filter": "mutating",
          "set_custom_view": "mutating",
          "clear_custom_view": "mutating",
          "references.manifest": "read",
          "references.search": "read",
          "references.resolve": "read",
          "references.summarize": "read",
          "health.check": "read"
        }
      }
    },
    "agents_catalog_compact": {
      "effect_class": "read",
      "description": "List agents without instruction content.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "agents_get_agent_definition": {
      "effect_class": "read",
      "description": "Read one self-contained agent definition.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_type_id": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "agent_type_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "agents_upsert_agent_definition": {
      "effect_class": "mutating",
      "description": "Create or update one self-contained agent definition.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_type_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "instructions"
        ],
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "agent_type_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "agents_delete_agent_definition": {
      "effect_class": "destructive",
      "description": "Delete one agent definition.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_type_id": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "agent_type_id"
            ]
          }
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
