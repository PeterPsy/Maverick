{
  "name": "@maverick/base-shell",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../../scripts/check-node-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "predev": "node ../../scripts/check-node-runtime.mjs",
    "dev": "vite --host 0.0.0.0",
    "pretest": "node ../../scripts/check-node-runtime.mjs",
    "test": "vitest run",
    "test:browser-permissions": "node --test tests/iframe-microphone-cross-origin.test.mjs",
    "test:sidebar-presentation": "node --test tests/sidebar-presentation.browser.test.mjs",
    "test:notifications": "node --test tests/notification-feed.browser.test.mjs tests/notification-feed-regressions.browser.test.mjs",
    "test:service-worker": "node --test tests/service-worker-v2.test.mjs tests/frontend-precache-build.test.mjs tests/file-cache-broker-cross-origin.test.mjs tests/vite-isolated-assets-cross-origin.test.mjs tests/pwa-metrics-browser.test.mjs"
  },
  "dependencies": {
    "@maverick/pwa-cache": "file:../../packages/pwa-cache",
    "@paper-design/shaders-react": "^0.0.76",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
