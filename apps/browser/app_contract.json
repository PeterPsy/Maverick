{
  "app_id": "browser",
  "contract_version": "1.0",
  "name": "Browser",
  "version": "0.3.0",
  "description": "Read-only Instagram navigation and media analysis through a user-shared Chrome tab, plus isolated Browser Lab research.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "browser.lab",
      "version": "1",
      "description": "Governed ephemeral web research plus Browser Lab sessions, rendered content, scrolling, video frames, snapshots, and diagnostic observations.",
      "surfaces": [
        "backend",
        "mcp",
        "cli"
      ]
    }
  ],
  "requires": [
    {
      "alias": "storage-file-content-write",
      "interface": "file.content.write",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Store requested frame and audio evidence through Storage."
    },
    {
      "alias": "speech-to-text",
      "interface": "speech.transcription",
      "version": "^1",
      "required": false,
      "cardinality": "one",
      "description": "Transcribe shared tab audio with a local-only engine."
    }
  ],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "web_search",
      "web_open",
      "browser_session_create",
      "browser_session_close",
      "browser_navigate",
      "browser_snapshot",
      "browser_take_screenshot",
      "browser_console_messages",
      "browser_network_requests",
      "browser_tabs",
      "browser_wait_for",
      "browser_read_content",
      "browser_scroll",
      "browser_video_frame",
      "browser_click",
      "browser_type",
      "browser_press_key",
      "browser_companion_status",
      "browser_operation_get",
      "browser_operation_cancel",
      "browser_instagram_collect",
      "browser_video_analyze"
    ],
    "cli_commands": [
      "browser"
    ],
    "skills": [
      "browser-ops"
    ],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "state",
        "description": "Emitted when Browser Lab session metadata or audit records change through official Browser surfaces."
      },
      {
        "resource": "companion",
        "description": "Chrome connection or observation operation changed."
      }
    ],
    "view_surfaces": [],
    "reference_entities": []
  },
  "widgets": [],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py",
      "backend_recovery": "hooks/backend_recovery.py",
      "background_tick": "hooks/backend_recovery.py"
    }
  },
  "storage": {
    "storage_kind": "hybrid",
    "data_schema_version": "1",
    "primary_paths": [
      "data/browser/state.json",
      "data/browser/companion.sqlite3"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "full-access"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30,
    "backend_seconds": 300
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": true
  }
}
