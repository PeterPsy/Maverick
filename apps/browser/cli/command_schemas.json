{
  "commands": {
    "browser": {
      "description": "Inspect Browser Lab status, operation manifest, audit records, run URL policy preflight, or execute the P0 acceptance smoke.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "operations.manifest",
              "status",
              "policy.preflight",
              "audit.list",
              "acceptance.smoke"
            ],
            "default": "operations.manifest"
          },
          "url": {
            "type": "string",
            "description": "Policy preflight URL or acceptance smoke target URL. Defaults to MAVERICK_BROWSER_ACCEPTANCE_URL or https://example.com/ for acceptance.smoke."
          },
          "mode": {
            "type": "string",
            "enum": ["read_only", "maverick_dev_inspector"],
            "default": "read_only"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
