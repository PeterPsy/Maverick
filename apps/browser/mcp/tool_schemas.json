{
  "tools": {
    "web_search": {
      "effect_class": "read",
      "description": "Search the public web and return a readable result-page snapshot with links.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    "web_open": {
      "effect_class": "read",
      "description": "Open a public web URL and return its readable page snapshot.",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "required": ["url"],
        "additionalProperties": false
      }
    },
    "browser_session_create": {
      "effect_class": "mutating",
      "description": "Create an isolated Browser Lab session through the Playwright broker.",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {"type": "string", "enum": ["read_only", "maverick_dev_inspector"], "default": "read_only"},
          "viewport_width": {"type": "integer", "minimum": 320, "maximum": 3840},
          "viewport_height": {"type": "integer", "minimum": 320, "maximum": 2160},
          "mobile": {
            "type": "boolean",
            "default": false,
            "description": "Use mobile browser context defaults when viewport dimensions are omitted."
          }
        },
        "additionalProperties": false
      }
    },
    "browser_session_close": {
      "effect_class": "destructive",
      "description": "Close one Browser Lab session.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_navigate": {
      "effect_class": "mutating",
      "description": "Navigate after core browser egress policy approval.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "url": {"type": "string"},
          "mode": {"type": "string", "enum": ["read_only", "maverick_dev_inspector"], "default": "read_only"}
        },
        "required": ["session_id", "url"],
        "additionalProperties": false
      }
    },
    "browser_snapshot": {
      "effect_class": "read",
      "description": "Return an accessibility snapshot with refs for one session.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_take_screenshot": {
      "effect_class": "read",
      "description": "Capture a screenshot without automatic persistence.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "full_page": {"type": "boolean", "default": false}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_console_messages": {
      "effect_class": "read",
      "description": "Read bounded console messages for one Browser Lab session.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_network_requests": {
      "effect_class": "read",
      "description": "Read redacted network request metadata for one Browser Lab session.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_tabs": {
      "effect_class": "read",
      "description": "List tabs in one Browser Lab session.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_wait_for": {
      "effect_class": "read",
      "description": "Wait for a bounded browser page state.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "state": {"type": "string", "enum": ["load", "domcontentloaded", "networkidle"], "default": "load"},
          "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 30000, "default": 5000}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_read_content": {
      "effect_class": "read",
      "description": "Read bounded rendered text, links, images, video metadata, and coverage from the current page. URLs are redacted; this does not download media or read unvisited content.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "max_chars": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 40000},
          "max_items": {"type": "integer", "minimum": 1, "maximum": 200, "default": 100}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_scroll": {
      "effect_class": "mutating",
      "description": "Scroll the current document in bounded steps to load more rendered content. Does not click or submit forms; reaching the viewport bottom does not prove a complete infinite feed.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "direction": {"type": "string", "enum": ["up", "down"], "default": "down"},
          "pixels": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 900},
          "steps": {"type": "integer", "minimum": 1, "maximum": 5, "default": 1},
          "settle_ms": {"type": "integer", "minimum": 0, "maximum": 1500, "default": 500}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_video_frame": {
      "effect_class": "mutating",
      "description": "Pause a rendered video, optionally seek to a bounded time, and return one inline JPEG frame with its observed timestamp. Does not transcribe audio or persist the image.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "video_index": {"type": "integer", "minimum": 0, "maximum": 199, "default": 0},
          "time_seconds": {"type": "number", "minimum": 0, "maximum": 86400}
        },
        "required": ["session_id"],
        "additionalProperties": false
      }
    },
    "browser_click": {
      "effect_class": "mutating",
      "description": "Click by snapshot ref only for maverick_dev_inspector targets.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "ref": {"type": "string"},
          "target_url": {"type": "string"},
          "mode": {"type": "string", "enum": ["maverick_dev_inspector"]}
        },
        "required": ["session_id", "ref", "target_url", "mode"],
        "additionalProperties": false
      }
    },
    "browser_type": {
      "effect_class": "mutating",
      "description": "Type into a snapshot ref only for maverick_dev_inspector targets.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "ref": {"type": "string"},
          "text": {"type": "string"},
          "target_url": {"type": "string"},
          "mode": {"type": "string", "enum": ["maverick_dev_inspector"]}
        },
        "required": ["session_id", "ref", "text", "target_url", "mode"],
        "additionalProperties": false
      }
    },
    "browser_press_key": {
      "effect_class": "mutating",
      "description": "Press a key only for maverick_dev_inspector targets.",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string"},
          "key": {"type": "string"},
          "target_url": {"type": "string"},
          "mode": {"type": "string", "enum": ["maverick_dev_inspector"]}
        },
        "required": ["session_id", "key", "target_url", "mode"],
        "additionalProperties": false
      }
    }
  }
}
