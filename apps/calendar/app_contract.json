{
  "app_id": "calendar",
  "contract_version": "1.0",
  "name": "Calendar",
  "version": "0.2.0",
  "description": "Workspace calendar for creating, filtering, editing, and rescheduling events.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "calendar.events",
      "version": "1",
      "description": "Workspace event scheduling and calendar views.",
      "surfaces": [
        "backend",
        "view",
        "reference",
        "mcp",
        "cli"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "calendar_operations_manifest",
      "calendar_list_events",
      "calendar_create_event",
      "calendar_update_event",
      "calendar_delete_event",
      "calendar_move_event",
      "calendar_check_availability",
      "calendar_find_free_time",
      "calendar_view_filter",
      "calendar_set_view_filter",
      "calendar_set_custom_view",
      "calendar_clear_custom_view",
      "calendar_reference_manifest",
      "calendar_reference_search",
      "calendar_reference_resolve",
      "calendar_reference_summarize"
    ],
    "cli_commands": [
      "calendar",
      "calendar-reference"
    ],
    "skills": [
      "calendar-ops"
    ],
    "views": [
      "calendar"
    ],
    "data_events": [
      {
        "resource": "events",
        "description": "Emitted when calendar events are created, updated, deleted, or rescheduled."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Calendar view filters or curated event selections change."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "calendar",
        "display_name": "Calendar",
        "entity_types": [
          "event"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Calendar view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set the current Calendar query and time-window filter."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of Calendar event references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Calendar to its default view state."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "event",
        "display_name": "Calendar Event",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "calendar-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/calendar-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "calendar-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/calendar-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "2",
    "primary_paths": [
      "data/calendar/state.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
