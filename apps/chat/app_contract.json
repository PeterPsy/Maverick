{
  "app_id": "chat",
  "contract_version": "1.0",
  "name": "Chat",
  "version": "0.2.0",
  "description": "Workspace chat app that talks to the selected Maverick runtime provider.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "communication.chat",
      "version": "1",
      "description": "Workspace chat UI, project catalog, and runtime-thread presentation.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": true,
      "cleanup_sessions": true
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "message.send",
      "turn.stop",
      "chat_view_filter",
      "chat_set_view_filter",
      "chat_set_custom_view",
      "chat_clear_custom_view",
      "chat_reference_manifest",
      "chat_reference_search",
      "chat_reference_resolve",
      "chat_reference_summarize"
    ],
    "cli_commands": [
      "chat"
    ],
    "skills": [
      "chat-ops"
    ],
    "views": [
      "chat"
    ],
    "data_events": [
      {
        "resource": "projects",
        "description": "Emitted when chat projects change through official Chat app surfaces."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Chat runtime-thread/project browse filters or curated selections change through official Chat app surfaces."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "chat",
        "display_name": "Chat",
        "entity_types": [
          "project"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Chat project browse state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set Chat project query filters."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of Chat project references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Chat to normal thread and project browsing mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "project",
        "display_name": "Chat Project",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "chat-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/chat-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "chat-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/chat-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "chat-floating",
      "host": "base-shell",
      "content_kinds": [
        "shell.overlay.bottomright"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/chat-floating",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "chat-runtime-text",
      "host": "fleet",
      "content_kinds": [
        "chat.runtime.text.preview"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/runtime-text",
        "spa_fallback": true
      },
      "actions": {
        "backend": false,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "2",
    "primary_paths": [
      "data/chat/state.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
