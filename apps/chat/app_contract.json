{
  "app_id": "chat",
  "contract_version": "1.0",
  "name": "Chat",
  "version": "0.2.0",
  "description": "Workspace chat app that talks to the selected Maverick runtime provider.",
  "publisher": "versy",
  "minimum_core_version": "0.1.0",
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "capabilities": {
    "mcp_tools": [
      "threads.list",
      "threads.create",
      "message.send",
      "turn.stop",
      "chat_reference_manifest",
      "chat_reference_search",
      "chat_reference_resolve",
      "chat_reference_summarize"
    ],
    "cli_commands": [
      "chat"
    ],
    "skills": [],
    "views": [
      "chat"
    ],
    "reference_entities": [
      {
        "entity_type": "thread",
        "display_name": "Chat Thread",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "project",
        "display_name": "Chat Project",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "2",
    "primary_paths": [
      "data/chat/threads.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox",
      "full-access"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": true,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "rebuild": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [
    {
      "widget_id": "chat-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/chat-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "chat-floating",
      "host": "base-shell",
      "content_kinds": [
        "shell.overlay.bottomright"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/chat-floating",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ]
}
