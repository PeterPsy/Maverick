{
  "commands": {
    "scheduled": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "list": "read",
          "read": "read",
          "create": "mutating",
          "update": "mutating",
          "delete": "destructive",
          "pause": "mutating",
          "resume": "mutating",
          "run": "mutating",
          "continue": "mutating",
          "retry": "mutating",
          "cancel": "mutating",
          "initialize": "mutating"
        }
      },
      "description": "Manage actor-owned Scheduled chats with acyclic skill-block graphs. Read before editing; update requires expected_revision. Successful blocks stop at checkpoints; continue requires run_id and explicit node_ids. Never confirm checkpoints or start work without the user asking. Recurrence repeats the whole graph.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read",
              "create",
              "update",
              "delete",
              "pause",
              "resume",
              "run",
              "continue",
              "retry",
              "cancel",
              "initialize"
            ],
            "default": "list"
          },
          "chat_id": {
            "type": "string",
            "maxLength": 80
          },
          "creation_id": {
            "type": "string",
            "maxLength": 80
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "run_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 64
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "instructions": {
            "type": "string",
            "maxLength": 8000
          },
          "workspace_profile_binding_id": {
            "type": "string",
            "maxLength": 160
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "project_id": {
            "type": "string",
            "maxLength": 160
          },
          "conversation_mode": {
            "type": "string",
            "enum": [
              "new",
              "reuse"
            ]
          },
          "notifications": {
            "type": "boolean"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "frequency": {
                "type": "string",
                "enum": [
                  "manual",
                  "once",
                  "daily",
                  "weekdays",
                  "weekly"
                ]
              },
              "timezone": {
                "type": "string"
              },
              "time": {
                "type": "string"
              },
              "weekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "frequency"
            ],
            "additionalProperties": false
          },
          "graph": {
            "type": "object",
            "description": "DAG: nodes {id,title,instructions,skill_ids?:string[],position?:{x,y}}; edges {id?,source,target}. All predecessors must reach confirmed checkpoints.",
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "instructions": {
                      "type": "string"
                    },
                    "skill_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 8
                    },
                    "position": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "instructions"
                  ],
                  "additionalProperties": false
                }
              },
              "edges": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "source",
                    "target"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "nodes",
              "edges"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "chat": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "operations.manifest": "read",
          "projects.list": "read",
          "references.manifest": "read",
          "references.search": "read",
          "references.resolve": "read",
          "references.summarize": "read",
          "view_filter": "read",
          "set_view_filter": "mutating",
          "set_custom_view": "mutating",
          "clear_custom_view": "mutating",
          "learning.read": "read",
          "learning.discard_all": "destructive"
        }
      },
      "description": "Inspect Chat references and view state; administrators can inspect or dismiss the learning backlog. Runtime messages and turns remain core operations.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "operations.manifest",
              "projects.list",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "learning.read",
              "learning.discard_all"
            ],
            "default": "operations.manifest",
            "description": "Chat app-owned operation to run."
          },
          "entity_type": {
            "type": "string",
            "enum": ["project", "thread", "scheduled_chat"],
            "description": "Reference entity type for reference operations."
          },
          "type": {
            "type": "string",
            "enum": ["project", "thread", "scheduled_chat"],
            "description": "Alias for entity_type."
          },
          "entity_id": {
            "type": "string",
            "description": "Chat project reference id for resolve or summarize."
          },
          "project_id": {
            "type": "string",
            "description": "Alias for entity_id when resolving project references."
          },
          "thread_id": {
            "type": "string",
            "description": "Alias for entity_id when resolving runtime-thread references."
          },
          "id": {
            "type": "string",
            "description": "Alias for entity_id when resolving project references."
          },
          "query": {
            "type": "string",
            "description": "Search query or persisted view filter query."
          },
          "q": {
            "type": "string",
            "description": "Alias for query in reference search."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "Maximum reference search rows to return."
          },
          "preserve_custom": {
            "type": "boolean",
            "default": false,
            "description": "Keep the current curated view while changing query filters."
          },
          "title": {
            "type": "string",
            "description": "Curated view title for set_custom_view."
          },
          "refs": {
            "type": "array",
            "description": "Curated Chat refs for set_custom_view.",
            "items": {
              "type": "object",
              "properties": {
                "entity_type": {"type": "string", "enum": ["project", "thread", "scheduled_chat"]},
                "entity_id": {"type": "string"}
              },
              "required": ["entity_type", "entity_id"],
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  }
}
