{
  "tools": {
    "chat_scheduled": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "list": "read",
          "read": "read",
          "create": "mutating",
          "update": "mutating",
          "delete": "destructive",
          "pause": "mutating",
          "resume": "mutating",
          "run": "mutating",
          "continue": "mutating",
          "retry": "mutating",
          "cancel": "mutating",
          "initialize": "mutating"
        }
      },
      "description": "Manage actor-owned Scheduled chats with acyclic skill-block graphs. Read before editing; update requires expected_revision. Successful blocks stop at checkpoints; continue requires run_id and explicit node_ids. Never confirm checkpoints or start work without the user asking. Recurrence repeats the whole graph.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "read",
              "create",
              "update",
              "delete",
              "pause",
              "resume",
              "run",
              "continue",
              "retry",
              "cancel",
              "initialize"
            ],
            "default": "list"
          },
          "chat_id": {
            "type": "string",
            "maxLength": 80
          },
          "creation_id": {
            "type": "string",
            "maxLength": 80
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "run_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 64
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "instructions": {
            "type": "string",
            "maxLength": 8000
          },
          "workspace_profile_binding_id": {
            "type": "string",
            "maxLength": 160
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "project_id": {
            "type": "string",
            "maxLength": 160
          },
          "conversation_mode": {
            "type": "string",
            "enum": [
              "new",
              "reuse"
            ]
          },
          "notifications": {
            "type": "boolean"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "frequency": {
                "type": "string",
                "enum": [
                  "manual",
                  "once",
                  "daily",
                  "weekdays",
                  "weekly"
                ]
              },
              "timezone": {
                "type": "string"
              },
              "time": {
                "type": "string"
              },
              "weekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "date": {
                "type": "string"
              }
            },
            "required": [
              "frequency"
            ],
            "additionalProperties": false
          },
          "graph": {
            "type": "object",
            "description": "DAG: nodes {id,title,instructions,skill_ids?:string[],position?:{x,y}}; edges {id?,source,target}. All predecessors must reach confirmed checkpoints.",
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "instructions": {
                      "type": "string"
                    },
                    "skill_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 8
                    },
                    "position": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "instructions"
                  ],
                  "additionalProperties": false
                }
              },
              "edges": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "source",
                    "target"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "nodes",
              "edges"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "chat_learning_memory": {
      "effect_class": "mutating",
      "effect_class_by_argument": {"argument_name": "command", "omitted_effect_class": "mutating", "value_effect_classes": {"inspect": "read", "commit": "mutating"}},
      "description": "Inspect or commit an accepted Memory learning candidate from its assigned work chat. Writes exactly the approved fact and evidence through the pinned Memory provider; no arbitrary content or destination is accepted.",
      "input_schema": {"type": "object", "properties": {"item_id": {"type": "string", "minLength": 1, "maxLength": 128}, "command": {"type": "string", "enum": ["inspect", "commit"]}}, "required": ["item_id", "command"], "additionalProperties": false},
      "output_schema": {"type": "object"},
      "supports_idempotency": true,
      "safe_to_retry": true
    },
    "chat_operations_manifest": {
      "effect_class": "read",
      "description": "Return the compact Chat operations manifest with supported CLI/MCP workflows, payload profiles, examples, and runtime ownership notes.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "app_id": {"type": "string"},
          "schema_version": {"type": "string"},
          "default_action": {"type": "string"},
          "recommended": {"type": "array"},
          "operations": {"type": "object"},
          "payload_profiles": {"type": "object"},
          "examples": {"type": "object"},
          "notes": {"type": "array"}
        }
      }
    },
    "chat_reference_manifest": {
      "effect_class": "read",
      "description": "Describe Chat project and runtime-thread reference entities exposed by the Chat app.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "app_id": {"type": "string"},
          "schema_version": {"type": "string"},
          "entity_types": {"type": "array"}
        }
      }
    },
    "chat_reference_search": {
      "effect_class": "read",
      "description": "Search Chat app-owned project references compactly. Core-owned runtime threads are searched through the Chat composer and never include transcript content.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_type": {"type": "string", "enum": ["project", "scheduled_chat"]},
          "type": {"type": "string", "enum": ["project", "scheduled_chat"], "description": "Alias for entity_type."},
          "query": {"type": "string"},
          "q": {"type": "string", "description": "Alias for query."},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}
        },
        "required": ["entity_type"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "results": {"type": "array"},
          "payload_profile": {"type": "string"}
        }
      }
    },
    "chat_reference_resolve": {
      "effect_class": "read",
      "description": "Resolve one Chat project or runtime-thread reference by explicit id.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_type": {"type": "string", "enum": ["project", "thread", "scheduled_chat"]},
          "type": {"type": "string", "enum": ["project", "thread", "scheduled_chat"], "description": "Alias for entity_type."},
          "entity_id": {"type": "string"},
          "project_id": {"type": "string", "description": "Alias for entity_id."},
          "thread_id": {"type": "string", "description": "Alias for entity_id for runtime-thread references."},
          "id": {"type": "string", "description": "Alias for entity_id."}
        },
        "required": ["entity_type"],
        "anyOf": [
          {"required": ["entity_id"]},
          {"required": ["project_id"]},
          {"required": ["thread_id"]},
          {"required": ["id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "exists": {"type": "boolean"},
          "app_id": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "deep_link": {"type": "string"}
        }
      }
    },
    "chat_reference_summarize": {
      "effect_class": "read",
      "description": "Return a token-efficient summary for one Chat project or runtime-thread reference.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_type": {"type": "string", "enum": ["project", "thread", "scheduled_chat"]},
          "type": {"type": "string", "enum": ["project", "thread", "scheduled_chat"], "description": "Alias for entity_type."},
          "entity_id": {"type": "string"},
          "project_id": {"type": "string", "description": "Alias for entity_id."},
          "thread_id": {"type": "string", "description": "Alias for entity_id for runtime-thread references."},
          "id": {"type": "string", "description": "Alias for entity_id."}
        },
        "required": ["entity_type"],
        "anyOf": [
          {"required": ["entity_id"]},
          {"required": ["project_id"]},
          {"required": ["thread_id"]},
          {"required": ["id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "exists": {"type": "boolean"},
          "app_id": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "title": {"type": "string"},
          "deep_link": {"type": "string"},
          "summary": {"type": "string"},
          "safe_fields": {"type": "object"},
          "source_updated_at": {"type": "string"}
        }
      }
    },
    "chat_view_filter": {
      "effect_class": "read",
      "description": "Read the persisted Chat project/thread browse filter.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "state": {"type": "object"}
        }
      }
    },
    "chat_set_view_filter": {
      "effect_class": "mutating",
      "description": "Set Chat project/thread browse query filters.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "entity_type": {"type": "string", "enum": ["all", "thread", "project"]},
          "preserve_custom": {"type": "boolean", "default": false}
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "state": {"type": "object"},
          "app_events": {"type": "array"}
        }
      }
    },
    "chat_set_custom_view": {
      "effect_class": "mutating",
      "description": "Persist a curated Chat project/thread reference set for the Chat view.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "query": {"type": "string"},
          "entity_type": {"type": "string", "enum": ["all", "thread", "project"]},
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_type": {"type": "string", "enum": ["project", "thread"]},
                "entity_id": {"type": "string"}
              },
              "required": ["entity_type", "entity_id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["refs"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "state": {"type": "object"},
          "app_events": {"type": "array"}
        }
      }
    },
    "chat_clear_custom_view": {
      "effect_class": "mutating",
      "description": "Clear the curated Chat view and return to normal project/thread browsing.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {"type": "integer"},
          "state": {"type": "object"},
          "app_events": {"type": "array"}
        }
      }
    }
  }
}
