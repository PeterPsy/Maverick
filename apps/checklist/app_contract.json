{
  "app_id": "checklist",
  "contract_version": "1.0",
  "name": "Checklist",
  "version": "0.1.0",
  "description": "Workspace-local app for creating and managing checklists.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "checklist.task",
      "version": "1",
      "description": "Workspace checklist and task state.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "checklist_tasklist",
      "checklist_reference_manifest",
      "checklist_reference_search",
      "checklist_reference_resolve",
      "checklist_reference_summarize",
      "checklist_list",
      "checklist_create",
      "checklist_read",
      "checklist_update",
      "checklist_delete",
      "checklist_add_task",
      "checklist_toggle_task",
      "checklist_view_filter",
      "checklist_set_view_filter",
      "checklist_set_custom_view",
      "checklist_clear_custom_view"
    ],
    "cli_commands": [
      "checklist",
      "checklist-reference",
      "checklist-view"
    ],
    "skills": [
      "checklist-ops"
    ],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "state",
        "description": "Checklist state changed."
      },
      {
        "resource": "view-state",
        "description": "Checklist board filter or curated checklist selection changed."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "main",
        "display_name": "Checklist Board",
        "entity_types": [
          "checklist"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Checklist board view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set the current Checklist board query filter."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of checklist references on the board."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Checklist to its default board mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "checklist",
        "display_name": "Checklist",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "design-checklist",
      "host": "chat",
      "content_kinds": [
        "checklist.design"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/design-checklist",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": true,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    },
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "3",
    "primary_paths": [
      "data/checklist/state.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
