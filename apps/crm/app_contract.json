{
  "app_id": "crm",
  "contract_version": "1.0",
  "name": "CRM",
  "version": "0.1.0",
  "description": "Forkable workspace CRM for accounts, contacts, deals, activities, and business relationships.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "capabilities": {
    "mcp_tools": [
      "crm_search",
      "crm_get",
      "crm_list_recent",
      "crm_list_deals",
      "crm_create_account",
      "crm_create_contact",
      "crm_create_deal",
      "crm_add_activity",
      "crm_link_entities",
      "crm_reference_manifest",
      "crm_reference_search",
      "crm_reference_resolve",
      "crm_reference_summarize",
      "crm_view_filter",
      "crm_set_view_filter",
      "crm_set_custom_view",
      "crm_clear_custom_view"
    ],
    "cli_commands": [
      "crm"
    ],
    "skills": [
      "crm-ops"
    ],
    "views": [
      "crm"
    ],
    "data_events": [
      {
        "resource": "records",
        "description": "Emitted when CRM accounts, contacts, deals, activities, relationships, or CRM view state change through official CRM surfaces."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "crm",
        "display_name": "CRM",
        "entity_types": [
          "account",
          "contact",
          "deal",
          "activity"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current CRM view state without scanning CRM records."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set keyword and entity-type filters for the CRM view."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of CRM entity references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return CRM to normal browse mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "account",
        "display_name": "Account",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "contact",
        "display_name": "Contact",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "deal",
        "display_name": "Deal",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "activity",
        "display_name": "Activity",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "sqlite",
    "data_schema_version": "1",
    "primary_paths": [
      "data/crm/crm.sqlite"
    ],
    "indices": {
      "kind": "embedded"
    },
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox",
      "full-access"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": true,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "rebuild": true,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": []
}
