{
  "app_id": "crm",
  "contract_version": "1.0",
  "name": "CRM",
  "version": "0.1.0",
  "description": "Workspace CRM for accounts, contacts, deals, activities, tasks, import/export, and agent-friendly CRM actions.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "crm.records",
      "version": "1",
      "description": "Workspace-scoped CRM records and references.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "workspace_local",
    "source_access": "editable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "crm_search",
      "crm_get_record",
      "crm_create_contact",
      "crm_update_contact",
      "crm_create_account",
      "crm_update_account",
      "crm_create_deal",
      "crm_update_deal",
      "crm_move_deal",
      "crm_log_activity",
      "crm_create_task",
      "crm_update_task",
      "crm_create_note",
      "crm_update_note",
      "crm_list_next_actions",
      "crm_summarize_account",
      "crm_import_preview",
      "crm_import_commit",
      "crm_health",
      "crm_reference_manifest",
      "crm_reference_search",
      "crm_reference_resolve",
      "crm_reference_summarize",
      "crm_view_filter",
      "crm_set_view_filter",
      "crm_set_custom_view",
      "crm_clear_custom_view"
    ],
    "cli_commands": [
      "crm"
    ],
    "skills": [
      "crm-ops"
    ],
    "views": [
      "crm"
    ],
    "data_events": [
      {
        "resource": "records",
        "description": "CRM records changed through backend, CLI, or MCP."
      },
      {
        "resource": "view-state",
        "description": "CRM filters or custom view state changed."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "crm",
        "display_name": "CRM",
        "entity_types": [
          "account",
          "contact",
          "deal",
          "activity",
          "task",
          "note"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read CRM view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set CRM search and entity filter state."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated CRM record set."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return CRM to normal search mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "account",
        "display_name": "Account",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "contact",
        "display_name": "Contact",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "deal",
        "display_name": "Deal",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "activity",
        "display_name": "Activity",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "task",
        "display_name": "Task",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      },
      {
        "entity_type": "note",
        "display_name": "Note",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "entrypoints": {
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "export": "hooks/export.py",
      "import": "hooks/import.py",
      "health_check": "hooks/health_check.py"
    },
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "sqlite",
    "data_schema_version": "1",
    "primary_paths": [
      "data/crm/crm.sqlite",
      "data/crm/view_state.json"
    ],
    "indices": {
      "kind": "embedded"
    },
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox",
      "full-access"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 30,
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": true,
    "migrate": true,
    "export": true,
    "import": true,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [
    {
      "widget_id": "crm-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/crm-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "crm-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/crm-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": false,
        "mcp": false,
        "cli": false
      }
    }
  ]
}
