[Unit]
Description=Renew the exact CRM public HTTPS certificate
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/certbot renew --quiet --cert-name crm-public --config-dir /projects/loopino/data/crm-public-tls/config --work-dir /projects/loopino/data/crm-public-tls/work --logs-dir /projects/loopino/data/crm-public-tls/logs --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
TimeoutStartSec=10min
MemoryMax=256M
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/projects/loopino/data/crm-public-tls /projects/loopino/data/external-apps-acme /var/log/nginx /run/nginx.pid
