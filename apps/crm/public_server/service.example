[Unit]
Description=Loopino CRM public surface
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=www-data
SupplementaryGroups=ubuntu
WorkingDirectory={{REPOSITORY}}
Environment=PATH=/usr/bin:/bin PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
Environment=LOOPINO_CONTROL_STORE=json
Environment=LOOPINO_JSON_CONTROL_STORE_ROOT={{REPOSITORY}}/data/control-plane/json
ExecStart=/usr/bin/python3 -B {{REPOSITORY}}/scripts/crm_public_supervisor.py --config /projects/loopino/installation/config/crm-public.json
RuntimeDirectory=loopino-crm-public-state loopino-crm-public-listener
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{REPOSITORY}}/workspaces/{{WORKSPACE}}/data/crm
ReadWritePaths={{REPOSITORY}}/data/control-plane/json/apps/.app_sources.json.lock
ReadWritePaths={{REPOSITORY}}/data/control-plane/json/apps/.workspace_app_bindings.json.lock
ReadWritePaths={{REPOSITORY}}/data/control-plane/json/workspaces/.workspaces.json.lock
MemoryMax=512M
TasksMax=32
KillMode=mixed
TimeoutStopSec=15
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
