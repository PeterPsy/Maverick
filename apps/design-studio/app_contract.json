{
  "app_id": "design-studio",
  "contract_version": "1.0",
  "name": "Design Studio",
  "version": "0.5.1",
  "description": "Host an unchanged official OpenDesign installation with optional naked-model and external-delegation bridges.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "design.studio",
      "version": "1",
      "description": "Native OpenDesign hosting and bounded external delegation.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "view",
        "reference"
      ]
    }
  ],
  "requires": [
    {
      "alias": "storage-catalog",
      "interface": "file.catalog",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Browse workspace Storage files as design sources."
    },
    {
      "alias": "storage-read",
      "interface": "file.content.read",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Read selected Storage files for controlled imports."
    },
    {
      "alias": "storage-write",
      "interface": "file.content.write",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Write exported design artifacts under storage/generated/design-studio."
    },
    {
      "alias": "storage-preview",
      "interface": "file.preview",
      "version": "^1",
      "required": false,
      "cardinality": "one",
      "description": "Render previews for imported and exported design assets."
    }
  ],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    },
    "providers": {
      "model_proxy": true,
      "credential_source": "core-vault",
      "deliver_secrets_to_app": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "design_studio_delegate",
      "design_studio_delegation_status",
      "design_studio_cancel_delegation",
      "design_studio_delegation_result",
      "design_studio_state",
      "design_studio_view_filter",
      "design_studio_set_view_filter",
      "design_studio_set_custom_view",
      "design_studio_clear_custom_view"
    ],
    "cli_commands": [
      "design-studio",
      "design-studio-update"
    ],
    "skills": [
      "design-studio-ops"
    ],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "delegation",
        "description": "A bounded external OpenDesign delegation changed state."
      },
      {
        "resource": "view-state",
        "description": "The display-only native OpenDesign project view selection changed."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "main",
        "display_name": "Design Studio",
        "entity_types": [
          "design_project"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the display-only native OpenDesign project filter."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Filter projects returned by the supported OpenDesign API."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of native OpenDesign project references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return to the unfiltered native OpenDesign project list."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "design_project",
        "display_name": "OpenDesign project",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "entrypoints": {
    "hooks": {
      "install": "hooks/install.py",
      "upgrade": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    },
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "json+files",
    "data_schema_version": "3",
    "primary_paths": [
      "data/design-studio/opendesign-native",
      "data/design-studio/delegations"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 60,
    "install_seconds": 300,
    "upgrade_seconds": 300,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 60
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": true,
    "data": true,
    "repair_only": false
  },
  "widgets": [],
  "services": {
    "http_sidecars": [
      {
        "id": "opendesign",
        "runtime": "python",
        "working_directory": "service",
        "command": [
          "python3",
          "opendesign_launcher.py"
        ],
        "env": {
          "OD_BIND_HOST": "127.0.0.1",
          "OD_PORT": "${service.port}",
          "OD_API_TOKEN": "${service.token}",
          "OD_SANDBOX_MODE": "1",
          "OD_REQUIRE_API_TOKEN_ON_LOOPBACK": "1",
          "DO_NOT_TRACK": "1",
          "NEXT_TELEMETRY_DISABLED": "1",
          "MAVERICK_OPENDESIGN_DATA_DIR": "${app.data_dir}/opendesign-native",
          "MAVERICK_OPENDESIGN_STORE_ROOT": "${artifact.opendesign}",
          "MAVERICK_OPENDESIGN_MODEL_BRIDGE": "auto",
          "MAVERICK_OPENDESIGN_DELEGATION_BRIDGE": "disabled"
        },
        "artifact_mounts": [
          {
            "id": "opendesign",
            "mount_path": "/artifacts/opendesign"
          }
        ],
        "prewarm": {
          "on_core_start": true,
          "on_install": true,
          "on_activation": true,
          "keep_alive": true
        },
        "diagnostics": {
          "status_file": "native-host-status.json"
        },
        "process_policy": {
          "inherit_host_env": false,
          "sandbox": "required",
          "bundle_read_only": true,
          "workspace_data_write": true,
          "network": "isolated",
          "transport": "unix_relay",
          "outbound": [],
          "limits": {
            "memory_bytes": 34359738368,
            "open_files": 1024,
            "request_concurrency": 32
          }
        },
        "browser_origin": {
          "mode": "isolated",
          "csp_profile": "self_hosted_web_app",
          "frame_ancestors": [
            "platform"
          ],
          "connect_src": [
            "self"
          ],
          "immutable_asset_prefixes": [
            "/_next/static/"
          ]
        },
        "entrypoint_access": {
          "ttl_seconds": 30,
          "request_budget": 64,
          "max_request_body_bytes": 14680064,
          "max_response_body_bytes": 67108864,
          "streaming": false,
          "surfaces": [
            {
              "surface": "backend",
              "routes": [
                {
                  "method": "GET",
                  "path_template": "/api/projects"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}/conversations"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects/{id}/conversations"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}/conversations/{cid}/messages"
                },
                {
                  "method": "PUT",
                  "path_template": "/api/projects/{id}/conversations/{cid}/messages/{mid}"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects/{id}/files"
                },
                {
                  "method": "POST",
                  "path_template": "/api/runs"
                },
                {
                  "method": "GET",
                  "path_template": "/api/runs/{id}"
                },
                {
                  "method": "GET",
                  "path_template": "/api/runs/{id}/result-package"
                },
                {
                  "method": "POST",
                  "path_template": "/api/runs/{id}/cancel"
                }
              ]
            },
            {
              "surface": "cli",
              "routes": [
                {
                  "method": "GET",
                  "path_template": "/api/projects"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}/conversations"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects/{id}/conversations"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}/conversations/{cid}/messages"
                },
                {
                  "method": "PUT",
                  "path_template": "/api/projects/{id}/conversations/{cid}/messages/{mid}"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects/{id}/files"
                },
                {
                  "method": "POST",
                  "path_template": "/api/runs"
                },
                {
                  "method": "GET",
                  "path_template": "/api/runs/{id}"
                },
                {
                  "method": "GET",
                  "path_template": "/api/runs/{id}/result-package"
                },
                {
                  "method": "POST",
                  "path_template": "/api/runs/{id}/cancel"
                }
              ]
            },
            {
              "surface": "mcp",
              "routes": [
                {
                  "method": "GET",
                  "path_template": "/api/projects"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}/conversations"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects/{id}/conversations"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}/conversations/{cid}/messages"
                },
                {
                  "method": "PUT",
                  "path_template": "/api/projects/{id}/conversations/{cid}/messages/{mid}"
                },
                {
                  "method": "POST",
                  "path_template": "/api/projects/{id}/files"
                },
                {
                  "method": "POST",
                  "path_template": "/api/runs"
                },
                {
                  "method": "GET",
                  "path_template": "/api/runs/{id}"
                },
                {
                  "method": "GET",
                  "path_template": "/api/runs/{id}/result-package"
                },
                {
                  "method": "POST",
                  "path_template": "/api/runs/{id}/cancel"
                }
              ]
            },
            {
              "surface": "reference",
              "routes": [
                {
                  "method": "GET",
                  "path_template": "/api/projects"
                },
                {
                  "method": "GET",
                  "path_template": "/api/projects/{id}"
                }
              ]
            }
          ]
        },
        "bind": {
          "host": "127.0.0.1",
          "port": "auto"
        },
        "health": {
          "path": "/api/ready",
          "timeout_ms": 20000
        },
        "proxy": {
          "mount": "/opendesign",
          "streaming": true,
          "sse": true,
          "websocket": false,
          "route_policy": {
            "pass_through": [
              {
                "method": "GET",
                "path_template": "/"
              },
              {
                "method": "GET",
                "path_template": "/{*native_path}"
              },
              {
                "method": "POST",
                "path_template": "/api/{*native_path}"
              },
              {
                "method": "PUT",
                "path_template": "/api/{*native_path}"
              },
              {
                "method": "PATCH",
                "path_template": "/api/{*native_path}"
              },
              {
                "method": "DELETE",
                "path_template": "/api/{*native_path}"
              },
              {
                "method": "OPTIONS",
                "path_template": "/api/{*native_path}"
              },
              {
                "method": "GET",
                "path_template": "/api/projects"
              },
              {
                "method": "POST",
                "path_template": "/api/projects"
              },
              {
                "method": "GET",
                "path_template": "/api/projects/{id}"
              },
              {
                "method": "GET",
                "path_template": "/api/projects/{id}/conversations"
              },
              {
                "method": "POST",
                "path_template": "/api/projects/{id}/conversations"
              },
              {
                "method": "GET",
                "path_template": "/api/projects/{id}/conversations/{cid}/messages"
              },
              {
                "method": "PUT",
                "path_template": "/api/projects/{id}/conversations/{cid}/messages/{mid}"
              },
              {
                "method": "POST",
                "path_template": "/api/projects/{id}/files"
              },
              {
                "method": "POST",
                "path_template": "/api/runs"
              },
              {
                "method": "GET",
                "path_template": "/api/runs/{id}"
              },
              {
                "method": "GET",
                "path_template": "/api/runs/{id}/result-package"
              },
              {
                "method": "POST",
                "path_template": "/api/runs/{id}/cancel"
              }
            ],
            "handled_by_core": [],
            "blocked": []
          }
        },
        "logs": {
          "stdout": "logs/apps/design-studio/sidecar.log",
          "stderr": "logs/apps/design-studio/sidecar.log"
        },
        "model_access": {
          "api": true,
          "cli": [
            "codex"
          ],
          "required": false
        }
      }
    ]
  }
}
