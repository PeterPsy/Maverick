{
  "commands": {
    "design-studio": {
      "description": "Inspect native Design Studio or delegate one explicit brief through public OpenDesign APIs.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "state",
              "delegate",
              "delegation_status",
              "cancel_delegation",
              "delegation_result",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize"
            ]
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "The complete explicit brief that will be visible in OpenDesign."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "A retry-stable caller key; reuse it only for the same explicit delegation."
          },
          "project_id": {
            "type": "string",
            "maxLength": 128
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          },
          "project_name": {
            "type": "string",
            "maxLength": 200
          },
          "new_conversation": {
            "type": "boolean"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 200
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "reasoning": {
            "type": "string",
            "maxLength": 64
          },
          "attachments": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 100
                },
                "content_base64": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 13981016
                },
                "authorized": {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              },
              "required": [
                "name",
                "content_base64",
                "authorized"
              ],
              "additionalProperties": false
            }
          },
          "delegation_id": {
            "type": "string",
            "pattern": "^dlg_[a-f0-9]{32}$"
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "project_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "preserve_custom": {
            "type": "boolean"
          },
          "entity_id": {
            "type": "string",
            "maxLength": 128
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "design_project"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "required_secrets": [],
      "secret_selectors": []
    }
  }
}
