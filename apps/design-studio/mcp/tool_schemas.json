{
  "tools": {
    "design_studio_delegate": {
      "description": "Append one explicit visible brief to a native OpenDesign conversation and start one naked OpenDesign agent run.",
      "input_schema": {
        "type": "object",
        "properties": {
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "The complete explicit brief that will be visible in OpenDesign."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "A retry-stable caller key; reuse it only for the same explicit delegation."
          },
          "project_id": {
            "type": "string",
            "maxLength": 128
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 128
          },
          "project_name": {
            "type": "string",
            "maxLength": 200
          },
          "new_conversation": {
            "type": "boolean"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 200
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "reasoning": {
            "type": "string",
            "maxLength": 64
          },
          "attachments": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "media_type": {
                  "type": "string",
                  "maxLength": 100
                },
                "content_base64": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 13981016
                },
                "authorized": {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              },
              "required": [
                "name",
                "content_base64",
                "authorized"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "brief",
          "idempotency_key"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_delegation_status": {
      "description": "Read bounded native OpenDesign run progress for one delegation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "delegation_id": {
            "type": "string",
            "pattern": "^dlg_[a-f0-9]{32}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "delegation_id"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_cancel_delegation": {
      "description": "Cancel the native OpenDesign run for one delegation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "delegation_id": {
            "type": "string",
            "pattern": "^dlg_[a-f0-9]{32}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "delegation_id"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_delegation_result": {
      "description": "Return display-safe result references and the exact native conversation link.",
      "input_schema": {
        "type": "object",
        "properties": {
          "delegation_id": {
            "type": "string",
            "pattern": "^dlg_[a-f0-9]{32}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "delegation_id"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_state": {
      "description": "Return thin-host status, delegation availability, and bounded display state.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_view_filter": {
      "description": "Read the display-only native OpenDesign project filter.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_set_view_filter": {
      "description": "Set the display-only native OpenDesign project search filter.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "preserve_custom": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_set_custom_view": {
      "description": "Show a curated set of native OpenDesign project references.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 128
          },
          "project_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "query": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_clear_custom_view": {
      "description": "Clear the display-only OpenDesign project filter.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    }
  }
}
