{
  "tools": {
    "design_studio_state": {
      "description": "Return Design Studio state, sidecar proxy URLs, and OpenDesign integration metadata.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_create_project": {
      "description": "Create a canonical OpenDesign project through the governed sidecar capability.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "prompt": {"type": "string"}
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_get_project": {
      "description": "Return one canonical OpenDesign project by id or migrated legacy alias.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          }
        },
        "required": [
          "project_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_import_from_storage": {
      "description": "Import one bounded Storage file into a canonical OpenDesign project.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "workspace_relative_path": {
            "type": "string",
            "pattern": "^storage/(uploaded|generated)/.+$"
          }
        },
        "required": [
          "project_id",
          "workspace_relative_path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_export_to_storage": {
      "description": "Export a terminal OpenDesign run package and project files under storage/generated/design-studio/<project-id>/<run-id>/.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "run_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_view_filter": {
      "description": "Read the current Design Studio view filter.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_set_view_filter": {
      "description": "Set the current Design Studio search filter.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_set_custom_view": {
      "description": "Show a curated Design Studio project selection.",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_clear_custom_view": {
      "description": "Clear Design Studio filters and curated selection.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_reference_manifest": {
      "description": "Describe OpenDesign project references exposed by Design Studio.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_reference_search": {
      "description": "Search OpenDesign projects through the governed sidecar capability.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_reference_resolve": {
      "description": "Resolve one OpenDesign project reference through the governed sidecar capability.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "enum": ["design_project"]
          }
        },
        "required": ["entity_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    },
    "design_studio_reference_summarize": {
      "description": "Summarize one OpenDesign project reference through the governed sidecar capability.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "enum": ["design_project"]
          }
        },
        "required": ["entity_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "required_secrets": [],
      "secret_selectors": []
    }
  }
}
