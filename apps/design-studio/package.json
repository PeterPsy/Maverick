{
  "name": "@maverick/design-studio",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node ../../scripts/check-node-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "predev": "node ../../scripts/check-node-runtime.mjs",
    "dev": "vite --host 0.0.0.0",
    "pretest": "node ../../scripts/check-node-runtime.mjs",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:release --",
    "test:e2e:quick": "node tests/opendesign_product.e2e.mjs --profile quick",
    "test:e2e:affected": "node tests/opendesign_product.e2e.mjs --profile affected",
    "test:e2e:release": "node tests/opendesign_product.e2e.mjs --profile release",
    "test:e2e:migration": "python3 service/smoke_opendesign_migration.py",
    "test:e2e:hosted": "node tests/opendesign_hosted_smoke.e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "20.11.6",
    "playwright": "1.60.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
