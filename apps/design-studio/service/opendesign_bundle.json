{
  "schema_version": "1",
  "upstream": {
    "repository": "https://github.com/nexu-io/open-design.git",
    "tag": "open-design-v0.10.1",
    "commit": "eb245799adf07e7727ad5f970485d809bad5780e",
    "version": "0.10.1"
  },
  "bundle": {
    "default_relative_path": "vendor/open-design",
    "node": "~24",
    "package_manager": "pnpm@10.33.2",
    "daemon_package": "@open-design/daemon",
    "built_entrypoint": "apps/daemon/dist/cli.js",
    "source_start_command": [
      "pnpm",
      "--filter",
      "@open-design/daemon",
      "run",
      "daemon"
    ],
    "web_static_dir": "apps/web/out"
  },
  "include_paths": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "apps/daemon",
    "apps/web",
    "packages/agui-adapter",
    "packages/components",
    "packages/contracts",
    "packages/diagnostics",
    "packages/host",
    "packages/platform",
    "packages/plugin-runtime",
    "packages/registry-protocol",
    "packages/sidecar",
    "packages/sidecar-proto",
    "assets",
    "craft",
    "design-systems",
    "design-templates",
    "plugins/registry",
    "prompt-templates",
    "skills"
  ],
  "exclude_paths": [
    "apps/desktop",
    "apps/landing-page",
    "apps/packaged",
    "apps/telemetry-worker",
    "charts",
    "deploy",
    "e2e",
    "node_modules",
    "plugins/marketplaces",
    "tools"
  ],
  "sandbox": {
    "env": {
      "OD_SANDBOX_MODE": "1",
      "OD_BIND_HOST": "127.0.0.1",
      "OD_DATA_DIR": "${app.data_dir}/opendesign",
      "OD_MEDIA_CONFIG_DIR": "${app.data_dir}/opendesign/media-config"
    }
  }
}
