  },
  "commands": {
    "install": [
      "corepack",
      "pnpm",
      "install",
      "--frozen-lockfile"
    ],
    "web": [
      "corepack",
      "pnpm",
      "--filter",
      "@open-design/web",
      "exec",
      "vitest",
      "run",
      "-c",
      "vitest.config.ts",
      "--maxWorkers=1",
      "--pool=threads"
    ],
    "daemon": [
      "corepack",
      "pnpm",
      "--filter",
      "@open-design/daemon",
      "exec",
      "vitest",
      "run",
      "-c",
      "vitest.config.ts",
      "--maxWorkers=1",
      "--pool=threads"
    ]
  },
