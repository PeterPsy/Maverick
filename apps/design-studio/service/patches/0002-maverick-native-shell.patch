diff --git a/apps/web/src/index.css b/apps/web/src/index.css
index 685f2defe..26cac46cb 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -30,3 +30,94 @@
 @import './styles/viewer/routines.css';
 @import './styles/modal-window-drag.css';
 @import './styles/entrance.css';
+
+/* Maverick host integration: the isolated sidecar inherits the shell palette,
+ * keeps the design surface full width, and delegates projects/chat to Maverick. */
+:root {
+  --mav-bg: #070708;
+  --mav-panel: rgba(12, 12, 14, 0.96);
+  --mav-subtle: #111114;
+  --mav-muted: #19191d;
+  --mav-border: rgba(255, 255, 255, 0.1);
+  --mav-text: #ececec;
+  --mav-soft: rgba(236, 236, 236, 0.62);
+  --mav-accent: #fff;
+  color-scheme: dark;
+}
+
+:root[data-maverick-theme='light'] {
+  --mav-bg: #f5f5f6;
+  --mav-panel: rgba(255, 255, 255, 0.96);
+  --mav-subtle: #eeeeef;
+  --mav-muted: #e5e5e7;
+  --mav-border: rgba(7, 7, 8, 0.11);
+  --mav-text: #171719;
+  --mav-soft: rgba(23, 23, 25, 0.62);
+  --mav-accent: #111113;
+  color-scheme: light;
+}
+
+:root,
+:root[data-theme='dark'],
+:root[data-theme='light'] {
+  --bg: var(--mav-bg) !important;
+  --bg-app: var(--mav-bg) !important;
+  --bg-panel: var(--mav-panel) !important;
+  --bg-subtle: var(--mav-subtle) !important;
+  --bg-muted: var(--mav-muted) !important;
+  --bg-elevated: var(--mav-panel) !important;
+  --border: var(--mav-border) !important;
+  --border-subtle: var(--mav-border) !important;
+  --text: var(--mav-text) !important;
+  --text-primary: var(--mav-text) !important;
+  --text-secondary: var(--mav-soft) !important;
+  --text-muted: var(--mav-soft) !important;
+  --accent: var(--mav-accent) !important;
+  --accent-hover: var(--mav-text) !important;
+}
+
+html,
+body,
+#__next {
+  background: var(--mav-bg) !important;
+  color: var(--mav-text) !important;
+}
+
+.split {
+  grid-template-columns: minmax(0, 1fr) !important;
+}
+
+.split-chat-slot,
+.split-resize-handle,
+.split-edit-divider,
+[data-testid='side-chat-tab'],
+.home-view > .home-hero,
+.home-view > .recent-projects {
+  display: none !important;
+}
+
+.split-file-slot,
+.file-workspace {
+  grid-column: 1 / -1 !important;
+  width: 100% !important;
+  max-width: none !important;
+}
+
+.home-view {
+  display: grid !important;
+  place-items: center !important;
+  min-height: 100% !important;
+}
+
+.home-view::before {
+  content: 'Select or create a project from the Maverick sidebar';
+  display: block;
+  max-width: 28rem;
+  padding: 1.2rem 1.4rem;
+  border: 1px solid var(--mav-border);
+  border-radius: 1rem;
+  background: var(--mav-panel);
+  color: var(--mav-soft);
+  font: 600 14px/1.5 Inter, system-ui, sans-serif;
+  text-align: center;
+}
