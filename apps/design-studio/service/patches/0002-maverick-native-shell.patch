+const MAVERICK_EMPTY_TABS: OpenTabsState = { tabs: [], active: DESIGN_FILES_TAB };
+
+/** Maverick owns project navigation and chat; Open Design owns the real canvas. */
+function MaverickProjectView({
+  project,
+  routeFileName,
+}: {
+  project: Project;
+  routeFileName: string | null;
+}) {
+  const projectDetail = useProjectDetail(project.id);
+  const currentProject = projectDetail.project ?? project;
+  const [files, setFiles] = useState<ProjectFile[]>([]);
+  const [liveArtifacts, setLiveArtifacts] = useState<LiveArtifactSummary[]>([]);
+  const [tabsState, setTabsState] = useState<OpenTabsState>(MAVERICK_EMPTY_TABS);
+  const [loading, setLoading] = useState(true);
+
+  const refreshWorkspace = useCallback(async () => {
+    const [nextFiles, nextLiveArtifacts] = await Promise.all([
+      fetchProjectFiles(project.id),
+      fetchLiveArtifacts(project.id),
+    ]);
+    setFiles(nextFiles);
+    setLiveArtifacts(nextLiveArtifacts);
+  }, [project.id]);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    Promise.all([refreshWorkspace(), loadTabs(project.id)])
+      .then(([, nextTabs]) => {
+        if (!cancelled) setTabsState(withoutNativeChatTabs(nextTabs));
+      })
+      .finally(() => {
+        if (!cancelled) setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [project.id, refreshWorkspace]);
+
+  const handleTabsStateChange = useCallback((next: OpenTabsState) => {
+    const sanitized = withoutNativeChatTabs(next);
+    setTabsState(sanitized);
+    void saveTabs(project.id, sanitized);
+  }, [project.id]);
+
+  const openRequest = useMemo(
+    () => routeFileName ? { name: routeFileName, nonce: 1 } : null,
+    [routeFileName],
+  );
+  const baseDir = currentProject.metadata?.baseDir;
+  const rootDirName = typeof baseDir === 'string'
+    ? baseDir.split(/[/\\]/).filter(Boolean).pop()
+    : undefined;
+
+  if (loading) return <CenteredLoader />;
+  return (
+    <div className="app maverick-project-view" data-testid="maverick-project-view">
+      <FileWorkspace
+        projectId={project.id}
+        projectKind={projectKindFromMetadataToTracking(currentProject.metadata) ?? 'prototype'}
+        rootDirName={rootDirName}
+        resolvedDir={projectDetail.resolvedDir}
+        files={files}
+        liveArtifacts={liveArtifacts}
+        onRefreshFiles={refreshWorkspace}
+        isDeck={currentProject.metadata?.kind === 'deck'}
+        openRequest={openRequest}
+        tabsState={tabsState}
+        onTabsStateChange={handleTabsStateChange}
+        preferredPreviewFile={currentProject.metadata?.entryFile ?? null}
+        autoPreviewDesignArtifacts={currentProject.metadata?.importedFrom === 'folder'}
+      />
+    </div>
+  );
+}
+
+function withoutNativeChatTabs(state: OpenTabsState): OpenTabsState {
+  const tabs = state.tabs.filter((tabId) => !tabId.startsWith('chat:'));
+  const active = state.active && !state.active.startsWith('chat:')
+    ? state.active
+    : DESIGN_FILES_TAB;
+  return { ...state, tabs, active };
+}
 
