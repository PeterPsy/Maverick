{
  "app_id": "dynamic-views",
  "contract_version": "1.0",
  "name": "Dynamic Views",
  "version": "0.1.0",
  "description": "Persisted custom visual views rendered in chat and reopened from a workspace library.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "view.dynamic",
      "version": "1",
      "description": "Persisted dynamic visual views.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "maverick_dynamic_views",
      "dynamic_views_view_filter",
      "dynamic_views_set_view_filter",
      "dynamic_views_set_custom_view",
      "dynamic_views_clear_custom_view",
      "dynamic_views_reference_manifest",
      "dynamic_views_reference_search",
      "dynamic_views_reference_resolve",
      "dynamic_views_reference_summarize"
    ],
    "cli_commands": [
      "dynamic-views"
    ],
    "skills": [
      "dynamic-views"
    ],
    "views": [
      "dynamic-views"
    ],
    "data_events": [
      {
        "resource": "views",
        "description": "Emitted when persisted dynamic view instances change through official Dynamic Views surfaces."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Dynamic Views library filters or curated selections change through official Dynamic Views surfaces."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "dynamic-views",
        "display_name": "Dynamic Views",
        "entity_types": [
          "view"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Dynamic Views library view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set Dynamic Views library query and status filters."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of dynamic view references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Dynamic Views to normal library browsing mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "view",
        "display_name": "Dynamic View",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "dynamic-views-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/dynamic-views-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "dynamic-view",
      "host": "chat",
      "content_kinds": [
        "dynamic.view.instance"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/dynamic-view",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": true
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/dynamic-views/state.json",
      "data/dynamic-views/assets/"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
