{
  "app_id": "external-apps",
  "contract_version": "1.0",
  "name": "External Apps",
  "version": "0.1.0",
  "description": "Publish immutable static Website Studio releases on an isolated public origin.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "external.surfaces.settings",
      "version": "1",
      "description": "App-scoped public surface management for the shell settings panel.",
      "surfaces": [
        "widget"
      ]
    }
  ],
  "requires": [
    {
      "alias": "static-exporter",
      "interface": "external.static-bundle.export",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Selected static build exporter; Website Studio is the V1 provider."
    }
  ],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "supporting"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "external_apps",
      "external_apps_reference_manifest"
    ],
    "cli_commands": [
      "external-apps"
    ],
    "skills": [],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "state",
        "description": "Publication catalog or plan changed."
      }
    ],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": null,
    "hooks": {
      "install": "hooks/lifecycle.py",
      "upgrade": "hooks/lifecycle.py",
      "migrate": "hooks/lifecycle.py",
      "backend_recovery": "hooks/lifecycle.py",
      "health_check": "hooks/health.py"
    }
  },
  "storage": {
    "storage_kind": "sqlite",
    "data_schema_version": "1",
    "primary_paths": [
      "data/external-apps/app.sqlite",
      "data/external-apps/public",
      "data/external-apps/deployment.json"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [
    {
      "widget_id": "external-surfaces-settings",
      "host": "base-shell",
      "content_kinds": [
        "shell.app.external.surfaces"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/external-surfaces-settings",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ]
}
