[Unit]
Description=Loopino External Apps exact-host TLS
After=network-online.target nginx.service loopino-external-apps.service

[Service]
Type=oneshot
ExecStart=/projects/loopino/.venv/bin/python -B /projects/loopino/installation/libexec/external-apps/tls.py
StandardOutput=append:/projects/loopino/installation/logs/systemd/external-apps-tls.log
StandardError=append:/projects/loopino/installation/logs/systemd/external-apps-tls-error.log
User=root
Group=root
UMask=0077
TimeoutStartSec=15min
MemoryMax=256M
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# nginx -t checks that its existing PID file can be opened, without changing it.
ReadWritePaths=/projects/loopino/data/external-apps-tls /projects/loopino/data/external-apps-acme /projects/loopino/installation/logs/nginx /var/log/nginx /run/nginx.pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
