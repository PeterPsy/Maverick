{
  "app_id": "fitness-coach",
  "contract_version": "1.0",
  "name": "Fitness Coach",
  "version": "0.1.0",
  "description": "Workout builder and mobile-first workout player with app-owned workouts, exercise library, run summaries, MCP, CLI, skills, and base-shell widgets.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "fitness-coach.workouts",
      "version": "1",
      "description": "Workspace-scoped fitness workouts, reusable exercises, validation, and run summaries.",
      "surfaces": [
        "backend",
        "view",
        "mcp",
        "cli",
        "widget"
      ]
    }
  ],
  "requires": [
    {
      "alias": "storage-file-catalog",
      "interface": "file.catalog",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Storage-owned file and folder catalog used by the exercise media picker."
    },
    {
      "alias": "storage-file-preview",
      "interface": "file.preview",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Storage-owned preview metadata used to classify images, videos, PDFs and fallback previews."
    },
    {
      "alias": "storage-file-content-read",
      "interface": "file.content.read",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Bounded Storage read surface used only for small local fallback previews."
    },
    {
      "alias": "storage-media-stream",
      "interface": "file.media.stream",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Authenticated Storage media stream and Drive localization support for workout playback."
    },
    {
      "alias": "storage-google-drive",
      "interface": "file.provider.google-drive",
      "version": "^1",
      "required": false,
      "cardinality": "one",
      "description": "Optional Storage-owned Google Drive provider used when the user links Drive exercise media."
    }
  ],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "fitness_coach_list_workouts",
      "fitness_coach_get_workout",
      "fitness_coach_create_workout",
      "fitness_coach_update_workout",
      "fitness_coach_duplicate_workout",
      "fitness_coach_delete_workout",
      "fitness_coach_validate_workout",
      "fitness_coach_list_exercises",
      "fitness_coach_get_exercise",
      "fitness_coach_create_exercise",
      "fitness_coach_update_exercise",
      "fitness_coach_delete_exercise",
      "fitness_coach_list_runs",
      "fitness_coach_reference_manifest",
      "fitness_coach_view_filter",
      "fitness_coach_set_view_filter",
      "fitness_coach_set_custom_view",
      "fitness_coach_clear_custom_view"
    ],
    "cli_commands": [
      "fitness-coach"
    ],
    "skills": [
      "fitness-coach-ops"
    ],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "workouts",
        "description": "Workout records changed through backend, CLI, or MCP."
      },
      {
        "resource": "exercises",
        "description": "Exercise library records changed through backend, CLI, or MCP."
      },
      {
        "resource": "view-state",
        "description": "Selected workout, setup tab, or sidebar query changed."
      },
      {
        "resource": "runs",
        "description": "Workout run summaries changed."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "main",
        "display_name": "Fitness Coach",
        "entity_types": [],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read Fitness Coach view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set Fitness Coach search, setup tab, and selected workout state."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a custom Fitness Coach view from explicit workout or exercise ids."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Fitness Coach to the default view."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": []
  },
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/fitness-coach/state.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": false,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [
    {
      "widget_id": "fitness-coach-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/fitness-coach-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "fitness-coach-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/fitness-coach-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ]
}
