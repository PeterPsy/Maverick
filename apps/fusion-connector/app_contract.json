{
  "app_id": "fusion-connector",
  "contract_version": "1.0",
  "name": "Fusion Connector",
  "version": "0.1.0",
  "description": "Headless Autodesk Fusion connector that lets Maverick agents discover and call the local Fusion MCP server after policy checks.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [],
  "requires": [],
  "distribution": {
    "mode": "workspace_local",
    "source_access": "editable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "none"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "fusion_status",
      "fusion_list_tools",
      "fusion_session_brief",
      "fusion_call_tool",
      "fusion_capture_screenshot",
      "fusion_config_get",
      "fusion_config_set",
      "fusion_audit_recent",
      "fusion_operations_manifest",
      "fusion_connector_reference_manifest"
    ],
    "cli_commands": [
      "fusion-connector"
    ],
    "skills": [
      "fusion-connector-ops"
    ],
    "views": [],
    "data_events": [],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "hooks": {},
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/fusion-connector/state.json"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": false
  },
  "compatibility": {
    "workspace_modes": [
      "full-access"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 30,
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": false,
    "upgrade": true,
    "uninstall": true,
    "migrate": false,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": false
  },
  "health_contract": {
    "mode": "none",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": []
}
