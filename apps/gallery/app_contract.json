{
  "app_id": "gallery",
  "contract_version": "1.0",
  "name": "Gallery",
  "version": "0.1.0",
  "description": "Workspace file gallery for uploaded files and generated artifacts.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "file.catalog",
      "version": "1",
      "description": "Workspace uploaded and generated file catalog.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    },
    {
      "interface": "file.preview",
      "version": "1",
      "description": "Workspace file preview rendering metadata and widget support.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "widget"
      ]
    },
    {
      "interface": "file.content.read",
      "version": "1",
      "description": "Workspace file content read access through official Gallery surfaces.",
      "surfaces": [
        "backend",
        "cli",
        "mcp"
      ]
    },
    {
      "interface": "file.content.write",
      "version": "1",
      "description": "Workspace file content creation and update access through official Gallery surfaces.",
      "surfaces": [
        "backend",
        "cli",
        "mcp"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "maverick_gallery",
      "gallery_view_filter",
      "gallery_set_view_filter",
      "gallery_set_custom_view",
      "gallery_clear_custom_view",
      "gallery_write_file",
      "gallery_reference_manifest",
      "gallery_reference_search",
      "gallery_reference_resolve",
      "gallery_reference_summarize"
    ],
    "cli_commands": [
      "gallery"
    ],
    "skills": [
      "gallery-ops"
    ],
    "views": [
      "gallery"
    ],
    "data_events": [
      {
        "resource": "files",
        "description": "Emitted when workspace uploaded or generated files change through official Gallery surfaces."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Gallery filters or custom view state change through official Gallery surfaces."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "gallery",
        "display_name": "Gallery",
        "entity_types": [
          "file"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Gallery view state without scanning workspace storage."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set keyword, role, and kind filters for the Gallery view."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of Gallery file references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Gallery to normal search mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "file",
        "display_name": "Workspace File",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "gallery-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/gallery-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "file-preview",
      "host": "chat",
      "content_kinds": [
        "gallery.file",
        "gallery.file.preview",
        "workspace.file",
        "workspace.file.preview"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/file-preview",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/gallery/state.json",
      "data/gallery/preview_cache.json",
      "data/gallery/rendered_previews"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
