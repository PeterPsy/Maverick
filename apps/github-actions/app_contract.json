{
  "app_id": "github-actions",
  "contract_version": "1.0",
  "name": "GitHub Actions",
  "version": "0.1.0",
  "description": "Agent utility for dispatching GitHub Actions workflows through a GitHub App installation.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [],
  "requires": [],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "none"
  },
  "permissions": {
    "secrets": {
      "read": [
        "github-app-id",
        "github-installation-id",
        "github-app-private-key"
      ],
      "write": []
    },
    "network": {
      "outbound": [
        "api.github.com",
        "github.com"
      ]
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "github_actions_reference_manifest",
      "github_actions"
    ],
    "cli_commands": [
      "github-actions"
    ],
    "skills": [
      "github-actions-ops"
    ],
    "views": [],
    "data_events": [],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": null,
    "skills_root": "skills",
    "hooks": {}
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/github-actions/state.json"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": false
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox",
      "full-access"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": false,
    "upgrade": true,
    "uninstall": false,
    "migrate": false,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": false
  },
  "health_contract": {
    "mode": "none",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": []
}
