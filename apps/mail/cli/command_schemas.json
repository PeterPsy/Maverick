{
  "commands": {
    "mail": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "attachments.get": "mutating",
          "attachments.save_all": "mutating",
          "clear_custom_view": "mutating",
          "connections.activate_imap_smtp": "mutating",
          "connections.complete_oauth": "mutating",
          "connections.delete": "destructive",
          "connections.disconnect": "destructive",
          "connections.list": "read",
          "connections.prepare_imap_smtp": "mutating",
          "connections.start_oauth": "mutating",
          "connections.test_imap_smtp": "mutating",
          "connections.update_imap_smtp": "mutating",
          "drafts.create": "mutating",
          "drafts.delete": "destructive",
          "drafts.get": "read",
          "drafts.send": "destructive",
          "drafts.send_approved": "destructive",
          "drafts.update": "mutating",
          "folders.list": "read",
          "get": "read",
          "health.check": "read",
          "labels.list": "read",
          "labels.modify": "mutating",
          "list": "read",
          "mail_create_draft": "mutating",
          "mail_get_attachment": "mutating",
          "mail_get_message": "read",
          "mail_get_thread": "read",
          "mail_list_folders": "read",
          "mail_list_labels": "read",
          "mail_list_threads": "read",
          "mail_mailbox_counts": "read",
          "mail_mark_read": "mutating",
          "mail_modify_labels": "mutating",
          "mail_reference_manifest": "read",
          "mail_reference_resolve": "read",
          "mail_reference_search": "read",
          "mail_reference_summarize": "read",
          "mail_save_attachments": "mutating",
          "mail_search_messages": "read",
          "mail_send": "destructive",
          "mail_send_approved": "destructive",
          "mail_send_draft": "destructive",
          "mail_send_draft_approved": "destructive",
          "mail_sync": "mutating",
          "mail_update_draft": "mutating",
          "mailboxes.counts": "read",
          "messages.get": "read",
          "messages.mark_read": "mutating",
          "messages.search": "read",
          "messages.send": "destructive",
          "messages.send_approved": "destructive",
          "reference_manifest": "read",
          "reference_resolve": "read",
          "reference_search": "read",
          "reference_summarize": "read",
          "search": "read",
          "set_custom_view": "mutating",
          "set_view_filter": "mutating",
          "status": "read",
          "threads.get": "read",
          "threads.list": "read",
          "threads.sync": "mutating",
          "view_filter": "read"
        }
      },
      "description": "Operate the Mail app: list threads, inspect messages, create/send drafts, sync, and check health.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Mail action such as connections.start_oauth, connections.complete_oauth, connections.prepare_imap_smtp, connections.test_imap_smtp, connections.activate_imap_smtp, connections.disconnect, threads.list, threads.get, drafts.create, drafts.send, drafts.send_approved, messages.send, messages.send_approved, messages.search, labels.modify, attachments.get, attachments.save_all, folders.list, or health.check."
          },
          "connection_id": { "type": "string" },
          "thread_id": { "type": "string" },
          "message_id": { "type": "string" },
          "attachment_id": { "type": "string" },
          "draft_id": { "type": "string" },
          "query": { "type": "string" },
          "mailbox": { "type": "string" },
          "mailbox_scopes": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "label": { "type": "string" },
          "offset": { "type": "integer", "minimum": 0 },
          "provider": { "type": "string" },
          "email_address": { "type": "string" },
          "username": { "type": "string" },
          "display_name": { "type": "string" },
          "imap_host": { "type": "string" },
          "imap_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "imap_security": { "type": "string", "enum": ["ssl", "starttls", "none"] },
          "smtp_host": { "type": "string" },
          "smtp_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "smtp_security": { "type": "string", "enum": ["ssl", "starttls", "none"] },
          "redirect_uri": { "type": "string" },
          "state": { "type": "string" },
          "code": { "type": "string" },
          "page_token": { "type": "string" },
          "continue_cursor": { "type": "boolean", "default": false },
          "subject": { "type": "string" },
          "body_text": { "type": "string" },
          "to": {
            "type": "array",
            "items": { "type": "object" }
          },
          "cc": {
            "type": "array",
            "items": { "type": "object" }
          },
          "bcc": {
            "type": "array",
            "items": { "type": "object" }
          },
          "reply_to": {
            "type": "array",
            "items": { "type": "object" }
          },
          "confirm": { "type": "boolean", "default": false },
          "confirmation_token": {
            "type": "string",
            "description": "Opaque token returned in confirmation_preview; required when confirm=true."
          },
          "max_threads": { "type": "integer", "minimum": 1, "maximum": 2000 },
          "max_messages": { "type": "integer", "minimum": 1, "maximum": 100 },
          "max_body_chars": { "type": "integer", "minimum": 200, "maximum": 50000 },
          "max_body_html_chars": { "type": "integer", "minimum": 200, "maximum": 250000 },
          "body_html": { "type": "string" },
          "workspace_attachments": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {"type": "object"}
              ]
            }
          },
          "metadata_only": { "type": "boolean", "default": true },
          "max_bytes": { "type": "integer", "minimum": 1, "maximum": 10000000 },
          "save_to_storage": { "type": "boolean", "default": false },
          "target_folder": { "type": "string" },
          "mode": { "type": "string", "enum": ["create", "overwrite", "versioned"], "default": "versioned" },
          "dedupe": { "type": "boolean", "default": true },
          "filename_contains": { "type": "string" },
          "extensions": { "type": "array", "items": { "type": "string" } },
          "content_types": { "type": "array", "items": { "type": "string" } },
          "max_size_bytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      },
      "secret_resource_inventory": true,
      "required_secrets": [],
      "secret_selectors": [
        {
          "required_secrets": ["gmail-oauth-client-id"],
          "when": { "action": "connections.start_oauth" }
        },
        {
          "required_secrets": ["gmail-oauth-client-id", "gmail-oauth-client-secret"],
          "when": { "action": "connections.complete_oauth" }
        },
        {
          "required_secrets": ["gmail-oauth-client-id", "gmail-oauth-client-secret"],
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": [
              "threads.get",
              "mail_get_thread",
              "threads.sync",
              "mail_sync",
              "drafts.send",
              "drafts.send_approved",
              "mail_send_draft",
              "mail_send_draft_approved",
              "messages.send",
              "messages.send_approved",
              "mail_send",
              "mail_send_approved",
              "attachments.save_all",
              "mail_save_attachments",
              "labels.modify",
              "mail_modify_labels",
              "messages.mark_read",
              "mail_mark_read"
            ]
          }
        },
        {
          "required_secrets": ["gmail-refresh-token"],
          "resource_type": "mail_connection",
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": [
              "threads.get",
              "mail_get_thread",
              "threads.sync",
              "mail_sync",
              "drafts.send",
              "drafts.send_approved",
              "mail_send_draft",
              "mail_send_draft_approved",
              "messages.send",
              "messages.send_approved",
              "mail_send",
              "mail_send_approved",
              "labels.modify",
              "mail_modify_labels",
              "messages.mark_read",
              "mail_mark_read"
            ]
          }
        },
        {
          "required_secrets": ["mailbox-password"],
          "resource_type": "mail_connection",
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": [
              "connections.test_imap_smtp",
              "connections.activate_imap_smtp",
              "threads.sync",
              "mail_sync",
              "drafts.send",
              "drafts.send_approved",
              "mail_send_draft",
              "mail_send_draft_approved",
              "messages.send",
              "messages.send_approved",
              "mail_send",
              "mail_send_approved",
              "labels.modify",
              "mail_modify_labels",
              "messages.mark_read",
              "mail_mark_read"
            ]
          }
        },
        {
          "required_secrets": ["gmail-oauth-client-id", "gmail-oauth-client-secret"],
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": ["attachments.get", "mail_get_attachment"],
            "metadata_only": false
          }
        },
        {
          "required_secrets": ["mailbox-password"],
          "resource_type": "mail_connection",
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": ["attachments.get", "mail_get_attachment"],
            "metadata_only": false
          }
        },
        {
          "required_secrets": ["gmail-refresh-token"],
          "resource_type": "mail_connection",
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": ["attachments.get", "mail_get_attachment"],
            "metadata_only": false
          }
        },
        {
          "required_secrets": ["gmail-oauth-client-id", "gmail-oauth-client-secret"],
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": ["attachments.save_all", "mail_save_attachments"]
          }
        },
        {
          "required_secrets": ["mailbox-password"],
          "resource_type": "mail_connection",
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": ["attachments.save_all", "mail_save_attachments"]
          }
        },
        {
          "required_secrets": ["gmail-refresh-token"],
          "resource_type": "mail_connection",
          "resource_lookup": { "kind": "mail_connection_from_arguments" },
          "when": {
            "action": ["attachments.save_all", "mail_save_attachments"]
          }
        }
      ]
    }
  }
}
