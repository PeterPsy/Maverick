{
  "app_id": "marta-ops",
  "contract_version": "1.0",
  "name": "Marta Ops",
  "version": "0.5.0",
  "description": "Collaborazioni, consegne, amministrazione, contatti, attività e idee per Marta Giunti.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [],
  "requires": [
    {
      "alias": "mail",
      "interface": "mail.workspace",
      "version": "^1",
      "required": false,
      "cardinality": "one",
      "description": "Provider Mail opzionale usato per preparare bozze email dai lavori, senza invio automatico."
    },
    {
      "alias": "calendar",
      "interface": "calendar.events",
      "version": "^1",
      "required": false,
      "cardinality": "one",
      "description": "Provider Calendario opzionale usato per aggiungere le scadenze dei lavori come eventi."
    }
  ],
  "distribution": {
    "mode": "workspace_local",
    "source_access": "editable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "capabilities": {
    "mcp_tools": [],
    "cli_commands": [],
    "skills": [],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "state",
        "description": "Lavori, contatti, attività, note, deliverable o idee sono cambiati."
      }
    ],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "hooks": {},
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist"
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "2",
    "primary_paths": [
      "data/marta-ops/state.json"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": false
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox",
      "full-access"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 30,
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": false,
    "upgrade": false,
    "uninstall": false,
    "migrate": false,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": false
  },
  "health_contract": {
    "mode": "none",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [
    {
      "widget_id": "marta-ops-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/marta-ops-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "marta-ops-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/marta-ops-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ]
}
