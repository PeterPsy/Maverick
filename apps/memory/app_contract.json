{
  "app_id": "memory",
  "contract_version": "1.0",
  "name": "Memory",
  "version": "0.1.0",
  "description": "Workspace knowledge graph for durable agent and user memory.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "memory.context",
      "version": "1",
      "description": "Workspace memory context retrieval and durable knowledge references.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view"
      ]
    },
    {
      "interface": "memory.graph",
      "version": "1",
      "description": "Workspace memory graph references and composed views.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "memory_context",
      "memory_search",
      "memory_remember",
      "memory_update_node",
      "memory_soft_delete_node",
      "memory_link_nodes",
      "memory_unlink_nodes",
      "memory_attach_file",
      "memory_attach_app_entity",
      "memory_inspect_node",
      "memory_compile",
      "memory_lint",
      "memory_wiki_query",
      "memory_audit",
      "memory_view_filter",
      "memory_set_view_filter",
      "memory_set_custom_view",
      "memory_clear_custom_view",
      "memory_reference_manifest",
      "memory_reference_search",
      "memory_reference_resolve",
      "memory_reference_summarize"
    ],
    "cli_commands": [
      "memory"
    ],
    "skills": [
      "memory-ops"
    ],
    "views": [
      "memory"
    ],
    "data_events": [
      {
        "resource": "graph",
        "description": "Emitted when memory nodes, edges, or external references change through official Memory surfaces."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Memory view filters or custom graph views change through official Memory surfaces."
      },
      {
        "resource": "wiki",
        "description": "Emitted when Memory compiled wiki pages, claims, citations, sources, or lint findings change through official Memory surfaces."
      }
    ],
    "reference_entities": [
      {
        "entity_type": "node",
        "display_name": "Memory Node",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ],
    "view_surfaces": [
      {
        "view_id": "memory",
        "display_name": "Memory",
        "entity_types": [
          "node"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Memory graph view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set the keyword filter for the Memory graph view."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of Memory node references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Memory to normal graph search mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "memory-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/memory-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "memory-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/memory-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "sqlite+files",
    "data_schema_version": "2",
    "primary_paths": [
      "data/memory/memory.sqlite",
      "data/memory/artifacts",
      "data/memory/view_state.json"
    ],
    "indices": {
      "kind": "embedded"
    },
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
