{
  "commands": {
    "memory": {
      "description": "Search, retrieve, update, link, inspect, compile, and lint workspace Memory nodes. The default context action returns bounded agent-compact results with reusable Storage references and expansion hints; inspect/fetch actions return full detail when needed.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Memory operation to run. Omit for context retrieval.",
            "enum": [
              "context",
              "search",
              "remember",
              "create_node",
              "update_node",
              "delete_node",
              "soft_delete_node",
              "link",
              "link_nodes",
              "unlink",
              "unlink_nodes",
              "attach_file",
              "ingest_source",
              "ingest_storage_source",
              "apply_storage_staleness",
              "attach_entity",
              "attach_app_entity",
              "inspect",
              "graph",
              "compile",
              "lint",
              "wiki_query",
              "source_query",
              "fetch_chunks",
              "inspect_source",
              "jobs_enqueue",
              "jobs_claim",
              "jobs_complete",
              "jobs_fail",
              "jobs_cancel",
              "jobs_run",
              "jobs_run_loop",
              "jobs_list",
              "audit",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "health.check"
            ],
            "default": "context"
          },
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "record_access_event": {
            "type": "boolean",
            "default": false
          },
          "node_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "body_text": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "node_type": {
            "type": "string"
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metadata": {
            "type": "object"
          },
          "adapter_id": {
            "type": "string",
            "enum": [
              "inline_markdown",
              "storage_file",
              "remote_storage_file",
              "app_entity"
            ],
            "description": "Generic source adapter for ingest_source. Supports inline_markdown, local workspace storage_file sources, remote_storage_file Storage memory_source payloads, and app_entity snapshots through official reference surfaces."
          },
          "source_key": {
            "type": "string",
            "description": "Stable caller-owned source key for ingest_source."
          },
          "body_markdown": {
            "type": "string",
            "description": "Canonical Markdown body for ingest_source with adapter_id=inline_markdown."
          },
          "workspace_relative_path": {
            "type": "string",
            "pattern": "^storage/(uploaded|generated)/.+$",
            "description": "Workspace Storage path for ingest_source with adapter_id=storage_file."
          },
          "file_id": {
            "type": "string",
            "description": "Stable Storage file id for ingest_source with adapter_id=storage_file."
          },
          "memory_source": {
            "type": "object",
            "description": "Storage drive_index.memory_source payload for ingest_source with adapter_id=remote_storage_file or for the transitional ingest_storage_source action."
          },
          "preview_text": {
            "type": "string",
            "description": "Optional bounded preview text returned by Storage drive_index."
          },
          "preview_truncated": {
            "type": "boolean",
            "default": false
          },
          "source_version": {
            "type": "string",
            "description": "Required source version from Storage drive_index for remote_storage_file ingest; may be provided here or in memory_source.metadata.source_version."
          },
          "compile_after_ingest": {
            "type": "boolean",
            "default": false
          },
          "memory_staleness": {
            "type": "object",
            "description": "Storage drive_sync.memory_staleness payload for apply_storage_staleness."
          },
          "staleness": {
            "type": "object",
            "description": "Optional Storage staleness detail for apply_storage_staleness."
          },
          "sync_state": {
            "type": "object",
            "description": "Optional Storage sync state detail for apply_storage_staleness."
          },
          "source_node_id": {
            "type": "string"
          },
          "target_node_id": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "object"
            ],
            "description": "Source node id for link actions, or a nested ingest_source object."
          },
          "target": {
            "type": "string"
          },
          "edge_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string"
          },
          "owning_app_id": {
            "type": "string",
            "description": "Owning app id for attach_entity or ingest_source with adapter_id=app_entity."
          },
          "entity_type": {
            "type": "string",
            "description": "Owning app entity type for attach_entity or ingest_source with adapter_id=app_entity."
          },
          "entity_id": {
            "type": "string",
            "description": "Stable entity id for attach_entity, attach_file, or ingest_source with adapter_id=app_entity."
          },
          "provider": {
            "type": "string",
            "enum": [
              "google_drive",
              "local"
            ]
          },
          "uri": {
            "type": "string"
          },
          "preserve_custom": {
            "type": "boolean",
            "default": false
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 500
          },
          "chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "source_document_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "list",
              "enqueue",
              "claim",
              "complete",
              "fail",
              "cancel",
              "run_next",
              "run_until_idle"
            ]
          },
          "job_type": {
            "type": "string",
            "enum": [
              "ingest_source",
              "compile_node",
              "lint_node",
              "mark_stale",
              "requires_storage_reindex"
            ]
          },
          "job_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ingest_source",
                "compile_node",
                "lint_node",
                "mark_stale",
                "requires_storage_reindex"
              ]
            },
            "maxItems": 5
          },
          "dedupe_key": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "available_at": {
            "type": "string"
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "lease_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 3600
          },
          "lease_token": {
            "type": "string"
          },
          "max_jobs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum jobs to execute when operation=run_until_idle or action=jobs_run_loop."
          },
          "stop_on_error": {
            "type": "boolean",
            "default": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "running",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false,
        "examples": [
          {
            "action": "context",
            "query": "renewal terms",
            "limit": 8
          },
          {
            "action": "remember",
            "title": "Customer renewal notes",
            "body": "ACME asked for revised payment terms."
          },
          {
            "action": "attach_file",
            "node_id": "node_example",
            "owning_app_id": "storage",
            "entity_type": "file",
            "entity_id": "file_example",
            "provider": "google_drive",
            "metadata": {
              "provider": "google_drive",
              "connection_id": "drive_conn_example",
              "drive_file_id": "1AbC",
              "source_version": "etag-or-modified-at",
              "display_path": "Drive/Folder/Document"
            }
          },
          {
            "action": "ingest_storage_source",
            "title": "Drive document",
            "memory_source": {
              "source_kind": "remote_storage_file",
              "owning_app_id": "storage",
              "entity_type": "file",
              "entity_id": "file_example",
              "file_id": "file_example",
              "workspace_relative_path": "",
              "metadata": {
                "provider": "google_drive",
                "connection_id": "drive_conn_example",
                "drive_file_id": "1AbC",
                "source_version": "etag-or-modified-at",
                "display_path": "Drive/Folder/Document"
              }
            },
            "preview_text": "Bounded text returned by storage_drive_index.",
            "compile_after_ingest": true
          },
          {
            "action": "apply_storage_staleness",
            "owning_app_id": "storage",
            "entity_type": "file",
            "entity_id": "file_example",
            "reason": "google_drive_change"
          },
          {
            "action": "compile",
            "node_id": "node_example"
          }
        ]
      },
      "required_secrets": [],
      "secret_selectors": []
    }
  }
}
