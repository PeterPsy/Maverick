{
  "tools": {
    "memory_context": {
      "effect_class": "read",
      "description": "Start with compact context (9500 byte default budget). Returns separate search continuation, byte omissions, reasons, scope/validity, verification and compilation state. Reserves critical contradictions/supersessions even at a full textual limit. Explore when needed, then inspect selective evidence or fetch original chunks.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 8},
          "record_access_event": {"type": "boolean", "default": false},
          "scope": {
            "type": "object",
            "properties": {
              "project_id": {"type": "string", "maxLength": 256},
              "person_id": {"type": "string", "maxLength": 256},
              "as_of": {"type": "string", "format": "date"},
              "include_expired": {"type": "boolean", "default": false},
              "include_unscoped": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          },
          "project_id": {"type": "string"},
          "person_id": {"type": "string"},
          "cursor": {"type": "string", "maxLength": 1024},
          "max_bytes": {"type": "integer", "minimum": 2000, "maximum": 64000, "default": 9500},
          "as_of": {"type": "string", "format": "date"},
          "include_expired": {"type": "boolean"},
          "include_unscoped": {"type": "boolean"}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "items",
          "retrieval_has_more",
          "search_next_cursor",
          "omitted_for_budget",
          "budget_omitted_node_ids",
          "candidate_count_is_exact",
          "snapshot_id",
          "critical_edges",
          "view"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {"type": "object", "required": ["node_id", "title", "reason", "revision", "verification", "compilation_state"]}
          },
          "retrieval_has_more": {"type": "boolean"},
          "search_next_cursor": {"type": ["string", "null"]},
          "total_candidate_count": {"type": ["integer", "null"]},
          "omitted_for_budget": {"type": "integer"},
          "budget_omitted_node_ids": {"type": "array", "items": {"type": "string"}},
          "candidate_count_is_exact": {"type": "boolean"},
          "snapshot_id": {"type": "string"},
          "critical_edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "source", "target", "kind", "hop", "reason", "revision", "confidence_basis"],
              "properties": {
                "id": {"type": "string"},
                "source": {"type": "string"},
                "target": {"type": "string"},
                "kind": {"type": "string"},
                "hop": {"type": "integer"}
              }
            }
          },
          "view": {"type": "object", "required": ["node_ids", "snapshot_id"]}
        }
      }
    },
    "memory_search": {
      "effect_class": "read",
      "description": "Search node, wiki, claim and current-source FTS with shared project/person/validity filters and stable ID/alias matching. Compact cards by default; detail=evidence is explicit. Follow next_cursor; use context for answer-ready evidence and explore for connections.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
          "scope": {
            "type": "object",
            "properties": {
              "project_id": {"type": "string", "maxLength": 256},
              "person_id": {"type": "string", "maxLength": 256},
              "as_of": {"type": "string", "format": "date"},
              "include_expired": {"type": "boolean", "default": false},
              "include_unscoped": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          },
          "project_id": {"type": "string"},
          "person_id": {"type": "string"},
          "cursor": {"type": "string", "maxLength": 1024},
          "max_bytes": {"type": "integer", "minimum": 2000, "maximum": 64000, "default": 9500},
          "as_of": {"type": "string", "format": "date"},
          "include_expired": {"type": "boolean"},
          "include_unscoped": {"type": "boolean"},
          "detail": {"enum": ["card", "evidence"], "default": "card"}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["results", "has_more", "next_cursor", "omitted_for_budget", "stop_reason", "snapshot_id"],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "node_id", "title", "status", "revision", "verification", "compilation_state", "details_available"],
              "properties": {
                "id": {"type": "string"},
                "node_id": {"type": "string"},
                "title": {"type": "string"},
                "status": {"type": "string"},
                "revision": {"type": "string"},
                "verification": {"enum": ["unverified", "verified", "conflict"]},
                "compilation_state": {"type": "string"},
                "details_available": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "has_more": {"type": "boolean"},
          "next_cursor": {"type": ["string", "null"]},
          "omitted_for_budget": {"type": "integer", "minimum": 0},
          "stop_reason": {"enum": ["budget", "limit", "end"]},
          "snapshot_id": {"type": "string"}
        }
      }
    },
    "memory_remember": {
      "effect_class": "mutating",
      "description": "Create one durable Memory node.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "body": {"type": "string"},
          "body_text": {"type": "string"},
          "type": {"type": "string"},
          "node_type": {"type": "string"},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "metadata": {"type": "object"}
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_update_node": {
      "effect_class": "mutating",
      "description": "Update title, summary, body, importance, or confidence for one active Memory node.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "body": {"type": "string"},
          "body_text": {"type": "string"},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "metadata": {"type": "object"},
          "type": {"type": "string"},
          "expected_updated_at": {"type": "string"}
        },
        "anyOf": [{"required": ["node_id"]}, {"required": ["id"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_soft_delete_node": {
      "effect_class": "destructive",
      "description": "Soft-delete one Memory node and its active edges.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "id": {"type": "string"},
          "reason": {"type": "string"},
          "actor_id": {"type": "string"},
          "expected_updated_at": {"type": "string"}
        },
        "anyOf": [{"required": ["node_id"]}, {"required": ["id"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_link_nodes": {
      "effect_class": "mutating",
      "description": "Create a typed relationship between two active Memory nodes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "edge_id": {"type": "string"},
          "source_node_id": {"type": "string"},
          "target_node_id": {"type": "string"},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "kind": {"type": "string"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"},
          "metadata": {"type": "object"}
        },
        "anyOf": [{"required": ["source_node_id", "target_node_id"]}, {"required": ["source", "target"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_unlink_nodes": {
      "effect_class": "destructive",
      "description": "Soft-delete one Memory edge.",
      "input_schema": {
        "type": "object",
        "properties": {"edge_id": {"type": "string"}, "id": {"type": "string"}},
        "anyOf": [{"required": ["edge_id"]}, {"required": ["id"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_attach_file": {
      "effect_class": "mutating",
      "description": "Attach a Storage file reference to a Memory node. For Google Drive, pass a remote_storage_file shape from Storage drive_index.memory_source; do not pass workspace_relative_path or Google tokens.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "node": {"type": "string"},
          "external_ref_id": {"type": "string"},
          "owning_app_id": {"type": "string", "default": "storage"},
          "entity_type": {"type": "string", "default": "file"},
          "entity_id": {"type": "string"},
          "file_id": {"type": "string"},
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "title": {"type": "string"},
          "provider": {"type": "string", "enum": ["google_drive", "local"]},
          "uri": {"type": "string"},
          "metadata": {
            "type": "object",
            "properties": {
              "provider": {"type": "string"},
              "connection_id": {"type": "string"},
              "drive_file_id": {"type": "string"},
              "source_version": {
                "type": "string",
                "description": "Required Storage source version from drive_index; may also be present in memory_source.metadata.source_version."
              },
              "display_path": {"type": "string"},
              "staleness": {"type": ["object", "string"]},
              "sync_state": {"type": "object"}
            },
            "additionalProperties": true
          }
        },
        "anyOf": [{"required": ["node_id"]}, {"required": ["node"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_ingest_source": {
      "effect_class": "mutating",
      "description": "Ingest one generic app-owned source into Memory. Supports inline_markdown, local workspace storage_file sources, remote_storage_file Storage memory_source payloads, and app_entity snapshots through official reference surfaces. Storage-backed adapters use official Storage surfaces before Memory creates verified source document, source version, and source chunk rows; non-extractable Storage files are recorded as reference snapshots.",
      "input_schema": {
        "type": "object",
        "properties": {
          "adapter_id": {"type": "string", "enum": ["inline_markdown", "storage_file", "remote_storage_file", "app_entity"]},
          "source_key": {"type": "string", "description": "Stable caller-owned source key. If omitted, Memory derives one from the canonical body hash."},
          "node_id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "body": {"type": "string"},
          "body_markdown": {"type": "string"},
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "file_id": {"type": "string"},
          "owning_app_id": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "content_type": {"type": "string"},
          "modified_at": {"type": "string"},
          "type": {"type": "string"},
          "node_type": {"type": "string"},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "metadata": {"type": "object"},
          "source_version": {"type": "string", "minLength": 1},
          "preview_text": {"type": "string", "maxLength": 20000},
          "preview_truncated": {"type": "boolean", "default": false},
          "memory_source": {
            "type": "object",
            "properties": {
              "source_kind": {"type": "string", "enum": ["remote_storage_file"]},
              "owning_app_id": {"type": "string", "default": "storage"},
              "entity_type": {"type": "string", "default": "file"},
              "entity_id": {"type": "string"},
              "file_id": {"type": "string"},
              "workspace_relative_path": {"type": "string", "maxLength": 0},
              "title": {"type": "string"},
              "uri": {"type": "string"},
              "metadata": {"type": "object"}
            },
            "required": ["source_kind"],
            "additionalProperties": false
          },
          "compile_after_ingest": {"type": "boolean", "default": false},
          "source": {
            "type": "object",
            "properties": {
              "adapter_id": {"type": "string", "enum": ["inline_markdown", "storage_file", "remote_storage_file", "app_entity"]},
              "source_kind": {"type": "string", "enum": ["remote_storage_file", "app_entity"]},
              "source_key": {"type": "string"},
              "stable_source_id": {"type": "string"},
              "owning_app_id": {"type": "string"},
              "entity_type": {"type": "string"},
              "title": {"type": "string"},
              "summary": {"type": "string"},
              "body": {"type": "string"},
              "body_markdown": {"type": "string"},
              "workspace_relative_path": {"type": "string"},
              "file_id": {"type": "string"},
              "entity_id": {"type": "string"},
              "uri": {"type": "string"},
              "content_type": {"type": "string"},
              "modified_at": {"type": "string"},
              "metadata": {"type": "object"}
            },
            "additionalProperties": false
          },
          "operation": {
            "type": "string",
            "enum": ["attach_evidence", "update_fact", "replace_fact"],
            "description": "Default: refresh generated document facts; attach evidence to curated notes. replace_fact saves the previous fact revision."
          },
          "fact_body": {"type": "string", "description": "Fact content distinct from the evidence body."},
          "fact_summary": {"type": "string"},
          "fact_metadata": {"type": "object"},
          "expected_updated_at": {"type": "string"}
        },
        "oneOf": [
          {
            "properties": {"adapter_id": {"const": "inline_markdown"}},
            "required": ["adapter_id"],
            "anyOf": [{"required": ["body_markdown"]}, {"required": ["body"]}]
          },
          {
            "properties": {"adapter_id": {"const": "storage_file"}},
            "required": ["adapter_id"],
            "anyOf": [{"required": ["workspace_relative_path"]}, {"required": ["file_id"]}, {"required": ["entity_id"]}]
          },
          {"properties": {"adapter_id": {"const": "remote_storage_file"}}, "required": ["adapter_id", "memory_source"]},
          {"properties": {"adapter_id": {"const": "app_entity"}}, "required": ["adapter_id", "owning_app_id", "entity_type", "entity_id"]},
          {
            "required": ["source"],
            "not": {"required": ["adapter_id"]},
            "properties": {
              "source": {
                "required": ["adapter_id"],
                "oneOf": [
                  {
                    "properties": {"adapter_id": {"const": "inline_markdown"}},
                    "anyOf": [{"required": ["body_markdown"]}, {"required": ["body"]}]
                  },
                  {
                    "properties": {"adapter_id": {"const": "storage_file"}},
                    "anyOf": [{"required": ["workspace_relative_path"]}, {"required": ["file_id"]}, {"required": ["entity_id"]}]
                  },
                  {"properties": {"adapter_id": {"const": "remote_storage_file"}}, "required": ["adapter_id"]},
                  {"properties": {"adapter_id": {"const": "app_entity"}}, "required": ["owning_app_id", "entity_type", "entity_id"]}
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_ingest_storage_source": {
      "effect_class": "mutating",
      "description": "Ingest one Storage drive_index.memory_source into Memory, creating or updating the target node/reference idempotently by stable Storage file id. For Google Drive, pass only Storage reference metadata and optional bounded preview_text; do not pass workspace_relative_path or Google tokens.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "body": {"type": "string"},
          "body_text": {"type": "string"},
          "type": {"type": "string"},
          "node_type": {"type": "string"},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_version": {"type": "string", "minLength": 1},
          "preview_text": {"type": "string", "maxLength": 20000},
          "preview_truncated": {"type": "boolean", "default": false},
          "compile_after_ingest": {"type": "boolean", "default": false},
          "operation": {"type": "string", "enum": ["attach_evidence", "update_fact", "replace_fact"]},
          "fact_body": {"type": "string"},
          "fact_summary": {"type": "string"},
          "fact_metadata": {"type": "object"},
          "expected_updated_at": {"type": "string"},
          "memory_source": {
            "type": "object",
            "properties": {
              "source_kind": {"type": "string", "enum": ["remote_storage_file"]},
              "owning_app_id": {"type": "string", "default": "storage"},
              "entity_type": {"type": "string", "default": "file"},
              "entity_id": {"type": "string"},
              "file_id": {"type": "string"},
              "workspace_relative_path": {"type": "string", "maxLength": 0},
              "title": {"type": "string"},
              "uri": {"type": "string"},
              "metadata": {
                "type": "object",
                "properties": {
                  "provider": {"type": "string", "enum": ["google_drive"]},
                  "connection_id": {"type": "string"},
                  "drive_file_id": {"type": "string"},
                  "source_version": {"type": "string"},
                  "display_path": {"type": "string"},
                  "staleness": {"type": ["object", "string"]},
                  "sync_state": {"type": "object"}
                },
                "required": ["provider", "connection_id", "drive_file_id"],
                "additionalProperties": true
              }
            },
            "required": ["source_kind", "entity_id", "metadata"],
            "additionalProperties": true
          }
        },
        "required": ["memory_source"],
        "anyOf": [
          {"required": ["source_version"]},
          {"properties": {"memory_source": {"properties": {"metadata": {"required": ["source_version"]}}}}}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_apply_storage_staleness": {
      "effect_class": "mutating",
      "description": "Apply one Storage drive_sync.memory_staleness payload to Memory, marking linked Storage references, compiled wiki pages, and claims stale so agents can re-index through Storage drive_index.",
      "input_schema": {
        "type": "object",
        "properties": {
          "owning_app_id": {"type": "string", "const": "storage"},
          "entity_type": {"type": "string", "const": "file"},
          "entity_id": {"type": "string"},
          "file_id": {"type": "string"},
          "reason": {"type": "string", "default": "google_drive_change"},
          "staleness": {"type": "object"},
          "sync_state": {"type": "object"},
          "memory_staleness": {
            "type": "object",
            "properties": {
              "owning_app_id": {"type": "string", "const": "storage"},
              "entity_type": {"type": "string", "const": "file"},
              "entity_id": {"type": "string"},
              "reason": {"type": "string"},
              "connection_id": {"type": "string"},
              "drive_file_id": {"type": "string"},
              "source_version": {"type": "string"},
              "indexed_source_version": {"type": "string"},
              "staleness": {"type": "object"},
              "sync_state": {"type": "object"}
            },
            "required": ["owning_app_id", "entity_type", "entity_id"],
            "additionalProperties": true
          }
        },
        "oneOf": [{"required": ["owning_app_id", "entity_type", "entity_id"]}, {"required": ["memory_staleness"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_attach_app_entity": {
      "effect_class": "mutating",
      "description": "Attach one external app entity reference to a Memory node.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "node": {"type": "string"},
          "external_ref_id": {"type": "string"},
          "owning_app_id": {"type": "string"},
          "entity_type": {"type": "string"},
          "entity_id": {"type": "string"},
          "title": {"type": "string"},
          "uri": {"type": "string"},
          "metadata": {"type": "object"}
        },
        "required": ["owning_app_id", "entity_type", "entity_id"],
        "anyOf": [{"required": ["node_id"]}, {"required": ["node"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_inspect_node": {
      "effect_class": "read",
      "description": "Read one node card by default. Select evidence, content, sources or history explicitly; follow next_cursor for that section. full is an explicit unbudgeted audit inspection. Use memory_explore for connections and memory_get_nodes for batch cards.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_id": {"type": "string"},
          "entity_id": {"type": "string"},
          "id": {"type": "string"},
          "detail": {"enum": ["card", "content", "evidence", "sources", "history", "full"], "default": "card"},
          "content": {"enum": ["node", "wiki"], "default": "node"},
          "content_chars": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 3000},
          "revision_id": {"type": "string"},
          "claim_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
          "cursor": {"type": "string", "maxLength": 1024},
          "max_bytes": {"type": "integer", "minimum": 2000, "maximum": 64000, "default": 9500}
        },
        "anyOf": [{"required": ["node_id"]}, {"required": ["entity_id"]}, {"required": ["id"]}],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["node", "detail", "has_more", "next_cursor"],
        "properties": {
          "node": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "claims": {"type": "array", "items": {"type": "object"}},
              "citations": {"type": "array", "items": {"type": "object"}},
              "sources": {"type": "array", "items": {"type": "object"}},
              "revisions": {"type": "array", "items": {"type": "object"}}
            }
          },
          "detail": {"enum": ["card", "content", "evidence", "sources", "history", "full"], "default": "card"},
          "has_more": {"type": "boolean"},
          "next_cursor": {"type": ["string", "null"]},
          "omitted_for_budget": {"type": "integer", "minimum": 0},
          "stop_reason": {"enum": ["budget", "limit", "end"]},
          "snapshot_id": {"type": "string"},
          "text": {"type": "string"},
          "content_char_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "memory_compile": {
      "effect_class": "mutating",
      "description": "Compile one Memory node into deterministic internal wiki content with sources, source versions, claims, citations, and lint findings.",
      "input_schema": {
        "type": "object",
        "properties": {"node_id": {"type": "string"}, "id": {"type": "string"}},
        "anyOf": [{"required": ["node_id"]}, {"required": ["id"]}],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_lint": {
      "effect_class": "mutating",
      "description": "Refresh Memory lint findings for nodes, compiled wiki pages, and Storage-backed source freshness.",
      "input_schema": {
        "type": "object",
        "properties": {"node_id": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 500}},
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
    "memory_wiki_query": {
      "effect_class": "read",
      "description": "Search compiled wiki pages and claims directly for agent-facing evidence retrieval, including citation source versions and Storage preview/export references when available.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10},
          "cursor": {"type": "string", "maxLength": 1024},
          "max_bytes": {"type": "integer", "minimum": 2000, "maximum": 64000, "default": 9500},
          "scope": {
            "type": "object",
            "properties": {
