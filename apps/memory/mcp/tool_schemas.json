    "memory_explore": {
      "effect_class": "read",
      "description": "Explore directed graph connections from one to five known nodes. One hop by default; depth=2 is explicit. Preserves parallel edge ids and handles cycles. Returns compact endpoint cards, reasons, evidence/compilation states, a snapshot id and request-bound next_cursor. Read-only; never changes the shared UI view.",
      "input_schema": {
        "type": "object",
        "properties": {
          "node_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 5},
          "direction": {"enum": ["incoming", "outgoing", "both"], "default": "both"},
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "related_to",
                "supports",
                "contradicts",
                "mentions",
                "derived_from",
                "about",
                "owned_by",
                "requested_by",
                "depends_on",
                "same_as",
                "supersedes"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "depth": {"type": "integer", "minimum": 1, "maximum": 2, "default": 1},
          "scope": {
            "type": "object",
            "properties": {
              "project_id": {"type": "string", "maxLength": 256},
              "person_id": {"type": "string", "maxLength": 256},
              "as_of": {"type": "string", "format": "date"},
              "include_expired": {"type": "boolean", "default": false},
              "include_unscoped": {"type": "boolean", "default": false}
            },
            "additionalProperties": false
          },
          "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
          "cursor": {"type": "string", "maxLength": 1024},
          "max_bytes": {"type": "integer", "minimum": 2000, "maximum": 64000, "default": 9500}
        },
        "required": ["node_ids"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "nodes",
          "has_more",
          "next_cursor",
          "omitted_for_budget",
          "stop_reason",
          "snapshot_id",
          "edges",
          "visited_node_ids",
          "unavailable_node_ids"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "node_id", "title", "status", "revision", "verification", "compilation_state", "details_available"],
              "properties": {
                "id": {"type": "string"},
                "node_id": {"type": "string"},
                "title": {"type": "string"},
                "status": {"type": "string"},
                "revision": {"type": "string"},
                "verification": {"enum": ["unverified", "verified", "conflict"]},
                "compilation_state": {"type": "string"},
                "details_available": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "has_more": {"type": "boolean"},
          "next_cursor": {"type": ["string", "null"]},
          "omitted_for_budget": {"type": "integer", "minimum": 0},
          "stop_reason": {"enum": ["budget", "limit", "end"]},
          "snapshot_id": {"type": "string"},
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "source", "target", "kind", "hop", "reason", "revision", "confidence_basis"],
              "properties": {
                "id": {"type": "string"},
                "source": {"type": "string"},
                "target": {"type": "string"},
                "kind": {"type": "string"},
                "hop": {"type": "integer"}
              }
            }
          },
          "visited_node_ids": {"type": "array", "items": {"type": "string"}},
          "unavailable_node_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
