    "memory_jobs": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "operation",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "list": "read",
          "enqueue": "mutating",
          "claim": "mutating",
          "complete": "mutating",
          "fail": "mutating",
          "cancel": "destructive",
          "run_next": "mutating",
          "run_until_idle": "mutating"
        }
      },
      "description": "Manage the app-owned Memory ingest job queue: list, enqueue, claim, complete, fail, cancel, run the next job, or drain ready jobs with a bounded runner.",
      "input_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["list", "enqueue", "claim", "complete", "fail", "cancel", "run_next", "run_until_idle"],
            "default": "list"
          },
          "job_id": {"type": "string"},
          "id": {"type": "string"},
          "job_type": {"type": "string", "enum": ["ingest_source", "compile_node", "lint_node", "mark_stale", "requires_storage_reindex"]},
          "job_types": {
            "type": "array",
            "items": {"type": "string", "enum": ["ingest_source", "compile_node", "lint_node", "mark_stale", "requires_storage_reindex"]},
            "maxItems": 5
          },
          "dedupe_key": {"type": "string"},
          "payload": {"type": "object"},
          "available_at": {"type": "string"},
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
          "lease_seconds": {"type": "integer", "minimum": 30, "maximum": 3600, "default": 300},
          "lease_token": {"type": "string"},
          "error": {"type": "string"},
          "status": {"type": "string", "enum": ["ready", "running", "done", "failed", "cancelled"]},
          "max_jobs": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50},
          "stop_on_error": {"type": "boolean", "default": true},
          "limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}
        },
        "additionalProperties": false
      },
      "output_schema": {"type": "object"}
    },
