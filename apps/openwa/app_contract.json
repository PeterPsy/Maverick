{
  "app_id": "openwa",
  "contract_version": "1.0",
  "name": "OpenWA",
  "version": "0.1.0",
  "description": "Native WhatsApp sessions, conversations and messaging powered by rmyndharis/OpenWA.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "whatsapp.workspace",
      "version": "1",
      "surfaces": [
        "backend",
        "cli",
        "mcp"
      ],
      "description": "WhatsApp sessions, chat reads and explicitly authorized sends."
    },
    {
      "interface": "notifications.inbox",
      "version": "1",
      "surfaces": [
        "backend"
      ],
      "description": "User-scoped notifications for failed or uncertain WhatsApp sends."
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "workspace_local",
    "source_access": "editable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace",
    "sidebar_enabled": false
  },
  "capabilities": {
    "mcp_tools": [
      "openwa_reference_manifest",
      "openwa_status",
      "openwa_sessions_list",
      "openwa_session_get",
      "openwa_session_qr",
      "openwa_chats_list",
      "openwa_contacts_list",
      "openwa_messages_list",
      "openwa_webhooks_list",
      "openwa_templates_list",
      "openwa_session_create",
      "openwa_session_start",
      "openwa_session_stop",
      "openwa_session_logout",
      "openwa_session_pair",
      "openwa_messages_send",
      "openwa_messages_reply"
    ],
    "cli_commands": [
      "openwa"
    ],
    "skills": [
      "openwa-ops"
    ],
    "views": [
      "chat"
    ],
    "data_events": [
      {
        "resource": "connection",
        "description": "OpenWA connection changed."
      },
      {
        "resource": "sessions",
        "description": "OpenWA sessions changed."
      },
      {
        "resource": "messages",
        "description": "OpenWA messages changed."
      },
      {
        "resource": "notifications",
        "description": "OpenWA notifications changed."
      }
    ],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    },
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "sqlite",
    "data_schema_version": "1",
    "primary_paths": [
      "data/openwa/app.sqlite",
      "data/openwa/gateway"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "full-access"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 30,
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": false,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [],
  "permissions": {
    "secrets": {
      "read": [
        "openwa-api-key"
      ],
      "write": []
    },
    "network": {
      "outbound": [
        "*"
      ]
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  }
}
