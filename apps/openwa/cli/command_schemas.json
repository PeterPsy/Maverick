{
  "commands": {
    "openwa": {
      "description": "Manage OpenWA sessions and conversations. Sending requires explicit authorization of recipient and exact text.",
      "argument_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status",
              "sessions.list",
              "session.get",
              "session.qr",
              "chats.list",
              "contacts.list",
              "messages.list",
              "webhooks.list",
              "templates.list",
              "session.create",
              "session.start",
              "session.stop",
              "session.logout",
              "session.pair",
              "messages.send",
              "messages.reply",
              "connection.save"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "chat_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 4096
          },
          "message_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      },
      "required_secrets": [
        "openwa-api-key"
      ],
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "destructive",
        "value_effect_classes": {
          "status": "read",
          "sessions.list": "read",
          "session.get": "read",
          "session.qr": "read",
          "chats.list": "read",
          "contacts.list": "read",
          "messages.list": "read",
          "webhooks.list": "read",
          "templates.list": "read",
          "session.create": "mutating",
          "session.start": "mutating",
          "session.stop": "mutating",
          "session.logout": "destructive",
          "session.pair": "mutating",
          "messages.send": "mutating",
          "messages.reply": "mutating",
          "connection.save": "mutating"
        }
      }
    },
    "provider": {
      "description": "Inspect or maintain only the default workspace local WhatsApp provider supervisor and automatic recovery. Requires the trusted platform administrator; never sends or unlinks WhatsApp.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status",
              "start",
              "restart",
              "stop"
            ],
            "default": "status"
          }
        },
        "additionalProperties": false
      },
      "required_secrets": [],
      "timeout_seconds": 120,
      "effect_class": "mutating",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "status": "read",
          "start": "mutating",
          "restart": "mutating",
          "stop": "mutating"
        }
      }
    }
  }
}
