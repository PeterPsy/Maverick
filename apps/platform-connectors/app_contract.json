{
  "app_id": "platform-connectors",
  "contract_version": "1.0",
  "name": "Connectors",
  "version": "1.0.0",
  "description": "Read Instagram, social platforms, YouTube, GitHub and public web sources through governed connectors.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [],
  "requires": [
    {
      "alias": "browser",
      "interface": "browser.lab",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "User-shared Chrome observations and public web research."
    },
    {
      "alias": "storage",
      "interface": "file.content.write",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Verified collection exports through Storage."
    },
    {
      "alias": "speech",
      "interface": "speech.transcription",
      "version": "^1",
      "required": false,
      "cardinality": "one",
      "description": "Local-only transcription of bounded public audio."
    }
  ],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "none"
  },
  "capabilities": {
    "mcp_tools": [
      "connectors_status",
      "connectors_connections_refresh",
      "connectors_run_start",
      "connectors_run_get",
      "connectors_run_refresh",
      "connectors_run_cancel",
      "connectors_collection_save",
      "connectors_collection_get",
      "connectors_collection_rename",
      "connectors_collection_delete",
      "connectors_collection_refresh",
      "connectors_collection_export",
      "platform_connectors_reference_manifest",
      "platform_connectors_reference_search",
      "platform_connectors_reference_resolve",
      "platform_connectors_reference_summarize",
      "platform_connectors_view_filter",
      "platform_connectors_set_view_filter",
      "platform_connectors_set_custom_view",
      "platform_connectors_clear_custom_view"
    ],
    "cli_commands": [
      "platform-connectors"
    ],
    "skills": [
      "platform-connectors-ops"
    ],
    "views": [],
    "data_events": [
      {
        "resource": "state",
        "description": "Primary app state changed."
      }
    ],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    },
    "backend": "backend/app_backend.py",
    "frontend": null,
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "sqlite+files",
    "data_schema_version": "1",
    "primary_paths": [
      "data/platform-connectors/connectors.sqlite3"
    ],
    "indices": null,
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "full-access"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 120,
    "install_seconds": 120,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [],
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": [
        "*"
      ]
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  }
}
