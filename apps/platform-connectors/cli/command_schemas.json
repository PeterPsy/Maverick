                "maxLength": 20
              },
              "max_items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "max_batches": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "max_details": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "frame_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "max_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 180
              },
