              "instagram",
              "twitter",
              "reddit",
              "facebook",
              "linkedin",
              "youtube",
              "rss",
              "web",
              "github"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "read",
              "profile",
              "search",
              "collect",
              "transcript",
              "video"
            ]
          },
          "parameters": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
