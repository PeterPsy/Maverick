{
  "commands": {
    "platform-connectors": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "status": "read",
          "connections.refresh": "mutating",
          "run.start": "mutating",
          "run.get": "read",
          "run.refresh": "mutating",
          "run.cancel": "mutating",
          "collection.save": "mutating",
          "collection.get": "read",
          "collection.rename": "mutating",
          "collection.delete": "destructive",
          "collection.refresh": "mutating",
          "collection.export": "mutating",
          "references.manifest": "read",
          "references.search": "read",
          "references.resolve": "read",
          "references.summarize": "read",
          "view_filter": "read",
          "set_view_filter": "mutating",
          "set_custom_view": "mutating",
          "clear_custom_view": "mutating"
        }
      },
      "description": "Read sources, observe shared platform tabs, manage private collections and export through Storage.",
      "argument_schema": {
        "type": "object",
        "properties": {
