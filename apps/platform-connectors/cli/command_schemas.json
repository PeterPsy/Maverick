              "run.start",
              "run.get",
              "run.refresh",
              "run.cancel",
              "collection.save",
              "collection.get",
              "collection.rename",
              "collection.delete",
              "collection.refresh",
              "collection.export",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view"
