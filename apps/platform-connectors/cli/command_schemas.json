          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "session_id": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "collection"
            ]
          },
          "entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "refs": {
            "type": "array",
