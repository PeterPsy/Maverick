{
  "app_id": "senses",
  "contract_version": "1.0",
  "name": "Senses",
  "version": "0.7.0",
  "description": "Device and sensor connector for Maverick workspace inputs with user-session pairing, Storage-backed captures, and runtime routing to Chat.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "device.registry",
      "version": "1",
      "description": "Workspace-scoped Senses device registry and user-session pairing state.",
      "surfaces": [
        "backend",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [
    {
      "alias": "storage-file-content-write",
      "interface": "file.content.write",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Storage-owned creation of future Senses capture files under workspace Storage."
    },
    {
      "alias": "storage-file-catalog",
      "interface": "file.catalog",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Storage-owned file identity, metadata, and links for future Senses capture records."
    }
  ],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": true,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "senses_reference_manifest",
      "senses_operations_manifest",
      "senses_view_filter",
      "senses_set_view_filter",
      "senses_set_custom_view",
      "senses_clear_custom_view"
    ],
    "cli_commands": [
      "senses"
    ],
    "skills": [],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "devices",
        "description": "Senses device registry changed."
      },
      {
        "resource": "pairing",
        "description": "Senses pairing sessions changed."
      },
      {
        "resource": "settings",
        "description": "Senses settings changed."
      },
      {
        "resource": "captures",
        "description": "Senses capture metadata or Storage references changed."
      },
      {
        "resource": "routing",
        "description": "Senses runtime routing sessions or dispatch attempts changed."
      },
      {
        "resource": "view-state",
        "description": "Senses frontend view filters or active tab changed."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "main",
        "display_name": "Senses",
        "entity_types": [],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Senses frontend view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set Senses tab, search, and status filters."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated Senses device, capture, or routing selection."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Senses to normal browsing."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": []
  },
  "widgets": [
    {
      "widget_id": "senses-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/senses-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": false,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": null,
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "sqlite+files",
    "data_schema_version": "4",
    "primary_paths": [
      "data/senses/senses.sqlite"
    ],
    "indices": {
      "kind": "embedded"
    },
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
