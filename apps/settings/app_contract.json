{
  "app_id": "settings",
  "contract_version": "1.0",
  "name": "Settings",
  "version": "0.1.0",
  "description": "Admin-only platform settings app for provider/runtime settings, users, workspace access, app visibility, and persistence.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "platform.settings",
      "version": "1",
      "description": "Administrative settings, recovery, persistence, user, workspace, and app-management surfaces.",
      "surfaces": [
        "cli",
        "mcp",
        "view",
        "widget"
      ]
    },
    {
      "interface": "user.management",
      "version": "1",
      "description": "Administrative user, role, and workspace assignment management.",
      "surfaces": [
        "cli",
        "mcp",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": [
      "admin"
    ]
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "settings_reference_manifest",
      "settings_reference_search",
      "settings_reference_resolve",
      "settings_reference_summarize"
    ],
    "cli_commands": [
      "settings"
    ],
    "skills": [],
    "views": [
      "settings"
    ],
    "data_events": [],
    "view_surfaces": [],
    "reference_entities": []
  },
  "widgets": [
    {
      "widget_id": "settings-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/settings-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": false,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": null,
    "frontend": "frontend/dist",
    "skills_root": null,
    "hooks": {}
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/settings/preferences.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": false
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": false,
    "upgrade": true,
    "uninstall": false,
    "migrate": false,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": false
  },
  "health_contract": {
    "mode": "none",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
