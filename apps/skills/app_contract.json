{
  "app_id": "skills",
  "contract_version": "1.0",
  "name": "Skills",
  "version": "0.1.0",
  "description": "Workspace app for creating, editing, validating, and deleting workspace-owned runtime skills.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "skill.catalog",
      "version": "1",
      "description": "Workspace-owned skill catalog and skill references.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "maverick_skills_app",
      "skills_view_filter",
      "skills_set_view_filter",
      "skills_set_custom_view",
      "skills_clear_custom_view",
      "skills_reference_manifest",
      "skills_reference_search",
      "skills_reference_resolve",
      "skills_reference_summarize"
    ],
    "cli_commands": [
      "skills",
      "sync"
    ],
    "skills": [
      "generate-image",
      "maverick-app-creator",
      "maverick-code-skill",
      "skills-ops"
    ],
    "views": [
      "skills"
    ],
    "data_events": [
      {
        "resource": "skills",
        "description": "Emitted when workspace skills change through official Skills app surfaces."
      },
      {
        "resource": "view-state",
        "description": "Emitted when Skills catalog filters or curated selections change through official Skills app surfaces."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "skills",
        "display_name": "Skills",
        "entity_types": [
          "skill"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read the current Skills catalog view state."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set Skills catalog query and enabled-state filters."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of skill references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return Skills to normal catalog browsing mode."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "skill",
        "display_name": "Skill",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "skills-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/skills-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "skills-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/skills-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "skills_root": "skills",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json+markdown",
    "data_schema_version": "1",
    "primary_paths": [
      "data/skills/state.json",
      "data/skills/skills"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
