{
  "app_id": "speech",
  "contract_version": "1.0",
  "name": "Speech",
  "version": "0.1.0",
  "description": "Backend-only speech provider app for workspace text-to-speech and speech-to-text transcription surfaces.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "speech.synthesis",
      "version": "1",
      "description": "Backend text-to-speech synthesis for workspace apps.",
      "surfaces": [
        "backend"
      ]
    },
    {
      "interface": "speech.transcription",
      "version": "1",
      "description": "Backend speech-to-text transcription for workspace apps.",
      "surfaces": [
        "backend",
        "cli",
        "mcp"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "sealed",
    "source_access": "none"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "none"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "speech_operations_manifest",
      "speech_reference_manifest",
      "speech_transcribe_file"
    ],
    "cli_commands": [
      "speech"
    ],
    "skills": [],
    "views": [],
    "data_events": [],
    "view_surfaces": [],
    "reference_entities": []
  },
  "widgets": [],
  "entrypoints": {
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "backend": "backend/app_backend.py",
    "frontend": null,
    "skills_root": null,
    "hooks": {
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "json",
    "data_schema_version": "1",
    "primary_paths": [
      "data/speech/jobs.json",
      "data/speech/settings.json"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": false,
    "supports_migrations": false
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": false,
    "upgrade": true,
    "uninstall": false,
    "migrate": false,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": true
  }
}
