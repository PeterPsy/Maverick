{
  "commands": {
    "speech": {
      "description": "Inspect Speech engine health/settings, report or explicitly prewarm persistent STT worker status, and transcribe bounded workspace Storage audio files. Live microphone streaming, inline audio payloads, and worker stop/reload are not exposed through CLI.",
      "secret_selectors": [
        {
          "when": {"action": "list_engines"},
          "required_secrets": ["deepgram-api-key", "openrouter-api-key"]
        },
        {
          "when": {"action": "engine_health"},
          "required_secrets": ["deepgram-api-key", "openrouter-api-key"]
        },
        {
          "when": {"action": "transcribe_file"},
          "required_secrets": ["deepgram-api-key"]
        }
      ],
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "operations.manifest",
              "list_engines",
              "engine_health",
              "get_settings",
              "worker_status",
              "prewarm_worker",
              "transcribe_file"
            ],
            "default": "operations.manifest",
            "description": "Speech app operation to run."
          },
          "workspace_relative_path": {
            "type": "string",
            "description": "Workspace-relative audio file path under storage/uploaded/ or storage/generated/."
          },
          "content_type": {
            "type": "string",
            "description": "Optional audio content type override."
          },
          "language": {
            "type": "string",
            "description": "Optional short language code."
          },
          "include_voices": {
            "type": "boolean",
            "default": false,
            "description": "Include full voice metadata for list_engines and engine_health. Defaults to false for compact CLI output."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  }
}
