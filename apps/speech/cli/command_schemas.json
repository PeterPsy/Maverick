{
  "commands": {
    "speech": {
      "effect_class": "mutating",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "operations.manifest": "read",
          "list_engines": "read",
          "engine_health": "read",
          "get_settings": "read",
          "worker_status": "read",
          "prewarm_synthesis_worker": "mutating",
          "prewarm_worker": "mutating",
          "set_engine": "mutating",
          "transcribe_file": "read",
          "prepare_subtitles": "read"
        }
      },
      "description": "Configure workspace Speech engine/language preferences, inspect health/settings, prewarm persistent workers, and transcribe bounded workspace Storage audio files. Live microphone streaming, inline audio payloads, and worker stop/reload are not exposed through CLI.",
      "secret_selectors": [
        {
          "when": {
            "action": "list_engines"
          },
          "required_secrets": [
            "deepgram-api-key",
            "openrouter-api-key"
          ]
        },
        {
          "when": {
            "action": "engine_health"
          },
          "required_secrets": [
            "deepgram-api-key",
            "openrouter-api-key"
          ]
        },
        {
          "when": {
            "action": "transcribe_file"
          },
          "required_secrets": [
            "deepgram-api-key"
          ]
        }
      ],
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "operations.manifest",
              "list_engines",
              "engine_health",
              "get_settings",
              "worker_status",
              "prewarm_synthesis_worker",
              "prewarm_worker",
              "set_engine",
              "transcribe_file",
              "prepare_subtitles"
            ],
            "default": "operations.manifest",
            "description": "Speech app operation to run."
          },
          "workspace_relative_path": {
            "type": "string",
            "description": "Workspace-relative audio file path under storage/uploaded/ or storage/generated/."
          },
          "content_type": {
            "type": "string",
            "description": "Optional audio content type override."
          },
          "language": {
            "type": "string",
            "description": "Optional short language code."
          },
          "include_voices": {
            "type": "boolean",
            "default": false,
            "description": "Include full voice metadata for list_engines and engine_health. Defaults to false for compact CLI output."
          },
          "synthesis_engine": {
            "type": "string",
            "enum": [
              "auto",
              "piper",
              "espeak",
              "espeak-ng",
              "kokoro-openrouter",
              "kokoro-deepinfra"
            ],
            "description": "Workspace synthesis engine selection used by set_engine."
          },
          "synthesis_language": {
            "type": "string",
            "description": "Workspace synthesis language preference: auto or a BCP-47 tag such as it-IT or en-US."
          },
          "transcription_engine": {
            "type": "string",
            "enum": [
              "auto",
              "faster-whisper",
              "whisper.cpp",
              "deepgram"
            ],
            "description": "Workspace transcription engine selection used by set_engine."
          },
          "transcription_profile": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "accurate"
            ],
            "description": "Workspace transcription profile used by set_engine."
          },
          "local_only": {
            "type": "boolean",
            "default": false,
            "description": "Force local-only one-shot file transcription without changing the workspace engine."
          },
          "word_timestamps": {
            "type": "boolean",
            "default": false,
            "description": "Return measured word intervals for file transcription."
          },
          "subtitle_max_words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Prepare captions and SRT in the transcription call; implies word_timestamps."
          },
          "words": {
            "type": "array",
            "maxItems": 100000,
            "description": "Measured words with start/end seconds and text."
          },
          "max_words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "max_duration_seconds": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 30
          },
          "pause_threshold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "time_offset_seconds": {
            "type": "number",
            "minimum": -86400,
            "maximum": 86400
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  }
}
