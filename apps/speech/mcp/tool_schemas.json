{
  "tools": {
    "speech_operations_manifest": {
      "effect_class": "read",
      "description": "Return the compact Speech operations manifest.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {
            "type": "integer"
          },
          "app_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "operations": {
            "type": "object"
          }
        }
      }
    },
    "speech_reference_manifest": {
      "effect_class": "read",
      "description": "Report the Speech reference entity manifest. Speech currently exposes no reference entities.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {
            "type": "integer"
          },
          "app_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "entity_types": {
            "type": "array"
          }
        }
      }
    },
    "speech_transcribe_file": {
      "effect_class": "read",
      "description": "Transcribe a bounded workspace Storage audio file. This tool does not accept live microphone streams or absolute host paths.",
      "required_secrets": [
        "deepgram-api-key"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {
            "type": "string",
            "description": "Workspace-relative audio file path under storage/uploaded/ or storage/generated/."
          },
          "content_type": {
            "type": "string",
            "description": "Optional audio content type override."
          },
          "language": {
            "type": "string",
            "description": "Optional short language code."
          },
          "local_only": {
            "type": "boolean",
            "default": false,
            "description": "Force local Whisper transcription for this request; never use a remote STT engine or change workspace settings."
          },
          "word_timestamps": {
            "type": "boolean",
            "default": false,
            "description": "Return measured word intervals for file transcription."
          },
          "subtitle_max_words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Prepare captions and SRT in the transcription call; implies word_timestamps."
          }
        },
        "required": [
          "workspace_relative_path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status_code": {
            "type": "integer"
          },
          "job_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "segments": {
            "type": "array"
          },
          "language": {
            "type": "string"
          },
          "language_probability": {
            "type": "number"
          },
          "duration_seconds": {
            "type": "number"
          },
          "engine": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "beam_size": {
            "type": "integer"
          },
          "worker": {
            "type": "object"
          },
          "retention": {
            "type": "string"
          },
          "words": {
            "type": "array"
          },
          "word_timing": {
            "type": "object"
          },
          "subtitles": {
            "type": "object"
          }
        }
      }
    },
    "speech_prepare_subtitles": {
      "effect_class": "read",
      "description": "Prepare captions and SRT from measured words. Save returned content through Storage. Never interpolates sentence durations.",
      "input_schema": {
        "type": "object",
        "properties": {
          "words": {
            "type": "array",
            "maxItems": 100000,
            "description": "Measured words with start/end seconds and text."
          },
          "max_words": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "max_duration_seconds": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 30
          },
          "pause_threshold_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "time_offset_seconds": {
            "type": "number",
            "minimum": -86400,
            "maximum": 86400
          }
        },
        "required": [
          "words"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "captions": {
            "type": "array"
          },
          "srt": {
            "type": "string"
          },
          "caption_count": {
            "type": "integer"
          },
          "word_count": {
            "type": "integer"
          },
          "timing_source": {
            "type": "string"
          }
        }
      }
    }
  }
}
