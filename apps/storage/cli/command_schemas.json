{
  "commands": {
    "storage": {
      "description": "Inspect, search, preview, read, write, move, and delete workspace Storage files. Calling without arguments returns a compact operations manifest.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Storage operation to run. Omit for operations.manifest.",
            "enum": [
              "operations.manifest",
              "catalog",
              "file.catalog.list",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "file_info",
              "read_file",
              "file.content.read",
              "read_text",
              "file.text.read",
              "write",
              "write-file",
              "write-content",
              "write_file",
              "file.content.write",
              "image.inspect",
              "image.compose_pair",
              "image.compose_side_by_side",
              "upload_file",
              "upload_local_file",
              "local_upload_session.start",
              "local_upload_session.status",
              "local_upload_session.chunk",
              "local_upload_session.cancel",
              "preview_text",
              "file.preview.text",
              "preview_table",
              "file.preview.table",
              "render_preview",
              "file.preview.render",
              "render_thumbnail",
              "update_markdown_file",
              "create_folder",
              "read_folder",
              "download_folder",
              "delete_folder",
              "move_file",
              "move_folder",
              "move_items",
              "delete_file",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "drive_connections.list",
              "drive_connections.start_oauth",
              "drive_connections.disconnect",
              "drive_list_roots",
              "drive_list_children",
              "drive_sync",
              "drive_search",
              "drive_read",
              "drive_preview",
              "drive_export",
              "file.localize",
              "file.localize_status",
              "file.localize_retry",
              "file.localize_cancel",
              "file.reconcile",
              "drive_index",
              "drive_mark_indexed",
              "drive_write",
              "drive_upload_session.start",
              "drive_upload_session.status",
              "drive_upload_session.chunk",
              "drive_upload_session.cancel",
              "drive_rename",
              "drive_move",
              "drive_trash",
              "health.check"
            ],
            "default": "operations.manifest"
          },
          "query": {"type": "string"},
          "role": {"type": "string", "enum": ["all", "uploaded", "generated"]},
          "kind": {
            "type": "string",
            "enum": ["all", "audio", "document", "file", "image", "markdown", "pdf", "presentation", "spreadsheet", "text", "video"]
          },
          "folder_path": {"type": "string"},
          "folder_relative_path": {"type": "string"},
          "parent_relative_path": {"type": "string"},
          "folder_name": {"type": "string"},
          "file_name": {"type": "string"},
          "file_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
          "workspace_relative_paths": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "relative_path": {"type": "string"},
          "offset": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000},
          "sort_by": {"type": "string", "enum": ["modified_at", "relative_path", "name", "size_bytes", "preview_kind"]},
          "sort_direction": {"type": "string", "enum": ["asc", "desc"]},
          "sync": {"type": "boolean", "default": false},
          "max_bytes": {"type": "integer", "minimum": 1},
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "description": "Character budget for text windows and previews. preview_text caps this at 12000; drive_index caps this at 20000 for Memory ingest compatibility."
          },
          "max_rows": {"type": "integer", "minimum": 1},
          "max_columns": {"type": "integer", "minimum": 1},
          "content": {"type": "string"},
          "content_base64": {"type": "string"},
          "content_type": {"type": "string"},
          "images": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {"type": "object"}
              ]
            },
            "maxItems": 20
          },
          "left_workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "right_workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "target_folder": {"type": "string"},
          "target_workspace_relative_path": {"type": "string", "pattern": "^storage/generated/.+$"},
          "output_workspace_relative_path": {"type": "string", "pattern": "^storage/generated/.+$"},
          "output_format": {"type": "string", "enum": ["jpg", "jpeg", "png"]},
          "format": {"type": "string", "enum": ["jpg", "jpeg", "png"]},
          "height": {"type": "integer", "minimum": 1, "maximum": 5000},
          "output_height": {"type": "integer", "minimum": 1, "maximum": 5000},
          "background_color": {"type": "string"},
          "source_path": {
            "type": "string",
            "description": "CLI-only local source file path for upload_local_file. Sandbox invocations may read only inside workspace_root; full-access operator invocations may read other local paths. This is not exposed by Storage MCP or frontend surfaces."
          },
          "size_bytes": {"type": "integer", "minimum": 0},
          "local_upload_session_id": {"type": "string"},
          "drive_upload_session_id": {"type": "string"},
          "refresh_remote": {"type": "boolean", "default": false},
          "chunk_offset": {"type": "integer", "minimum": 0},
          "mode": {"type": "string", "enum": ["create", "overwrite", "upsert", "versioned"]},
          "return_handle": {
            "type": "boolean",
            "default": false,
            "description": "When true, return a Storage file handle instead of inline base64 unless include_content=true."
          },
          "include_content": {
            "type": "boolean",
            "description": "Controls whether read_file returns inline content when return_handle is true."
          },
          "new_name": {"type": "string"},
          "target_folder_relative_path": {"type": "string"},
          "files": {"type": "array", "items": {"type": "object"}},
          "folders": {"type": "array", "items": {"type": "object"}},
          "title": {"type": "string"},
          "preserve_custom": {"type": "boolean", "default": false},
          "entity_type": {"type": "string", "enum": ["file", "folder"]},
          "entity_id": {"type": "string"},
          "provider": {"type": "string", "enum": ["google_drive"]},
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "stable_storage_file_id": {"type": "string"},
          "source_version": {"type": "string"},
          "memory_node_id": {"type": "string"},
          "memory_external_ref_id": {"type": "string"},
          "memory_source_version_id": {"type": "string"},
          "display_path": {"type": "string"},
          "parent_drive_file_id": {"type": "string"},
          "page_token": {"type": "string"},
          "target_parent_drive_file_id": {"type": "string"},
          "export_mime_type": {"type": "string"},
          "access_mode": {"type": "string", "enum": ["full_read", "full_rw", "picker_limited"]},
          "redirect_uri": {"type": "string"},
          "state": {"type": "string"},
          "code": {"type": "string"},
          "confirm": {"type": "boolean", "default": false},
          "force": {"type": "boolean", "default": false},
          "download": {"type": "boolean", "default": false},
          "delete_policy": {"type": "string", "enum": ["user_confirmed", "workspace_policy", "explicit_policy"]}
        },
        "additionalProperties": false,
        "oneOf": [
          {"maxProperties": 0},
          {"properties": {"action": {"enum": ["operations.manifest"]}}, "required": ["action"]},
          {
            "properties": {"action": {"enum": ["catalog", "file.catalog.list"]}},
            "required": ["action"]
          },
          {"properties": {"action": {"enum": ["view_filter"]}}, "required": ["action"]},
          {
            "properties": {"action": {"enum": ["set_view_filter"]}},
            "required": ["action"]
          },
          {
            "properties": {"action": {"enum": ["set_custom_view"]}},
            "required": ["action"]
          },
          {"properties": {"action": {"enum": ["clear_custom_view"]}}, "required": ["action"]},
          {
            "properties": {
              "action": {"enum": ["file_info"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["read_file", "file.content.read"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["read_text", "file.text.read"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["write", "write-file", "write-content", "write_file", "file.content.write"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ],
            "oneOf": [
              {"required": ["content"]},
              {"required": ["content_base64"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["image.inspect"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["images"]},
              {"required": ["workspace_relative_paths"]},
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["image.compose_pair", "image.compose_side_by_side"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["images"]},
              {"required": ["workspace_relative_paths"]},
              {"required": ["left_workspace_relative_path", "right_workspace_relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["upload_file"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role", "file_name", "content_base64"]
          },
          {
            "properties": {
              "action": {"enum": ["upload_local_file"]},
              "role": {"enum": ["uploaded", "generated"]},
              "mode": {"enum": ["create", "overwrite", "upsert", "versioned"]}
            },
            "required": ["action", "source_path"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "file_name"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["local_upload_session.start"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role", "file_name", "size_bytes"]
          },
          {
            "properties": {
              "action": {"enum": ["local_upload_session.status", "local_upload_session.cancel"]}
            },
            "required": ["action", "local_upload_session_id"]
          },
          {
            "properties": {
              "action": {"enum": ["local_upload_session.chunk"]}
            },
            "required": ["action", "local_upload_session_id", "chunk_offset", "content_base64"]
          },
          {
            "properties": {
              "action": {"enum": ["preview_text", "file.preview.text"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["preview_table", "file.preview.table"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["render_preview", "file.preview.render", "render_thumbnail"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["update_markdown_file"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "content"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["create_folder"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role", "folder_name"]
          },
          {
            "properties": {
              "action": {"enum": ["read_folder", "download_folder"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role"]
          },
          {
            "properties": {
              "action": {"enum": ["delete_folder"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role", "relative_path"]
          },
          {
            "properties": {
              "action": {"enum": ["move_folder"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role", "relative_path"]
          },
          {
            "properties": {
              "action": {"enum": ["move_file"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["move_items"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action", "role"],
            "anyOf": [
              {"properties": {"files": {"minItems": 1}}, "required": ["files"]},
              {"properties": {"folders": {"minItems": 1}}, "required": ["folders"]}
            ]
          },
          {
            "properties": {
              "action": {"enum": ["delete_file"]},
              "role": {"enum": ["uploaded", "generated"]}
            },
            "required": ["action"],
            "anyOf": [
              {"required": ["workspace_relative_path"]},
              {"required": ["role", "relative_path"]}
            ]
          },
          {"properties": {"action": {"enum": ["references.manifest", "health.check"]}}, "required": ["action"]},
          {
            "properties": {"action": {"enum": ["references.search"]}},
            "required": ["action"]
          },
          {
            "properties": {"action": {"enum": ["references.resolve", "references.summarize"]}},
            "required": ["action", "entity_id"]
          },
          {
            "properties": {"action": {"enum": ["drive_connections.list"]}},
            "required": ["action"]
          },
          {
            "properties": {"action": {"enum": ["drive_connections.start_oauth"]}},
            "required": ["action"]
          },
          {
            "properties": {"action": {"enum": ["drive_connections.disconnect", "drive_list_roots", "drive_sync", "drive_search"]}},
            "required": ["action", "connection_id"]
          },
          {
            "properties": {"action": {"enum": ["drive_list_children"]}},
            "required": ["action", "connection_id"],
            "oneOf": [
              {"required": ["parent_drive_file_id"]},
              {"required": ["drive_file_id"]}
            ]
          },
          {
            "properties": {"action": {"enum": ["drive_read", "drive_preview", "drive_export", "file.localize", "file.localize_status", "file.localize_retry", "file.localize_cancel", "drive_index", "drive_trash"]}},
            "required": ["action"],
            "anyOf": [
              {"required": ["connection_id", "drive_file_id"]},
              {"required": ["stable_storage_file_id"]}
            ]
          },
          {
            "properties": {"action": {"enum": ["file.reconcile"]}},
            "required": ["action"]
          },
          {
            "properties": {"action": {"enum": ["drive_mark_indexed"]}},
            "required": ["action", "stable_storage_file_id"]
          },
          {
            "properties": {"action": {"enum": ["drive_write"]}},
            "required": ["action"],
            "oneOf": [
              {"required": ["connection_id", "drive_file_id"]},
              {"required": ["stable_storage_file_id"]},
              {"required": ["connection_id", "parent_drive_file_id", "file_name"]}
            ],
            "anyOf": [
              {"required": ["content"]},
              {"required": ["content_base64"]}
            ]
          },
          {
            "properties": {"action": {"enum": ["drive_upload_session.start"]}},
            "required": ["action", "connection_id", "parent_drive_file_id", "file_name", "size_bytes"]
          },
          {
            "properties": {"action": {"enum": ["drive_upload_session.status"]}},
            "required": ["action", "drive_upload_session_id"]
          },
          {
            "properties": {"action": {"enum": ["drive_upload_session.chunk"]}},
            "required": ["action", "drive_upload_session_id", "chunk_offset", "content_base64"]
          },
          {
            "properties": {"action": {"enum": ["drive_upload_session.cancel"]}},
            "required": ["action", "drive_upload_session_id"]
          },
          {
            "properties": {"action": {"enum": ["drive_rename"]}},
            "required": ["action", "new_name"],
            "anyOf": [
              {"required": ["connection_id", "drive_file_id"]},
              {"required": ["stable_storage_file_id"]}
            ]
          },
          {
            "properties": {"action": {"enum": ["drive_move"]}},
            "required": ["action", "target_parent_drive_file_id"],
            "anyOf": [
              {"required": ["connection_id", "drive_file_id"]},
              {"required": ["stable_storage_file_id"]}
            ]
          }
        ],
        "examples": [
          {"action": "operations.manifest"},
          {"action": "catalog", "limit": 20},
          {"action": "file.content.read", "workspace_relative_path": "storage/generated/report.md"},
          {"action": "file.text.read", "workspace_relative_path": "storage/generated/report.md"},
          {"action": "file.content.write", "workspace_relative_path": "storage/generated/report.md", "mode": "overwrite", "confirm": true, "content": "# Report"},
          {"action": "drive_search", "connection_id": "drive_conn_example", "query": "mimeType='application/pdf'", "limit": 20},
          {"action": "drive_export", "connection_id": "drive_conn_example", "drive_file_id": "1AbC", "export_mime_type": "application/pdf"},
          {"action": "file.localize", "stable_storage_file_id": "file_drive_example"}
        ]
      },
      "required_secrets": [],
      "secret_selectors": [
        {
          "required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"],
          "when": {"action": "drive_connections.start_oauth"}
        },
        {
          "required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"],
          "when": {
            "action": [
              "drive_sync",
              "drive_list_roots",
              "drive_list_children",
              "drive_search",
              "drive_read",
              "drive_preview",
              "drive_export",
              "file.localize",
              "file.localize_status",
              "file.localize_retry",
              "file.localize_cancel",
              "file.reconcile",
              "drive_index",
              "drive_write",
              "drive_upload_session.start",
              "drive_upload_session.chunk",
              "drive_upload_session.cancel",
              "drive_rename",
              "drive_move",
              "drive_trash"
            ]
          }
        },
        {
          "required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"],
          "when": {"action": "drive_upload_session.status", "refresh_remote": true}
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id",
          "when": {
            "action": [
              "drive_sync",
              "drive_list_roots",
              "drive_list_children",
              "drive_search",
              "drive_read",
              "drive_preview",
              "drive_export",
              "file.localize",
              "file.localize_status",
              "file.localize_retry",
              "file.localize_cancel",
              "file.reconcile",
              "drive_index",
              "drive_write",
              "drive_upload_session.start",
              "drive_upload_session.chunk",
              "drive_upload_session.cancel",
              "drive_rename",
              "drive_move",
              "drive_trash"
            ]
          }
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id",
          "when": {"action": "drive_upload_session.status", "refresh_remote": true}
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_upload_session"},
          "when": {"action": "drive_upload_session.status", "refresh_remote": true}
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_upload_session"},
          "when": {"action": ["drive_upload_session.chunk", "drive_upload_session.cancel"]}
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"},
          "when": {
            "action": [
              "drive_read",
              "drive_preview",
              "drive_export",
              "file.localize",
              "file.localize_status",
              "file.localize_retry",
              "file.localize_cancel",
              "file.reconcile",
              "drive_index",
              "drive_write",
              "drive_rename",
              "drive_move",
              "drive_trash"
            ]
          }
        }
      ]
    }
  }
}
