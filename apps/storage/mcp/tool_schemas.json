{
  "tools": {
    "maverick_storage": {
      "description": "Generic Storage operation runner. Calling without arguments returns a compact operations manifest; use dedicated Storage tools for common read and write paths.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "operations.manifest",
              "catalog",
              "file.catalog.list",
              "file_info",
              "read_file",
              "file.content.read",
              "read_text",
              "file.text.read",
              "write",
              "write-file",
              "write-content",
              "write_file",
              "file.content.write",
              "upload_file",
              "preview_text",
              "file.preview.text",
              "preview_table",
              "file.preview.table",
              "render_preview",
              "file.preview.render",
              "render_thumbnail",
              "update_markdown_file",
              "create_folder",
              "read_folder",
              "download_folder",
              "delete_folder",
              "move_file",
              "move_folder",
              "move_items",
              "delete_file",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view",
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize",
              "drive_connections.list",
              "drive_connections.start_oauth",
              "drive_connections.disconnect",
              "drive_list_roots",
              "drive_list_children",
              "drive_sync",
              "drive_search",
              "drive_read",
              "drive_preview",
              "drive_export",
              "drive_index",
              "drive_write",
              "drive_rename",
              "drive_move",
              "drive_trash",
              "health.check"
            ],
            "default": "operations.manifest"
          },
          "query": {"type": "string"},
          "role": {"type": "string", "enum": ["all", "uploaded", "generated"]},
          "kind": {
            "type": "string",
            "enum": ["all", "audio", "document", "file", "image", "markdown", "pdf", "presentation", "spreadsheet", "text", "video"]
          },
          "folder_path": {"type": "string"},
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "relative_path": {"type": "string"},
          "offset": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000},
          "max_chars": {"type": "integer", "minimum": 1},
          "content": {"type": "string"},
          "content_base64": {"type": "string"},
          "mode": {"type": "string", "enum": ["create", "overwrite"]},
          "entity_type": {"type": "string", "enum": ["file", "folder"]},
          "entity_id": {"type": "string"},
          "provider": {"type": "string", "enum": ["google_drive"]},
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "stable_storage_file_id": {"type": "string"},
          "parent_drive_file_id": {"type": "string"},
          "target_parent_drive_file_id": {"type": "string"},
          "export_mime_type": {"type": "string"},
          "content_type": {"type": "string"},
          "access_mode": {"type": "string", "enum": ["full_read", "full_rw", "picker_limited"]},
          "redirect_uri": {"type": "string"},
          "state": {"type": "string"},
          "code": {"type": "string"},
          "confirm": {"type": "boolean", "default": false},
          "delete_policy": {"type": "string", "enum": ["user_confirmed", "workspace_policy", "explicit_policy"]}
        },
        "additionalProperties": true,
        "examples": [{"action": "operations.manifest"}, {"action": "catalog", "limit": 20}]
      },
      "output_schema": {"type": "object"}
    },
    "storage_list_files": {
      "description": "List workspace Storage files and folders with compact, paginated metadata.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "role": {"type": "string", "enum": ["all", "uploaded", "generated"], "default": "all"},
          "kind": {
            "type": "string",
            "enum": ["all", "audio", "document", "file", "image", "markdown", "pdf", "presentation", "spreadsheet", "text", "video"],
            "default": "all"
          },
          "folder_path": {"type": "string"},
          "file_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
          "workspace_relative_paths": {"type": "array", "items": {"type": "string"}, "maxItems": 500},
          "offset": {"type": "integer", "minimum": 0, "default": 0},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000},
          "sort_by": {"type": "string", "enum": ["modified_at", "relative_path", "name", "size_bytes", "preview_kind"], "default": "modified_at"},
          "sort_direction": {"type": "string", "enum": ["asc", "desc"], "default": "desc"}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "files": {"type": "array"},
          "folders": {"type": "array"},
          "pagination": {"type": "object"},
          "inventory": {"type": "object"}
        }
      }
    },
    "storage_file_info": {
      "description": "Resolve metadata for one Storage file by workspace_relative_path or role plus relative_path.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "role": {"type": "string", "enum": ["uploaded", "generated"]},
          "relative_path": {"type": "string"}
        },
        "anyOf": [
          {"required": ["workspace_relative_path"]},
          {"required": ["role", "relative_path"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"file": {"type": "object"}}}
    },
    "storage_read_file": {
      "description": "Read one Storage file as bounded base64 content. Use only after selecting an explicit file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "role": {"type": "string", "enum": ["uploaded", "generated"]},
          "relative_path": {"type": "string"},
          "max_bytes": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["workspace_relative_path"]},
          {"required": ["role", "relative_path"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"file": {"type": "object"}, "content_base64": {"type": "string"}}}
    },
    "storage_read_text": {
      "description": "Extract complete text for a supported Storage text, Markdown, DOCX, PPTX, or XLSX file. Use offset and max_chars to page very large documents.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "role": {"type": "string", "enum": ["uploaded", "generated"]},
          "relative_path": {"type": "string"},
          "offset": {"type": "integer", "minimum": 0},
          "max_chars": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["workspace_relative_path"]},
          {"required": ["role", "relative_path"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "text_char_count": {"type": "integer"},
          "offset": {"type": "integer"},
          "max_chars": {"type": ["integer", "null"]},
          "range_end": {"type": "integer"},
          "has_more": {"type": "boolean"},
          "next_offset": {"type": ["integer", "null"]},
          "complete": {"type": "boolean"},
          "file": {"type": "object"}
        }
      }
    },
    "storage_preview_text": {
      "description": "Extract a bounded text preview for a text, Markdown, DOCX, PPTX, or XLSX Storage file.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "role": {"type": "string", "enum": ["uploaded", "generated"]},
          "relative_path": {"type": "string"},
          "max_chars": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["workspace_relative_path"]},
          {"required": ["role", "relative_path"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"preview_text": {"type": "string"}, "file": {"type": "object"}}}
    },
    "storage_preview_table": {
      "description": "Extract bounded tabular rows for CSV and spreadsheet Storage files.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "role": {"type": "string", "enum": ["uploaded", "generated"]},
          "relative_path": {"type": "string"},
          "max_rows": {"type": "integer", "minimum": 1},
          "max_columns": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["workspace_relative_path"]},
          {"required": ["role", "relative_path"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"sheets": {"type": "array"}, "file": {"type": "object"}}}
    },
    "storage_write_file": {
      "description": "Create or overwrite one workspace Storage file through the official Storage write path.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_relative_path": {"type": "string", "pattern": "^storage/(uploaded|generated)/.+$"},
          "role": {"type": "string", "enum": ["uploaded", "generated"], "default": "generated"},
          "relative_path": {"type": "string"},
          "mode": {"type": "string", "enum": ["create", "overwrite"]},
          "content": {"type": "string"},
          "content_base64": {"type": "string"}
        },
        "anyOf": [
          {"required": ["workspace_relative_path"]},
          {"required": ["role", "relative_path"]}
        ],
        "oneOf": [
          {"required": ["content"]},
          {"required": ["content_base64"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"file": {"type": "object"}}}
    },
    "storage_drive_connections_list": {
      "description": "List Google Drive connections known to Storage without delivering Google tokens.",
      "input_schema": {"type": "object", "properties": {}, "additionalProperties": false},
      "output_schema": {"type": "object", "properties": {"connections": {"type": "array"}}}
    },
    "storage_drive_connections_start_oauth": {
      "description": "Start a Storage-owned Google Drive OAuth flow for a requested access mode; defaults to full_rw when omitted.",
      "input_schema": {
        "type": "object",
        "properties": {
          "access_mode": {"type": "string", "enum": ["full_read", "full_rw", "picker_limited"]},
          "redirect_uri": {"type": "string"}
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "provider": {"type": "string", "enum": ["google_drive"]},
          "access_mode": {"type": "string"},
          "status": {"type": "string", "enum": ["authorization_required"]},
          "authorization_url": {"type": "string"},
          "state": {"type": "string"},
          "expires_in_seconds": {"type": "integer"},
          "scopes": {"type": "array", "items": {"type": "string"}},
          "callback_path": {"type": "string"},
          "connection": {"type": "object"}
        },
        "additionalProperties": true
      },
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]}
      ]
    },
    "storage_drive_connections_disconnect": {
      "description": "Locally disconnect one Storage Google Drive connection without receiving or deleting raw Google tokens.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "confirm": {"type": "boolean", "default": false}
        },
        "required": ["connection_id"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "secret_selectors": []
    },
    "storage_drive_sync": {
      "description": "Synchronize Google Drive metadata and change-feed state for one Storage Drive connection.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000},
          "page_token": {"type": "string"}
        },
        "required": ["connection_id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "provider": {"type": "string", "enum": ["google_drive"]},
          "connection_id": {"type": "string"},
          "synced_files": {"type": "integer"},
          "removed_file_count": {"type": "integer"},
          "stale_storage_file_ids": {"type": "array", "items": {"type": "string"}},
          "memory_staleness": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["owning_app_id", "entity_type", "entity_id", "reason"],
              "properties": {
                "owning_app_id": {"type": "string", "const": "storage"},
                "entity_type": {"type": "string", "const": "file"},
                "entity_id": {"type": "string"},
                "reason": {"type": "string"},
                "connection_id": {"type": "string"},
                "drive_file_id": {"type": "string"},
                "source_version": {"type": "string"},
                "indexed_source_version": {"type": "string"},
                "staleness": {"type": "object"},
                "sync_state": {"type": "object"}
              },
              "additionalProperties": true
            }
          },
          "sync_state": {"type": "object"}
        },
        "additionalProperties": true
      },
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_list_roots": {
      "description": "List Google Drive roots for one Storage-owned Drive connection.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000}
        },
        "required": ["connection_id"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"folders": {"type": "array"}}},
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_list_children": {
      "description": "List children under one Drive parent id and return normalized Storage file and folder records.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "parent_drive_file_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000},
          "page_token": {"type": "string"}
        },
        "required": ["connection_id"],
        "oneOf": [
          {"required": ["parent_drive_file_id"]},
          {"required": ["drive_file_id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"files": {"type": "array"}, "folders": {"type": "array"}}},
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_search": {
      "description": "Search Google Drive through Storage and return stable Storage file ids plus Drive locators.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "query": {"type": "string"},
          "parent_drive_file_id": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000}
        },
        "required": ["connection_id"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object", "properties": {"files": {"type": "array"}}},
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_read": {
      "description": "Read bounded bytes from one Google Drive file through Storage without exposing Google tokens.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "stable_storage_file_id": {"type": "string"},
          "max_bytes": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["connection_id", "drive_file_id"]},
          {"required": ["stable_storage_file_id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_preview": {
      "description": "Extract bounded preview text for a Google Drive file through Storage for agent and Memory indexing workflows.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "stable_storage_file_id": {"type": "string"},
          "max_bytes": {"type": "integer", "minimum": 1},
          "max_chars": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["connection_id", "drive_file_id"]},
          {"required": ["stable_storage_file_id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_export": {
      "description": "Export a Google Drive or Google-native document through Storage in a bounded format.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "stable_storage_file_id": {"type": "string"},
          "export_mime_type": {"type": "string"},
          "max_bytes": {"type": "integer", "minimum": 1}
        },
        "anyOf": [
          {"required": ["connection_id", "drive_file_id"]},
          {"required": ["stable_storage_file_id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_index": {
      "description": "Request Storage-to-Memory indexing for one Google Drive file using a stable Storage reference and source version.",
      "input_schema": {
        "type": "object",
        "properties": {
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "stable_storage_file_id": {"type": "string"},
          "max_bytes": {"type": "integer", "minimum": 1},
          "max_chars": {"type": "integer", "minimum": 1, "maximum": 20000}
        },
        "anyOf": [
          {"required": ["connection_id", "drive_file_id"]},
          {"required": ["stable_storage_file_id"]}
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["status", "provider", "connection_id", "drive_file_id", "source_version", "preview_text", "memory_source"],
        "properties": {
          "status": {"type": "string", "enum": ["ready_for_memory"]},
          "provider": {"type": "string", "enum": ["google_drive"]},
          "connection_id": {"type": "string"},
          "drive_file_id": {"type": "string"},
          "file": {"type": "object"},
          "source_version": {"type": "string", "minLength": 1},
          "preview_text": {"type": "string", "maxLength": 20000},
          "preview_truncated": {"type": "boolean"},
          "truncated": {"type": "boolean"},
          "bytes_read": {"type": "integer"},
          "cache_hit": {"type": "boolean"},
          "memory_source": {
            "type": "object",
            "required": ["source_kind", "owning_app_id", "entity_type", "entity_id", "file_id", "provider", "workspace_relative_path", "metadata"],
            "properties": {
              "source_kind": {"type": "string", "enum": ["remote_storage_file"]},
              "owning_app_id": {"type": "string", "enum": ["storage"]},
              "entity_type": {"type": "string", "enum": ["file"]},
              "entity_id": {"type": "string"},
              "file_id": {"type": "string"},
              "provider": {"type": "string", "enum": ["google_drive"]},
              "title": {"type": "string"},
              "workspace_relative_path": {"type": "string", "enum": [""]},
              "metadata": {
                "type": "object",
                "required": ["provider", "connection_id", "drive_file_id", "stable_storage_file_id", "source_version", "display_path"],
                "properties": {
                  "provider": {"type": "string", "enum": ["google_drive"]},
                  "connection_id": {"type": "string"},
                  "drive_file_id": {"type": "string"},
                  "stable_storage_file_id": {"type": "string"},
                  "source_version": {"type": "string", "minLength": 1},
                  "display_path": {"type": "string"},
                  "web_url": {"type": "string"}
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "secret_selectors": [
        {"required_secrets": ["google-drive-oauth-client-id", "google-drive-oauth-client-secret"]},
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_id_argument": "connection_id"
        },
        {
          "required_secrets": ["google-drive-refresh-token"],
          "resource_type": "drive_connection",
          "resource_lookup": {"kind": "storage_drive_file"}
        }
      ]
    },
    "storage_drive_mark_indexed": {
      "description": "Acknowledge successful Memory ingest for one Drive Storage file so future Drive sync can propagate staleness only for files that actually reached Memory.",
      "input_schema": {
        "type": "object",
        "properties": {
          "stable_storage_file_id": {"type": "string"},
          "source_version": {"type": "string"},
          "memory_node_id": {"type": "string"},
          "memory_external_ref_id": {"type": "string"},
          "memory_source_version_id": {"type": "string"}
        },
        "required": ["stable_storage_file_id"],
        "additionalProperties": false
      },
      "output_schema": {
