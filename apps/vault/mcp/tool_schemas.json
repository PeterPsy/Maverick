{
  "tools": {
    "maverick_vault": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "manifest": "read",
          "diagnose": "read",
          "connection_issues": "read",
          "plan_fix": "read",
          "explain_issue": "read",
          "apply_fix": "destructive"
        }
      },
      "description": "Run Vault's redaction-safe agent operations for Core Secrets diagnosis, planning, explanation, and guarded grant fixes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["manifest", "diagnose", "connection_issues", "plan_fix", "explain_issue", "apply_fix"],
            "default": "manifest"
          },
          "workspace_id": {
            "type": "string"
          },
          "app_id": {
            "type": "string"
          },
          "issue_id": {
            "type": "string"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "confirmation": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": ["confirm_apply_fix"]
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    }
  }
}
