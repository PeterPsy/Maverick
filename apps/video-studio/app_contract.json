{
  "app_id": "video-studio",
  "contract_version": "1.0",
  "name": "Video Studio",
  "version": "0.1.0",
  "description": "Server-first, revisioned video editing foundation for Maverick workspaces.",
  "publisher": "maverick",
  "minimum_core_version": "0.1.0",
  "provides": [],
  "requires": [
    {
      "alias": "storage-catalog",
      "interface": "file.catalog",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Browse workspace media through the selected Storage-compatible provider."
    },
    {
      "alias": "storage-preview",
      "interface": "file.preview",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Resolve governed previews for workspace media."
    },
    {
      "alias": "storage-read",
      "interface": "file.content.read",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Read selected workspace media through official provider surfaces."
    },
    {
      "alias": "storage-text-read",
      "interface": "file.text.read",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Read bounded extracted text for supported workspace files."
    },
    {
      "alias": "storage-write",
      "interface": "file.content.write",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Publish validated outputs through official provider surfaces."
    },
    {
      "alias": "storage-media-stream",
      "interface": "file.media.stream",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Stream governed media to the mounted editor."
    },
    {
      "alias": "storage-local-path",
      "interface": "file.local.path",
      "version": "^1",
      "required": true,
      "cardinality": "one",
      "description": "Resolve a bounded local media path only for trusted backend-to-backend processing."
    }
  ],
  "distribution": {
    "mode": "source_available",
    "source_access": "forkable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "video_studio_foundation",
      "video_studio_reference_manifest",
      "video_studio_project_create",
      "video_studio_project_list",
      "video_studio_project_get",
      "video_studio_project_rename",
      "video_studio_project_duplicate",
      "video_studio_project_archive",
      "video_studio_project_restore",
      "video_studio_revision_get",
      "video_studio_revision_compare",
      "video_studio_native_export",
      "video_studio_native_import",
      "video_studio_operations_apply",
      "video_studio_undo",
      "video_studio_redo"
    ],
    "cli_commands": [
      "video-studio"
    ],
    "skills": [
      "video-studio-ops"
    ],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "projects",
        "description": "Emitted when a project is created, duplicated, imported, archived, or restored."
      },
      {
        "resource": "project-metadata",
        "description": "Emitted when revisioned project metadata changes."
      },
      {
        "resource": "revisions",
        "description": "Emitted when an immutable revision is created or the persistent main head changes."
      }
    ],
    "view_surfaces": [],
    "reference_entities": []
  },
  "entrypoints": {
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    },
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "skills_root": "skills"
  },
  "storage": {
    "storage_kind": "sqlite",
    "data_schema_version": "3",
    "primary_paths": [
      "data/video-studio/app.db"
    ],
    "indices": {
      "kind": "embedded"
    },
    "supports_export": false,
    "supports_import": false,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox"
    ]
  },
  "hook_timeouts": {
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": false,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  },
  "widgets": [],
  "services": {
    "http_sidecars": [
      {
        "id": "foundation",
        "runtime": "python",
        "working_directory": "backend",
        "command": [
          "python3",
          "sidecar_server.py"
        ],
        "env": {
          "VIDEO_STUDIO_DATA_ROOT": "${app.data_dir}",
          "VIDEO_STUDIO_SIDECAR_HOST": "127.0.0.1",
          "VIDEO_STUDIO_SIDECAR_PORT": "${service.port}",
          "VIDEO_STUDIO_SIDECAR_TOKEN": "${service.token}",
          "PYTHONUNBUFFERED": "1"
        },
        "process_policy": {
          "inherit_host_env": false,
          "sandbox": "required",
          "bundle_read_only": true,
          "workspace_data_write": true,
          "network": "isolated",
          "transport": "unix_relay",
          "outbound": [],
          "limits": {
            "memory_bytes": 536870912,
            "open_files": 256,
            "request_concurrency": 8
          }
        },
        "bind": {
          "host": "127.0.0.1",
          "port": "auto"
        },
        "health": {
          "path": "/health",
          "timeout_ms": 30000
        },
        "proxy": {
          "mount": "/foundation",
          "streaming": false,
          "sse": false,
          "websocket": false,
          "route_policy": {
            "pass_through": [
              {
                "method": "GET",
                "path_template": "/health"
              },
              {
                "method": "GET",
                "path_template": "/status"
              },
              {
                "method": "GET",
                "path_template": "/schema"
              }
            ],
            "handled_by_core": [],
            "blocked": []
          }
        },
        "logs": {
          "stdout": "logs/apps/video-studio/foundation.log",
          "stderr": "logs/apps/video-studio/foundation.log"
        }
      }
    ]
  }
}
