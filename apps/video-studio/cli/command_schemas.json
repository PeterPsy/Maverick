{
  "commands": {
    "video-studio": {
      "description": "Inspect Video Studio and operate persistent Project IR revisions through typed actions.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "status", "schema", "health", "capabilities",
              "project.create", "project.list", "project.get", "project.rename",
              "project.duplicate", "project.archive", "project.restore",
              "revision.get", "revision.compare", "native.export", "native.import",
              "operations.apply", "history.undo", "history.redo"
            ],
            "default": "status"
          },
          "project_id": {"type": "string"},
          "new_project_id": {"type": "string"},
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "description": {"type": "string", "maxLength": 4000},
          "include_archived": {"type": "boolean", "default": false},
          "project_ir": {"type": "object"},
          "base_revision_id": {"type": "string"},
          "operation_batch_id": {"type": "string"},
          "revision_id": {"type": "string"},
          "before_revision_id": {"type": "string"},
          "after_revision_id": {"type": "string"},
          "native_project": {"type": "object"},
          "batch": {"type": "object"}
        },
        "additionalProperties": false,
        "oneOf": [
          {"properties": {"action": {"enum": ["status", "schema", "health", "capabilities", "project.list"]}}},
          {"properties": {"action": {"const": "project.create"}}, "required": ["action", "name"]},
          {"properties": {"action": {"enum": ["project.get", "project.archive", "project.restore"]}}, "required": ["action", "project_id"]},
          {"properties": {"action": {"const": "project.rename"}}, "required": ["action", "project_id", "name", "base_revision_id", "operation_batch_id"]},
          {"properties": {"action": {"const": "project.duplicate"}}, "required": ["action", "project_id", "name"]},
          {"properties": {"action": {"const": "revision.get"}}, "required": ["action", "project_id", "revision_id"]},
          {"properties": {"action": {"const": "revision.compare"}}, "required": ["action", "project_id", "before_revision_id", "after_revision_id"]},
          {"properties": {"action": {"const": "native.export"}}, "required": ["action", "project_id"]},
          {"properties": {"action": {"const": "native.import"}}, "required": ["action", "native_project"]},
          {"properties": {"action": {"enum": ["operations.apply", "history.undo", "history.redo"]}}, "required": ["action", "batch"]}
        ]
      }
    }
  }
}
