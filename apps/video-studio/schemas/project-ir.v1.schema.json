{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maverick:video-studio:project-ir:v1",
  "title": "Maverick Video Studio Project IR v1",
  "description": "Renderer-independent, declarative, non-executable video project representation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "metadata", "canvas", "frame_rate", "audio", "duration_frames", "assets", "timeline"],
  "properties": {
    "ir_version": {"const": "video-project-ir.v1"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "canvas": {"$ref": "#/$defs/canvas"},
    "frame_rate": {"$ref": "#/$defs/positiveRational"},
    "audio": {"$ref": "#/$defs/audioConfiguration"},
    "duration_frames": {"type": "integer", "minimum": 0},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "timeline": {"$ref": "#/$defs/timeline"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "version": {"type": "string", "minLength": 1, "maxLength": 64}}
    },
    "positiveRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "workspace_id", "name", "tags", "provenance"],
      "properties": {
        "project_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "tags": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "provenance": {"type": "array", "maxItems": 128, "items": {"type": "object"}}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "pixel_aspect", "background", "color_space"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 32768},
        "height": {"type": "integer", "minimum": 1, "maximum": 32768},
        "pixel_aspect": {"$ref": "#/$defs/positiveRational"},
        "background": {
          "type": "object", "additionalProperties": false, "required": ["kind", "value"],
          "properties": {"kind": {"const": "color"}, "value": {"type": "string", "pattern": "^#[0-9A-Fa-f]{8}$"}}
        },
        "color_space": {"enum": ["srgb", "rec709", "display-p3"]}
      }
    },
    "audioConfiguration": {
      "type": "object", "additionalProperties": false, "required": ["sample_rate", "channel_layout"],
      "properties": {
        "sample_rate": {"enum": [32000, 44100, 48000, 88200, 96000, 192000]},
        "channel_layout": {"enum": ["mono", "stereo", "5.1", "7.1"]}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "kind", "identity", "provenance", "source"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["video", "audio", "image", "font", "template"]},
        "identity": {
          "type": "object", "additionalProperties": false, "required": ["storage_file_id", "source_version", "sha256"],
          "properties": {
            "storage_file_id": {"$ref": "#/$defs/identifier"},
            "source_version": {"type": "string", "minLength": 1, "maxLength": 256},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["provider_interface", "workspace_id", "acquisition"],
          "properties": {
            "provider_interface": {"enum": ["file.content.read", "file.media.stream"]},
            "workspace_id": {"$ref": "#/$defs/identifier"},
            "acquisition": {"enum": ["uploaded", "generated", "localized", "imported"]}
          }
        },
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["duration_pts", "time_base", "duration_us", "frame_rate_mode", "pts_map"],
          "properties": {
            "duration_pts": {"type": "integer", "minimum": 0},
            "time_base": {"$ref": "#/$defs/positiveRational"},
            "duration_us": {"type": "integer", "minimum": 0},
            "frame_rate_mode": {"enum": ["cfr", "vfr", "still", "audio"]},
            "pts_map": {"type": "array", "items": {"type": "integer", "minimum": 0}}
          }
        }
      }
    },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["tracks", "transitions", "captions", "markers", "template_instances", "groups", "relationships"],
      "properties": {
        "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "captions": {"type": "array", "items": {"$ref": "#/$defs/caption"}},
        "markers": {"type": "array", "items": {"$ref": "#/$defs/marker"}},
        "template_instances": {"type": "array", "items": {"$ref": "#/$defs/templateInstance"}},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}
      }
    },
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["track_id", "type", "name", "enabled", "locked", "muted", "clips"],
      "properties": {
        "track_id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["video", "audio", "text", "captions", "graphics"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "enabled": {"type": "boolean"}, "locked": {"type": "boolean"}, "muted": {"type": "boolean"},
        "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}}
      }
    },
    "clip": {
      "type": "object", "additionalProperties": false,
      "required": ["clip_id", "kind", "start_frame", "duration_frames", "keyframes", "effects", "layers", "group_ids"],
      "properties": {
        "clip_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["video", "audio", "image", "text", "caption", "shape", "template", "compound"]},
        "asset_id": {"$ref": "#/$defs/identifier"},
        "start_frame": {"type": "integer", "minimum": 0},
        "duration_frames": {"type": "integer", "minimum": 1},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["in_pts", "out_pts"],
          "properties": {"in_pts": {"type": "integer", "minimum": 0}, "out_pts": {"type": "integer", "minimum": 1}}
        },
        "transform": {"$ref": "#/$defs/transform"},
        "crop": {"$ref": "#/$defs/crop"},
        "fit": {"enum": ["contain", "cover", "fill", "none"]},
        "opacity_permille": {"type": "integer", "minimum": 0, "maximum": 1000},
        "compositing": {"enum": ["source-over", "multiply", "screen", "overlay", "add"]},
        "audio": {"$ref": "#/$defs/audioClip"},
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframe"}},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}},
        "text": {"$ref": "#/$defs/text"},
        "template_instance_id": {"$ref": "#/$defs/identifier"},
        "caption_id": {"$ref": "#/$defs/identifier"},
        "group_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "transform": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x_millipixels": {"type": "integer"}, "y_millipixels": {"type": "integer"},
        "scale_x_permille": {"type": "integer"}, "scale_y_permille": {"type": "integer"},
        "rotation_millidegrees": {"type": "integer"},
        "anchor_x_permille": {"type": "integer"}, "anchor_y_permille": {"type": "integer"}
      }
    },
    "crop": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "left_pixels": {"type": "integer", "minimum": 0}, "top_pixels": {"type": "integer", "minimum": 0},
        "right_pixels": {"type": "integer", "minimum": 0}, "bottom_pixels": {"type": "integer", "minimum": 0}
      }
    },
    "audioClip": {
      "type": "object", "additionalProperties": false,
      "required": ["gain_millibels", "pan_milli", "mute", "channel_mapping", "fade_in_frames", "fade_out_frames", "envelope"],
      "properties": {
        "gain_millibels": {"type": "integer", "minimum": -9600, "maximum": 2400},
        "pan_milli": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "mute": {"type": "boolean"},
        "channel_mapping": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 63}},
        "fade_in_frames": {"type": "integer", "minimum": 0}, "fade_out_frames": {"type": "integer", "minimum": 0},
        "envelope": {"type": "array", "items": {"$ref": "#/$defs/envelopePoint"}}
      }
    },
    "envelopePoint": {
      "type": "object", "additionalProperties": false, "required": ["frame", "gain_millibels", "easing"],
      "properties": {
        "frame": {"type": "integer", "minimum": 0}, "gain_millibels": {"type": "integer", "minimum": -9600, "maximum": 2400},
        "easing": {"enum": ["linear", "ease-in", "ease-out", "ease-in-out", "step-start", "step-end"]}
      }
    },
    "keyframe": {
      "type": "object", "additionalProperties": false,
      "required": ["keyframe_id", "property", "frame", "value", "easing"],
      "properties": {
        "keyframe_id": {"$ref": "#/$defs/identifier"}, "property": {"$ref": "#/$defs/identifier"},
        "frame": {"type": "integer", "minimum": 0},
        "value": {"type": ["integer", "string", "boolean", "object", "array", "null"]},
        "easing": {"enum": ["linear", "ease-in", "ease-out", "ease-in-out", "step-start", "step-end"]}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["effect_id", "registry", "enabled", "parameters"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/identifier"}, "registry": {"$ref": "#/$defs/registryReference"},
        "enabled": {"type": "boolean"}, "parameters": {"type": "object"}
      }
    },
    "layer": {
      "type": "object", "additionalProperties": false, "required": ["layer_id", "kind", "effects"],
      "properties": {
        "layer_id": {"$ref": "#/$defs/identifier"}, "kind": {"enum": ["video", "audio", "image", "text", "shape"]},
        "asset_id": {"$ref": "#/$defs/identifier"}, "transform": {"$ref": "#/$defs/transform"}, "crop": {"$ref": "#/$defs/crop"},
        "fit": {"enum": ["contain", "cover", "fill", "none"]}, "opacity_permille": {"type": "integer", "minimum": 0, "maximum": 1000},
        "compositing": {"enum": ["source-over", "multiply", "screen", "overlay", "add"]},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "text": {"$ref": "#/$defs/text"}
      }
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["plain_text", "font", "size_millipixels", "color", "align", "runs"],
      "properties": {
        "plain_text": {"type": "string", "maxLength": 100000}, "font": {"$ref": "#/$defs/registryReference"},
        "size_millipixels": {"type": "integer", "minimum": 1}, "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{8}$"},
        "align": {"enum": ["start", "center", "end", "justify"]},
        "runs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "registry", "from_clip_id", "to_clip_id", "duration_frames", "parameters"],
      "properties": {
        "transition_id": {"$ref": "#/$defs/identifier"}, "registry": {"$ref": "#/$defs/registryReference"},
        "from_clip_id": {"$ref": "#/$defs/identifier"}, "to_clip_id": {"$ref": "#/$defs/identifier"},
        "duration_frames": {"type": "integer", "minimum": 1}, "parameters": {"type": "object"}
      }
    },
    "caption": {
      "type": "object", "additionalProperties": false,
      "required": ["caption_id", "track_id", "start_frame", "duration_frames", "text", "speaker", "style"],
      "properties": {
        "caption_id": {"$ref": "#/$defs/identifier"}, "track_id": {"$ref": "#/$defs/identifier"},
        "start_frame": {"type": "integer", "minimum": 0}, "duration_frames": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}, "speaker": {"type": "string", "maxLength": 256},
        "style": {"type": "object", "required": ["font"], "properties": {"font": {"$ref": "#/$defs/registryReference"}}}
      }
    },
    "marker": {
      "type": "object", "additionalProperties": false, "required": ["marker_id", "frame", "kind", "label", "note"],
      "properties": {
        "marker_id": {"$ref": "#/$defs/identifier"}, "frame": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["marker", "chapter", "range-start", "range-end"]},
        "label": {"type": "string", "maxLength": 256}, "note": {"type": "string", "maxLength": 4096}
      }
    },
    "templateInstance": {
      "type": "object", "additionalProperties": false,
      "required": ["template_instance_id", "registry", "start_frame", "duration_frames", "parameters"],
      "properties": {
        "template_instance_id": {"$ref": "#/$defs/identifier"}, "registry": {"$ref": "#/$defs/registryReference"},
        "start_frame": {"type": "integer", "minimum": 0}, "duration_frames": {"type": "integer", "minimum": 1},
        "parameters": {"type": "object"}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false, "required": ["group_id", "name", "member_ids"],
      "properties": {
        "group_id": {"$ref": "#/$defs/identifier"}, "name": {"type": "string", "minLength": 1},
        "member_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["relationship_id", "type", "source_id", "target_id"],
      "properties": {
        "relationship_id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["linked-audio-video", "parent-child", "template-binding"]},
        "source_id": {"$ref": "#/$defs/identifier"}, "target_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
