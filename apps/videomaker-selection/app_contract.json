{
  "app_id": "videomaker-selection",
  "contract_version": "1.0",
  "name": "Videomaker Selection",
  "version": "1.1.0",
  "description": "Workspace recruiting app for Social Video Editor candidates, evaluations, contacts, calls, pilots, and decisions.",
  "publisher": "workspace",
  "minimum_core_version": "0.1.0",
  "provides": [
    {
      "interface": "recruiting.candidate",
      "version": "1",
      "description": "Persistent candidate catalog and selection pipeline.",
      "surfaces": [
        "backend",
        "cli",
        "mcp",
        "reference",
        "view",
        "widget"
      ]
    }
  ],
  "requires": [],
  "distribution": {
    "mode": "workspace_local",
    "source_access": "editable"
  },
  "visibility": {
    "platform_roles": null
  },
  "presentation": {
    "frontend_role": "workspace"
  },
  "permissions": {
    "secrets": {
      "read": [],
      "write": []
    },
    "network": {
      "outbound": []
    },
    "runtime": {
      "create_sessions": false,
      "cleanup_sessions": false
    },
    "host": {
      "telemetry": false
    }
  },
  "capabilities": {
    "mcp_tools": [
      "videomaker_selection_candidates",
      "videomaker_selection_candidate_list",
      "videomaker_selection_candidate_read",
      "videomaker_selection_candidate_update",
      "videomaker_selection_candidate_stats",
      "videomaker_selection_reference_manifest",
      "videomaker_selection_reference_search",
      "videomaker_selection_reference_resolve",
      "videomaker_selection_reference_summarize",
      "videomaker_selection_view_filter",
      "videomaker_selection_set_view_filter",
      "videomaker_selection_set_custom_view",
      "videomaker_selection_clear_custom_view"
    ],
    "cli_commands": [
      "videomaker-selection",
      "videomaker-reference",
      "videomaker-view"
    ],
    "skills": [],
    "views": [
      "main"
    ],
    "data_events": [
      {
        "resource": "candidates",
        "description": "Candidate records or activities changed."
      },
      {
        "resource": "view-state",
        "description": "Candidate catalog filters or curated selection changed."
      }
    ],
    "view_surfaces": [
      {
        "view_id": "main",
        "display_name": "Videomaker Selection",
        "entity_types": [
          "candidate"
        ],
        "state_actions": [
          {
            "action": "view_filter",
            "standard": true,
            "description": "Read current candidate catalog filters."
          },
          {
            "action": "set_view_filter",
            "standard": true,
            "description": "Set candidate catalog query and decision filters."
          },
          {
            "action": "set_custom_view",
            "standard": true,
            "description": "Show a curated set of candidate references."
          },
          {
            "action": "clear_custom_view",
            "standard": true,
            "description": "Return to normal candidate browsing."
          }
        ],
        "supports_custom_view": true,
        "supports_filter_refinement": true
      }
    ],
    "reference_entities": [
      {
        "entity_type": "candidate",
        "display_name": "Videomaker Candidate",
        "searchable": true,
        "resolvable": true,
        "summarizable": true,
        "deep_link_supported": true
      }
    ]
  },
  "widgets": [
    {
      "widget_id": "videomaker-sidebar",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.primary"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/videomaker-sidebar",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    },
    {
      "widget_id": "videomaker-sidebar-footer",
      "host": "base-shell",
      "content_kinds": [
        "shell.sidebar.footer"
      ],
      "frontend": {
        "kind": "iframe",
        "mount": "frontend/dist/widgets/videomaker-sidebar-footer",
        "spa_fallback": true
      },
      "actions": {
        "backend": true,
        "mcp": false,
        "cli": false
      }
    }
  ],
  "entrypoints": {
    "backend": "backend/app_backend.py",
    "frontend": "frontend/dist",
    "mcp": "mcp/server.py",
    "cli": "cli/app_cli.py",
    "hooks": {
      "install": "hooks/install.py",
      "migrate": "hooks/migrate.py",
      "health_check": "hooks/health_check.py"
    }
  },
  "storage": {
    "storage_kind": "sqlite",
    "data_schema_version": "2",
    "primary_paths": [
      "data/videomaker-selection/app.db"
    ],
    "indices": null,
    "supports_export": true,
    "supports_import": true,
    "supports_migrations": true
  },
  "compatibility": {
    "workspace_modes": [
      "sandbox",
      "full-access"
    ]
  },
  "hook_timeouts": {
    "backend_seconds": 30,
    "install_seconds": 60,
    "upgrade_seconds": 120,
    "migrate_seconds": 300,
    "export_seconds": 120,
    "import_seconds": 120,
    "validate_after_import_seconds": 60,
    "repair_after_import_seconds": 180,
    "health_check_seconds": 30
  },
  "lifecycle": {
    "install": true,
    "upgrade": true,
    "uninstall": false,
    "migrate": true,
    "export": false,
    "import": false,
    "validate_after_import": false,
    "repair_after_import": false,
    "health_check": true
  },
  "health_contract": {
    "mode": "hook",
    "degraded_on_failure": true
  },
  "failure_semantics": {
    "install_failure": "block_activation",
    "migrate_failure": "preserve_data_mark_unhealthy",
    "import_failure": "preserve_payload_mark_failed"
  },
  "rollback_support": {
    "bundle": false,
    "data": false,
    "repair_only": false
  }
}
