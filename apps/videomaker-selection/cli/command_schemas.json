{
  "commands": {
    "videomaker-selection": {
      "effect_class": "destructive",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "operations.manifest": "read",
          "status": "read",
          "stats": "read",
          "list": "read",
          "read": "read",
          "export": "read",
          "create": "mutating",
          "update": "mutating",
          "bulk_update": "mutating",
          "activity.add": "mutating",
          "import": "mutating",
          "delete": "destructive",
          "activity.list": "read"
        }
      },
      "description": "Catalog, filter and manage the persistent videomaker candidate pipeline. Omit action for the operations manifest.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "operations.manifest",
              "status",
              "stats",
              "list",
              "read",
              "create",
              "update",
              "bulk_update",
              "delete",
              "activity.list",
              "activity.add",
              "import",
              "export"
            ],
            "default": "operations.manifest"
          },
          "id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payload": {
            "type": "object"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "query": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "all",
              "da_valutare",
              "scartato",
              "riserva",
              "selezionato"
            ]
          },
          "email_status": {
            "type": "string"
          },
          "call_status": {
            "type": "string"
          },
          "poc_status": {
            "type": "string"
          },
          "profile_code": {
            "type": "string"
          },
          "capacity": {
            "type": "string"
          },
          "reviewed": {},
          "favorite": {
            "type": "boolean"
          },
          "archived": {},
          "work": {
            "type": "string",
            "enum": [
              "all",
              "vat",
              "no_vat",
              "employee"
            ]
          },
          "sort": {
            "type": "string",
            "enum": [
              "review",
              "form",
              "name",
              "newest",
              "status",
              "updated"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "confirm": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "occurred_at": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "action": "list",
            "sort": "review"
          },
          {
            "action": "update",
            "id": "candidate_<id>",
            "payload": {
              "decision": "selezionato"
            }
          },
          {
            "action": "stats"
          }
        ]
      }
    },
    "videomaker-reference": {
      "effect_class": "read",
      "description": "Search, resolve and summarize videomaker candidate references.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "references.manifest",
              "references.search",
              "references.resolve",
              "references.summarize"
            ],
            "default": "references.manifest"
          },
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "candidate"
            ],
            "default": "candidate"
          },
          "entity_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "videomaker-view": {
      "effect_class": "mutating",
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "view_filter": "read",
          "set_view_filter": "mutating",
          "set_custom_view": "mutating",
          "clear_custom_view": "mutating"
        }
      },
      "description": "Read or change the persisted candidate catalog view state.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view"
            ],
            "default": "view_filter"
          },
          "query": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "all",
              "da_valutare",
              "scartato",
              "riserva",
              "selezionato"
            ]
          },
          "title": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "email_status": {
            "type": "string",
            "enum": [
              "all",
              "da_contattare",
              "email_inviata",
              "risposta_ricevuta",
              "nessuna_risposta"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
