{
  "tools": {
    "videomaker_selection_candidates": {
      "effect_class": "destructive",
      "description": "Generic candidate catalog operation runner; omit action for the operations manifest.",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payload": {
            "type": "object"
          },
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "confirm": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object"
      },
      "effect_class_by_argument": {
        "argument_name": "action",
        "omitted_effect_class": "read",
        "value_effect_classes": {
          "operations.manifest": "read",
          "status": "read",
          "stats": "read",
          "list": "read",
          "read": "read",
          "activity.list": "read",
          "export": "read",
          "create": "mutating",
          "update": "mutating",
          "bulk_update": "mutating",
          "activity.add": "mutating",
          "import": "mutating",
          "delete": "destructive",
          "references.manifest": "read",
          "references.search": "read",
          "references.resolve": "read",
          "references.summarize": "read",
          "view_filter": "read",
          "set_view_filter": "mutating",
          "set_custom_view": "mutating",
          "clear_custom_view": "mutating"
        }
      }
    },
    "videomaker_selection_candidate_list": {
      "effect_class": "read",
      "description": "List and rank candidates with pipeline filters.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "email_status": {
            "type": "string"
          },
          "call_status": {
            "type": "string"
          },
          "poc_status": {
            "type": "string"
          },
          "profile_code": {
            "type": "string"
          },
          "capacity": {
            "type": "string"
          },
          "reviewed": {},
          "favorite": {
            "type": "boolean"
          },
          "archived": {},
          "work": {
            "type": "string"
          },
          "sort": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "apply_view_state": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_candidate_read": {
      "effect_class": "read",
      "description": "Read one candidate including the activity timeline.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "candidate_id"
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_candidate_update": {
      "effect_class": "mutating",
      "description": "Update the profile or pipeline state of one candidate.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "required": [
          "payload"
        ],
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "candidate_id"
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_candidate_stats": {
      "effect_class": "read",
      "description": "Return candidate and pipeline totals.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_reference_manifest": {
      "effect_class": "read",
      "description": "Describe the candidate reference surface.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_reference_search": {
      "effect_class": "read",
      "description": "Search candidate references.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_reference_resolve": {
      "effect_class": "read",
      "description": "Resolve one candidate reference.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "enum": [
              "candidate"
            ]
          },
          "entity_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "entity_id"
            ]
          },
          {
            "required": [
              "id"
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_reference_summarize": {
      "effect_class": "read",
      "description": "Summarize one candidate reference.",
      "input_schema": {
        "type": "object",
        "properties": {
          "entity_type": {
            "type": "string",
            "enum": [
              "candidate"
            ]
          },
          "entity_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "entity_id"
            ]
          },
          {
            "required": [
              "id"
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_view_filter": {
      "effect_class": "read",
      "description": "Read the persisted candidate view state.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_set_view_filter": {
      "effect_class": "mutating",
      "description": "Set the query and decision filter.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_set_custom_view": {
      "effect_class": "mutating",
      "description": "Set a curated candidate reference selection.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "refs"
        ]
      },
      "output_schema": {
        "type": "object"
      }
    },
    "videomaker_selection_clear_custom_view": {
      "effect_class": "mutating",
      "description": "Return to standard candidate browsing.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      }
    }
  }
}
