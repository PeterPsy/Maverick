{
  "commands": {
    "website-studio": {
      "description": "Run a Website Studio action against the workspace data root. Defaults to listing sites. File writes require expected_hash; new files use expected_hash=new. build_preview returns preview HTML, an isolated preview_url when available, runtime status, and missing runtime requirements.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "manifest",
              "sites_list",
              "bootstrap",
              "site_create",
              "site_status",
              "site_archive",
              "site_restore",
              "site_rename",
              "site_duplicate",
              "site_set_active",
              "git_connections_list",
              "git_connection_prepare",
              "git_connection_activate",
              "environments_list",
              "environment_configure",
              "publish_targets_list",
              "publish_target_configure",
              "import_git",
              "import_zip",
              "sync_source",
              "sitemap",
              "navigation_analyze",
              "search",
              "read_file",
              "write_file",
              "apply_patch",
              "diff",
              "list_changes",
              "build_validate",
              "builds_list",
              "maintenance_prune",
              "build_preview",
              "preview_document",
              "preview_report",
              "runtime_status",
              "publish_request",
              "approval_record",
              "approvals_list",
              "publish",
              "rollback",
              "active_context",
              "page_context",
              "reference_manifest",
              "reference_search",
              "reference_resolve",
              "reference_summarize",
              "view_filter",
              "set_view_filter",
              "set_custom_view",
              "clear_custom_view"
            ]
          },
          "site_id": {"type": "string"},
          "display_name": {"type": "string"},
          "slug": {"type": "string"},
          "primary_domain": {"type": "string"},
          "status": {"type": "string"},
          "source_provider": {"type": "string", "enum": ["manual", "zip", "git"]},
          "repository_url": {"type": "string"},
          "base_branch": {"type": "string"},
          "branch": {"type": "string"},
          "auth_mode": {"type": "string", "enum": ["fine_grained_token"]},
          "secret_logical_name": {"type": "string"},
          "connection_id": {"type": "string"},
          "grant_id": {"type": "string"},
          "confirm_no_raw_secret": {"type": "boolean"},
          "environment_id": {"type": "string"},
          "kind": {"type": "string"},
          "mode": {"type": "string", "enum": ["full", "routes-only", "routes"]},
          "name": {"type": "string"},
          "base_url": {"type": "string"},
          "requires_approval": {"type": "boolean"},
          "config": {"type": "object"},
          "archive_base64": {"type": "string"},
          "source_artifact_ref": {"type": "object"},
          "confirm": {"type": "boolean"},
          "query": {"type": "string"},
          "path": {"type": "string"},
          "content": {"type": "string"},
          "old_text": {"type": "string"},
          "new_text": {"type": "string"},
          "expected_hash": {"type": "string"},
          "route": {"type": "string"},
          "preview_id": {"type": "string"},
          "baseline_report_id": {"type": "string"},
          "include_inventory": {"type": "boolean"},
          "page_id": {"type": "string"},
          "component_id": {"type": "string"},
          "section_id": {"type": "string"},
          "anchor_id": {"type": "string"},
          "target_selector": {"type": "string"},
          "target_anchor": {"type": "string"},
          "selector": {"type": "string"},
          "anchor": {"type": "string"},
          "publish_request_id": {"type": "string"},
          "approval_id": {"type": "string"},
          "approval_action": {"type": "string"},
          "target_id": {"type": "string"},
          "approved_by": {"type": "string"},
          "approval_note": {"type": "string"},
          "revision_id": {"type": "string"},
          "entity_type": {"type": "string"},
          "id": {"type": "string"},
          "entity_id": {"type": "string"},
          "title": {"type": "string"},
          "refs": {"type": "array", "items": {"type": "object"}},
          "preserve_custom": {"type": "boolean"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "offset": {"type": "integer", "minimum": 0},
          "include_logs": {"type": "boolean"},
          "diff_limit": {"type": "integer", "minimum": 1, "maximum": 250},
          "keep_builds": {"type": "integer", "minimum": 1, "maximum": 500},
          "keep_previews_per_route": {"type": "integer", "minimum": 1, "maximum": 50},
          "keep_runtime_sessions": {"type": "integer", "minimum": 1, "maximum": 500},
          "dry_run": {"type": "boolean"}
        },
        "additionalProperties": false
      },
      "secret_selectors": [
        {
          "required_secrets": ["github-token"],
          "resource_lookup": { "kind": "website_git_connection_from_arguments" },
          "when": { "action": "import_git" }
        },
        {
          "required_secrets": ["github-token"],
          "resource_lookup": { "kind": "website_git_connection_from_arguments" },
          "when": { "action": "sync_source" }
        },
        {
          "required_secrets": ["github-token"],
          "resource_lookup": { "kind": "website_git_publish_from_arguments" },
          "when": { "action": "publish" }
        }
      ]
    }
  }
}
