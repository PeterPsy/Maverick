{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maverick:schema:app-job:v1",
  "title": "Maverick durable app job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "job_type",
    "handler_name",
    "handler_version",
    "workspace_id",
    "submitted_by_app_id",
    "submitted_by_actor_id",
    "priority",
    "resources",
    "budget",
    "idempotency_key"
  ],
  "properties": {
    "protocol_version": {"const": "app-job.v1"},
    "job_type": {"$ref": "#/$defs/identifier"},
    "handler_name": {"$ref": "#/$defs/identifier"},
    "handler_version": {"$ref": "#/$defs/identifier"},
    "workspace_id": {"$ref": "#/$defs/identifier"},
    "submitted_by_app_id": {"$ref": "#/$defs/identifier"},
    "submitted_by_actor_id": {"$ref": "#/$defs/identifier"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "resources": {"$ref": "#/$defs/resources"},
    "budget": {"$ref": "#/$defs/budget"},
    "idempotency_key": {"$ref": "#/$defs/identifier"},
    "input_grants": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/inputGrant"}
    },
    "output_grant": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/outputGrant"}]
    },
    "retry": {"$ref": "#/$defs/retry"},
    "timeout_seconds": {"type": ["integer", "null"], "minimum": 1},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "network_policy": {"$ref": "#/$defs/networkPolicy"},
    "allowed_tools": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "parameters": {"type": "object"},
    "runtime_versions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {"type": "number", "exclusiveMinimum": 0, "maximum": 4096},
        "ram_bytes": {"type": "integer", "minimum": 1},
        "gpu_count": {"type": "integer", "minimum": 0},
        "accelerator_kinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "disk_bytes": {"type": "integer", "minimum": 0},
        "runtime": {"$ref": "#/$defs/identifier"},
        "runtime_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runtime_seconds", "max_output_bytes"],
      "properties": {
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "max_output_bytes": {"type": "integer", "minimum": 0},
        "max_cost_microunits": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "inputGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "provider_interface", "resource_ref", "sha256", "size_bytes", "mime_type", "expires_at"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/identifier"},
        "provider_interface": {"$ref": "#/$defs/identifier"},
        "resource_ref": {"$ref": "#/$defs/identifier"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "mime_type": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "/"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "outputGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "provider_interface", "expires_at", "max_bytes", "accepted_mime_types"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/identifier"},
        "provider_interface": {"$ref": "#/$defs/identifier"},
        "expires_at": {"type": "string", "format": "date-time"},
        "max_bytes": {"type": "integer", "minimum": 0},
        "accepted_mime_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "/"}
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100},
        "initial_backoff_seconds": {"type": "integer", "minimum": 0},
        "multiplier": {"type": "number", "minimum": 1},
        "max_backoff_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["deny_all", "allowlist"]},
        "allowed_hosts": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253}
        }
      }
    }
  }
}
