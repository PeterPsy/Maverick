# Maverick Antigravity outer sandbox. This profile keeps capabilities only
# inside the outer user namespace so Antigravity can create its nested terminal
# sandbox. Bubblewrap mount/PID boundaries remain the host isolation boundary.
abi <abi/4.0>,
include <tunables/global>

profile maverick-antigravity-bwrap /usr/local/libexec/maverick/antigravity-bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow file /** ix,
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
}
