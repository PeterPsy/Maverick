[Unit]
Description=Maverick wildcard TLS issuance and renewal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{INSTALL_ROOT}}
ExecStart=/usr/bin/env -- {{INSTALL_ROOT}}/.venv/bin/python {{INSTALL_ROOT}}/scripts/deploy/maintain_browser_origin_wildcard.py --hostname {{HOSTNAME}} --email {{ACME_EMAIL}} --nginx-config {{NGINX_CONFIG}}
ExecStart=/usr/bin/env -- /usr/bin/certbot renew --quiet --non-interactive --no-random-sleep-on-renew --no-directory-hooks --cert-name {{HOSTNAME}} --deploy-hook "{{INSTALL_ROOT}}/.venv/bin/python {{INSTALL_ROOT}}/scripts/deploy/reload_nginx.py"
ExecStartPost=/bin/sh -c 'if test -f "{{RESTART_MARKER}}"; then /usr/bin/systemctl restart maverick-core.service && /bin/rm -- "{{RESTART_MARKER}}"; fi'
TimeoutStartSec=15min
UMask=0077
