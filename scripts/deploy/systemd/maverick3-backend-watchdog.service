[Unit]
Description=Maverick v3 backend downtime watchdog
After=network.target maverick3-rescue.service
Wants=maverick3-rescue.service

[Service]
Type=oneshot
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{INSTALL_ROOT}}
Environment=PYTHONUNBUFFERED=1
Environment=MAVERICK3_CORE_HEALTH_URL=http://{{BIND_HOST}}:{{CORE_PORT}}/health
ExecStart={{INSTALL_ROOT}}/.venv/bin/python scripts/rescue_backend_watchdog.py
TimeoutStartSec=infinity
