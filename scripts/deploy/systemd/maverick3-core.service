[Unit]
Description=Maverick v3 core host
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/maverick-v3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m uvicorn core.api.asgi_application:app --host 127.0.0.1 --port 8014
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
