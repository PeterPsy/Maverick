[Unit]
Description=Maverick v3 rescue host
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/maverick-v3
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m core.api.server --service rescue --host 127.0.0.1 --port 8015
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
